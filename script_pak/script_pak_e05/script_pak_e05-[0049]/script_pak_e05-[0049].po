#. はい
msgctxt "0001 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0002 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0003 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi khu vực này chứ?\n"
"<CLT>"

#. <CLT 4>教室中に血痕が飛び散っている…
#. まさに、目を覆いたくなる惨状ってヤツだな…
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There's blood all over the place. I want to shut my\n"
"eyes forever against such a ghastly sight...\n"
"<CLT>"
msgstr "<CLT 4>Máu vương vãi khắp nơi... Quả thật là một thảm cảnh mà tớ chẳng muốn nhìn vào... <CLT>"

#. <CLT 4>床に直接書かれた白線…
#. 人型になぞられた不気味な白線だ。
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There are white chalk outlines drawn all over the\n"
"floor. How many bodies were there...?\n"
"<CLT>"
msgstr "<CLT 4>Những vạch phấn trắng vẽ trực tiếp trên sàn... những đường viền rùng rợn hình người. Đã có bao nhiêu thi thể ở đây vậy...? <CLT>"

#. <CLT 4>こういうのって見た事あるよな…
#. テレビの刑事ドラマとかの…
#. <CLT>
msgctxt "0006 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I've seen this kind of thing on detective shows and\n"
"stuff like that.\n"
"<CLT>"
msgstr "<CLT 4>Tớ đã từng thấy kiểu này rồi... trong mấy bộ phim trinh thám trên TV... <CLT>"

#. <CLT 4>…死体発見現場とかで。
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>You always see it at the scene of a murder...\n"
"<CLT>"
msgstr "<CLT 4>...tại hiện trường vụ án mạng ấy. <CLT>"

#. ………………
msgctxt "0008 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. <CLT 4>いや…まさかな……
#. <CLT>
msgctxt "0009 | MAKOTO NAEGI"
msgid ""
"<CLT 4>No...it can't be...\n"
"<CLT>"
msgstr "<CLT 4>Không... không thể nào... <CLT>"

#. はい
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0011 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0012 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi khu vực này chứ?\n"
"<CLT>"
