"<CLT>"
msgstr "<CLT 4>...thế mà, ở đó lại có thứ gì đó giống như tấm sắt được đóng chặt vào.<CLT>"

#. はい
msgctxt "0007 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0008 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0009 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr "<CLT 23>Rời khỏi khu vực này?<CLT>"

