#. はい
msgctxt "0001 | CHOICE/RE:ACT"
msgid "Yes"
msgstr ""

#. いいえ
msgctxt "0002 | CHOICE/RE:ACT"
msgid "No"
msgstr ""

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0003 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""

#. <CLT 4>ここはトラッシュルームだ。
#. 今は、鉄格子がジャマで中に入れない。
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The trash room gate is down, so I can't get inside.\n"
"<CLT>"
msgstr ""

#. <CLT 4>でも、事件には関係なさそうだな…
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I don't think it's involved in the case, anyway...\n"
"<CLT>"
msgstr ""

#. <CLT 4>ここはトラッシュルーム…つまりゴミ捨て場だな。
#. <CLT>
msgctxt "0006 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is the trash room. The dump, in other words.\n"
"<CLT>"
msgstr ""

#. <CLT 4>そう言えば、掃除当番の話はどうなったんだ？
#. 誰もその話をしないけど…
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Nobody's really said anything about cleaning duty\n"
"since...everything happened.\n"
"<CLT>"
msgstr ""

#. はい
msgctxt "0008 | CHOICE/RE:ACT"
msgid "Yes"
msgstr ""

#. いいえ
msgctxt "0009 | CHOICE/RE:ACT"
msgid "No"
msgstr ""

