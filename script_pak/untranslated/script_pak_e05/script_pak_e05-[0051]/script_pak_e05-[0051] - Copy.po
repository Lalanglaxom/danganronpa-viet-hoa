#. はい
msgctxt "0001 | CHOICE/RE:ACT"
msgid "Yes"
msgstr ""

#. いいえ
msgctxt "0002 | CHOICE/RE:ACT"
msgid "No"
msgstr ""

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0003 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""

#. 舞園さん…
msgctxt "0004 | MAKOTO NAEGI"
msgid "Sayaka."
msgstr ""

#. 舞園さん……
msgctxt "0005 | MAKOTO NAEGI"
msgid "Sakaya..."
msgstr ""

#. <CLT 4>この学園生活は…いつまで続くんだ…
#. <CLT>
msgctxt "0006 | MAKOTO NAEGI"
msgid ""
"<CLT 4>How long are we going to be stuck here, living out\n"
"this school life...?\n"
"<CLT>"
msgstr ""

#. <CLT 4>今更、こんな鉄板を眺めて、
#. 時間を無駄にしているヒマはない…！
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I don't have time to stand around and stare at these\n"
"metal plates...!\n"
"<CLT>"
msgstr ""

#. <CLT 4>今更、こんな鉄板を眺めて、
#. 時間を無駄にしているヒマはない…！
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I don't have time to stand around and stare at these\n"
"metal plates...!\n"
"<CLT>"
msgstr ""

#. <CLT 4>こんなメモ帳なんか見ても仕方がないな。
#. もっと目的ある行動をしないと…
#. <CLT>
msgctxt "0009 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Why am I staring at this notepad? I need to do\n"
"something with more meaning...\n"
"<CLT>"
msgstr ""

#. <CLT 4>いつまでも、ジャマだな…！
#. <CLT>
msgctxt "0010 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This thing's always just in the way...!\n"
"<CLT>"
msgstr ""

#. <CLT 4>この工具セット…
#. 結局、使う事はなさそうだな…
#. <CLT>
msgctxt "0011 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I don't think I'm ever gonna use this stupid toolkit.\n"
"<CLT>"
msgstr ""

#. <CLT 4>今は、ベッドで横になるのは止めておこう。
#. <CLT>
msgctxt "0012 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I don't have time to lay down right now...!\n"
"<CLT>"
msgstr ""

#. <CLT 4>ゴミ箱をじっと眺めて…
#. そんな事してる場合じゃないな。
#. <CLT>
msgctxt "0013 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Instead of staring into the trash can, I should find\n"
"something useful to do.\n"
"<CLT>"
msgstr ""

#. はい
msgctxt "0014 | CHOICE/RE:ACT"
msgid "Yes"
msgstr ""

#. いいえ
msgctxt "0015 | CHOICE/RE:ACT"
msgid "No"
msgstr ""

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0016 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
