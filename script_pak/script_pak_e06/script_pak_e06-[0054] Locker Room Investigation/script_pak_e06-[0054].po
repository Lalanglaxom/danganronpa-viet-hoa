#. <CLT 4>ロッカーだ…
#. <CLT>
msgctxt "0001 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This locker...\n"
"<CLT>"
msgstr "<CLT 4>Cái tủ khóa này... <CLT>"

#. <CLT 4>アルターエゴだよな…
#. あの時、ボクを助けてくれたのは…
#. <CLT>
msgctxt "0002 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is where we first found Alter Ego. Which ended up\n"
"saving my life...\n"
"<CLT>"
msgstr "<CLT 4>Đây là nơi chúng ta tìm thấy Alter Ego. Thứ đã cứu mạng tôi lúc đó... <CLT>"

#. <CLT 4>…死んだ仲間の為にも、
#. 絶対に、この学園の謎を解いてやる！
#. <CLT>
msgctxt "0003 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I swear, I WILL solve the mystery of this school, for\n"
"the sake of all my friends that died!\n"
"<CLT>"
msgstr "<CLT 4>Tôi thề, tôi NHẤT ĐỊNH sẽ giải đáp bí ẩn của ngôi trường này, vì những người bạn đã khuất của tôi! <CLT>"

#. <CLT 4>マッサージチェアがある…
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The massage chair...\n"
"<CLT>"
msgstr "<CLT 4>Chiếc ghế mát-xa... <CLT>"

#. <CLT 4>なんか罠があったら大変だ。
#. 使うのはやめておこう。
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I'm gonna stay away, in case it's been booby-trapped\n"
"somehow...\n"
"<CLT>"
msgstr "<CLT 4>Tốt nhất là không nên dùng, phòng trường hợp nó bị gài bẫy... <CLT>"

#. はい
msgctxt "0006 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0007 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0008 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr "<CLT 23>Bạn muốn rời khỏi khu vực này? <CLT>"
