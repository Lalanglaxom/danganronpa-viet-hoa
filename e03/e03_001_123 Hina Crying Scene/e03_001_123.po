#. ………………
msgctxt "0001 | NO NAME"
msgid "..."
msgstr "..."

#. グス…
msgctxt "0002 | NO NAME"
msgid "Nng... *Sniff*"
msgstr "Ưm... *Hức*"

#. グス…グス……
msgctxt "0003 | NO NAME"
msgid "*Sniff sniff*"
msgstr "*Sụt sịt*"

#. 泣いちゃ駄目って……わかってるのに……
msgctxt "0004 | AOI ASAHINA"
msgid "I know I shouldn't cry..."
msgstr "Mình biết là mình không được khóc..."

#. で、でも…
msgctxt "0005 | AOI ASAHINA"
msgid "But..."
msgstr "Nhưng mà..."

#. ………………
msgctxt "0006 | AOI ASAHINA"
msgid "..."
msgstr "..."

#. もう…イヤだ…
msgctxt "0007 | AOI ASAHINA"
msgid "I've had enough."
msgstr "Mình chịu đủ lắm rồi."

#. もう…耐えられない…
msgctxt "0008 | AOI ASAHINA"
msgid "I can't take it anymore."
msgstr "Mình không thể chịu đựng thêm được nữa."

#. 早く…ここから…
msgctxt "0009 | AOI ASAHINA"
msgid "Getting out of here...anytime soon..."
msgstr "Thoát khỏi đây... sớm thôi sao..."

#. ………………
msgctxt "0010 | AOI ASAHINA"
msgid "..."
msgstr "..."

#. ……ダ…メ……
msgctxt "0011 | AOI ASAHINA"
msgid "It's...impossible."
msgstr "Điều đó... là không thể nào."

#. 駄目…だって…
#. ここから出たいなんて思っちゃ…
msgctxt "0012 | AOI ASAHINA"
msgid ""
"I can't let myself think about...how much I want to\n"
"get out of here."
msgstr ""
"Mình không được để bản thân nghĩ về việc... mình muốn\n"
"thoát khỏi đây đến nhường nào."

#. そ、そんな風に思ったら…
#. 私まで……
msgctxt "0013 | AOI ASAHINA"
msgid "If I keep thinking like that, I might decide to..."
msgstr "Nếu cứ tiếp tục nghĩ như vậy, có khi mình sẽ quyết định..."

#. ………………
msgctxt "0014 | AOI ASAHINA"
msgid "..."
msgstr "..."

#. …ドーナツ。
msgctxt "0015 | AOI ASAHINA"
msgid "...Donuts."
msgstr "...Bánh donut."

#. ドーナツ食べよ…
#. そしたら…きっと元気になるし…
msgctxt "0016 | AOI ASAHINA"
msgid "I need to eat some donuts...! That'll cheer me up!"
msgstr "Mình phải ăn bánh donut thôi! Nhất định mình sẽ thấy khá hơn!"

#. リングドーナツ、ツイストドーナツ、あんドーナツ、
#. ジェリードーナツ、マラサダ、サーターアンダーギー…
msgctxt "0017 | AOI ASAHINA"
msgid ""
"Glazed donuts, twisty donuts, jelly donuts,\n"
"cream-filled, donut holes, malasadas...!"
msgstr ""
"Donut vòng, donut xoắn, donut nhân mứt, nhân kem, donut\n"
"viên, malasada...!"

#. ドーナツの神様！
#. 私に素敵な出会いがありますように！
msgctxt "0018 | AOI ASAHINA"
msgid ""
"O god of donuts! I'm praying for a wonderful\n"
"encounter!"
msgstr ""
"Ôi vị thần donut! Con cầu xin người cho con một cuộc hội\n"
"ngộ tuyệt vời!"

#. うぅ…ごめんなさい…
msgctxt "0019 | AOI ASAHINA"
msgid "*Sniff* I'm sorry..."
msgstr "*Hức* Tui xin lỗi..."

#. 夜時間のルールを破った私を
#. どうぞお許しください…
msgctxt "0020 | AOI ASAHINA"
msgid "Please, forgive me for breaking the nighttime rule..."
msgstr "Làm ơn hãy tha thứ cho tui vì đã vi phạm giờ ban đêm..."

#. でも、今の私には…
#. どうしてもドーナツが必要なのです…
msgctxt "0021 | AOI ASAHINA"
msgid ""
"But right now, for me...donuts are absolutely\n"
"necessary...!"
msgstr ""
"Nhưng lúc này, đối với tui... bánh donut là thứ cực kỳ cần\n"
"thiết...!"

#. <CLT 23>「ガ……ガガ……」
#. <CLT>
msgctxt "0022 | NARRATION"
msgid ""
"<CLT 23>*Grr grnnn*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Gừ gừừừ*\n"
"<CLT>"

#. え…？
msgctxt "0023 | AOI ASAHINA"
msgid "...Huh?"
msgstr "...Hả?"

#. <CLT 23>「ガガ…ガガガ……」
#. <CLT>
msgctxt "0024 | NARRATION"
msgid ""
"<CLT 23>*Grn grn grrnnn*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Khừ khừ khừừừ*\n"
"<CLT>"

#. 今の…音って…？
msgctxt "0025 | AOI ASAHINA"
msgid "What's that sound?"
msgstr "Âm thanh đó là gì vậy?"

#. <CLT 23>「ガ…ガ…」
#. <CLT>
msgctxt "0026 | NARRATION"
msgid ""
"<CLT 23>*Grn grn*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Khừ khừ*\n"
"<CLT>"

#. お風呂場の方から…
#. 聞えてるみたいだけど…
msgctxt "0027 | AOI ASAHINA"
msgid "It sounds like it's coming from...the bathhouse..."
msgstr "Nghe như nó phát ra từ... nhà tắm vậy..."

#. <CLT 23>「ガガ…ガガガガ…ガガ……」
#. <CLT>
msgctxt "0028 | NARRATION"
msgid ""
"<CLT 23>*Grn grrrrnn grrn*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Khừừ khừ khừ khừ*\n"
"<CLT>"

#. こ、怖いけど……でも…！
msgctxt "0029 | AOI ASAHINA"
msgid "I'm super scared, but..."
msgstr "Mình sợ kinh khủng, nhưng mà...!"

#. あ、あのぉ…
msgctxt "0030 | AOI ASAHINA"
msgid "I-Is...?"
msgstr "C-Có...?"

#. 誰か…いますかぁ……
msgctxt "0031 | AOI ASAHINA"
msgid "Is someone there?"
msgstr "Có ai ở đó không?"

#. ………………
msgctxt "0032 | AOI ASAHINA"
msgid "..."
msgstr "..."

#. …ッ！！
msgctxt "0033 | AOI ASAHINA"
msgid "*Gasp*"
msgstr "*Xùy*"

#. きゃあああああああああああああッ！！
msgctxt "0034 | AOI ASAHINA"
msgid "KYAAAAAAAAAAAAAAAAAAAHHH!"
msgstr "Á Á Á Á Á Á Á Á Á Á Á Á Á Á Á Á Á Á!"
