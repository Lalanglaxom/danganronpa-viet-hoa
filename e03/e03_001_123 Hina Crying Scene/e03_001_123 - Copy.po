#. ………………
msgctxt "0001 | NO NAME"
msgid "..."
msgstr "..."

#. グス…
msgctxt "0002 | NO NAME"
msgid "Nng... *Sniff*"
msgstr ""

#. グス…グス……
msgctxt "0003 | NO NAME"
msgid "*Sniff sniff*"
msgstr ""

#. 泣いちゃ駄目って……わかってるのに……
msgctxt "0004 | AOI ASAHINA"
msgid "I know I shouldn't cry..."
msgstr ""

#. で、でも…
msgctxt "0005 | AOI ASAHINA"
msgid "But..."
msgstr ""

#. ………………
msgctxt "0006 | AOI ASAHINA"
msgid "..."
msgstr "..."

#. もう…イヤだ…
msgctxt "0007 | AOI ASAHINA"
msgid "I've had enough."
msgstr ""

#. もう…耐えられない…
msgctxt "0008 | AOI ASAHINA"
msgid "I can't take it anymore."
msgstr ""

#. 早く…ここから…
msgctxt "0009 | AOI ASAHINA"
msgid "Getting out of here...anytime soon..."
msgstr ""

#. ………………
msgctxt "0010 | AOI ASAHINA"
msgid "..."
msgstr "..."

#. ……ダ…メ……
msgctxt "0011 | AOI ASAHINA"
msgid "It's...impossible."
msgstr ""

#. 駄目…だって…
#. ここから出たいなんて思っちゃ…
msgctxt "0012 | AOI ASAHINA"
msgid ""
"I can't let myself think about...how much I want to\n"
"get out of here."
msgstr ""

#. そ、そんな風に思ったら…
#. 私まで……
msgctxt "0013 | AOI ASAHINA"
msgid "If I keep thinking like that, I might decide to..."
msgstr ""

#. ………………
msgctxt "0014 | AOI ASAHINA"
msgid "..."
msgstr "..."

#. …ドーナツ。
msgctxt "0015 | AOI ASAHINA"
msgid "...Donuts."
msgstr ""

#. ドーナツ食べよ…
#. そしたら…きっと元気になるし…
msgctxt "0016 | AOI ASAHINA"
msgid "I need to eat some donuts...! That'll cheer me up!"
msgstr ""

#. リングドーナツ、ツイストドーナツ、あんドーナツ、
#. ジェリードーナツ、マラサダ、サーターアンダーギー…
msgctxt "0017 | AOI ASAHINA"
msgid ""
"Glazed donuts, twisty donuts, jelly donuts,\n"
"cream-filled, donut holes, malasadas...!"
msgstr ""

#. ドーナツの神様！
#. 私に素敵な出会いがありますように！
msgctxt "0018 | AOI ASAHINA"
msgid ""
"O god of donuts! I'm praying for a wonderful\n"
"encounter!"
msgstr ""

#. うぅ…ごめんなさい…
msgctxt "0019 | AOI ASAHINA"
msgid "*Sniff* I'm sorry..."
msgstr ""

#. 夜時間のルールを破った私を
#. どうぞお許しください…
msgctxt "0020 | AOI ASAHINA"
msgid "Please, forgive me for breaking the nighttime rule..."
msgstr ""

#. でも、今の私には…
#. どうしてもドーナツが必要なのです…
msgctxt "0021 | AOI ASAHINA"
msgid ""
"But right now, for me...donuts are absolutely\n"
"necessary...!"
msgstr ""

#. <CLT 23>「ガ……ガガ……」
#. <CLT>
msgctxt "0022 | NARRATION"
msgid ""
"<CLT 23>*Grr grnnn*\n"
"<CLT>"
msgstr ""

#. え…？
msgctxt "0023 | AOI ASAHINA"
msgid "...Huh?"
msgstr ""

#. <CLT 23>「ガガ…ガガガ……」
#. <CLT>
msgctxt "0024 | NARRATION"
msgid ""
"<CLT 23>*Grn grn grrnnn*\n"
"<CLT>"
msgstr ""

#. 今の…音って…？
msgctxt "0025 | AOI ASAHINA"
msgid "What's that sound?"
msgstr ""

#. <CLT 23>「ガ…ガ…」
#. <CLT>
msgctxt "0026 | NARRATION"
msgid ""
"<CLT 23>*Grn grn*\n"
"<CLT>"
msgstr ""

#. お風呂場の方から…
#. 聞えてるみたいだけど…
msgctxt "0027 | AOI ASAHINA"
msgid "It sounds like it's coming from...the bathhouse..."
msgstr ""

#. <CLT 23>「ガガ…ガガガガ…ガガ……」
#. <CLT>
msgctxt "0028 | NARRATION"
msgid ""
"<CLT 23>*Grn grrrrnn grrn*\n"
"<CLT>"
msgstr ""

#. こ、怖いけど……でも…！
msgctxt "0029 | AOI ASAHINA"
msgid "I'm super scared, but..."
msgstr ""

#. あ、あのぉ…
msgctxt "0030 | AOI ASAHINA"
msgid "I-Is...?"
msgstr ""

#. 誰か…いますかぁ……
msgctxt "0031 | AOI ASAHINA"
msgid "Is someone there?"
msgstr ""

#. ………………
msgctxt "0032 | AOI ASAHINA"
msgid "..."
msgstr "..."

#. …ッ！！
msgctxt "0033 | AOI ASAHINA"
msgid "*Gasp*"
msgstr ""

#. きゃあああああああああああああッ！！
msgctxt "0034 | AOI ASAHINA"
msgid "KYAAAAAAAAAAAAAAAAAAAHHH!"
msgstr ""
