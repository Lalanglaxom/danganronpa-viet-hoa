#. 山田君が示そうとしたのは…
msgctxt "0001 | KYOUKO KIRIGIRI"
msgid "Hifumi was trying to tell us something..."
msgstr ""

#. <CLT 9>苗字がやすひろ<CLT>の
#. 人物だったはず。
msgctxt "0002 | KYOUKO KIRIGIRI"
msgid ""
"He wanted us to know\n"
"the <CLT 9>killer's last name—Yasuhiro<CLT>."
msgstr ""

#. この中にやすひろって
#. 苗字の人がいるとしたら…
msgctxt "0003 | AOI ASAHINA"
msgid ""
"If there's one person here\n"
"who might have that last name..."
msgstr ""

#. 本名を明かしていない
#. セレスだろうな。
msgctxt "0004 | SAKURA OOGAMI"
msgid ""
"It would have to be you,\n"
"Celeste. You haven't told anyone\n"
"what your real name is."
msgstr ""

#. だから何度も
#. 言ってますように…
msgctxt "0005 | CELES"
msgid "How many times do I have to tell you...?"
msgstr ""

#. わたくしの名前はぁ…
msgctxt "0006 | CELES"
msgid "My...name...is..."
msgstr ""

#. セレスティア・ルーデンベルク
#. なんだよぉッ！！
msgctxt "0007 | CELES"
msgid "Celestia Ludenberg, goddammit!"
msgstr ""

#. いつまで言い張ってるつもりだ…
msgctxt "0008 | BYAKUYA TOGAMI"
msgid "How long do you plan to go on pretending...?"
msgstr ""

#. 言い張るも何も…
#. それが真実ですわ…
msgctxt "0009 | CELES"
msgid "I'm not pretending. It's the truth!"
msgstr ""

#. それを<CLT 9>確かめる方法がない<CLT>以上…
msgctxt "0010 | CELES"
msgid "And since you have <CLT 9>no way to contradict me<CLT>..."
msgstr ""

#. それが真実なんだよッ！
#. ボケッ！
msgctxt "0011 | CELES"
msgid ""
"...that's the only truth there is!\n"
"Moron!"
msgstr ""

#. <CLT 26>葉隠じゃないんだね！<CLT>
msgctxt "0012 | CELES"
msgid "<CLT 26>It wasn't Hiro!?<CLT>"
msgstr ""

#. <CLT 26>その人物が…犯人！<CLT>
msgctxt "0013 | CELES"
msgid "<CLT 26>Whoever that is...must have done it!<CLT>"
msgstr ""

#. <CLT 26>偽名の人間は他にいない。<CLT>
msgctxt "0014 | CELES"
msgid "<CLT 26>Who else could be using a fake name?<CLT>"
msgstr ""

#. <CLT 26>真実だと…？<CLT>
msgctxt "0015 | CELES"
msgid "<CLT 26>The truth...?<CLT>"
msgstr ""

#. <CLT 26>セレスちゃん…なの？<CLT>
msgctxt "0016 | CELES"
msgid "<CLT 26>Celeste...was it you?<CLT>"
msgstr ""

#. <CLT 26>怒った白夜様も素敵ね！<CLT>
msgctxt "0017 | CELES"
msgid "<CLT 26>I love it when Master yells at people!<CLT>"
msgstr ""

#. <CLT 26>何か方法は…<CLT>
msgctxt "0018 | CELES"
msgid "<CLT 26>What can we do...?<CLT>"
msgstr ""

#. <CLT 26>決定的な証拠はないんか！？<CLT>
msgctxt "0019 | CELES"
msgid "<CLT 26>Is there no clear evidence!?<CLT>"
msgstr ""

#. <CLT 26>あと一手足りんな…<CLT>
msgctxt "0020 | CELES"
msgid "<CLT 26>We need to end this now...<CLT>"
msgstr ""
