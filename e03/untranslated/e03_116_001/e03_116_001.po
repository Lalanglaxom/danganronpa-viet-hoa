#. そのメモは、ひふみんが
#. 持ってたんでしょ？
msgctxt "0001 | TOUKO FUKAWA"
msgid "Huffy had the note, right?"
msgstr ""

#. じゃあ、そのメモで
#. 呼び出されたのも…
msgctxt "0002 | TOUKO FUKAWA"
msgid "Then the person it was intended for..."
msgstr ""

#. 当然、<CLT 9>ひふみん<CLT>
#. だろーがよ！！
msgctxt "0003 | TOUKO FUKAWA"
msgid "...must have been <CLT 9>Huffy<CLT>!"
msgstr ""

#. その<CLT 9>メモの内容<CLT>を、
#. よく思い出して…
msgctxt "0004 | KYOUKO KIRIGIRI"
msgid "But remember <CLT 9>what the note said<CLT>."
msgstr ""

#. メモにあった集合時間は
#. 何時だったかしら？
msgctxt "0005 | KYOUKO KIRIGIRI"
msgid "What time did it say to meet?"
msgstr ""

#. 早朝６時だったな…
msgctxt "0006 | SAKURA OOGAMI"
msgid "6 a.m., I believe..."
msgstr ""

#. 何時に呼び出されてよーが…
msgctxt "0007 | TOUKO FUKAWA"
msgid "The time doesn't matter!"
msgstr ""

#. そんなん、<CLT 9>きよたんとは
#. 関係ねー<CLT>だろがッ！！
msgctxt "0008 | TOUKO FUKAWA"
msgid ""
"The note has\n"
"<CLT 9>nothing to do with Tick Tock<CLT>!"
msgstr ""

#. <CLT 26>そう考えるのが筋だが…<CLT>
msgctxt "0009 | TOUKO FUKAWA"
msgid "<CLT 26>So that's what you're thinking?<CLT>"
msgstr ""

#. <CLT 26>アタシに言ってんの？<CLT>
msgctxt "0010 | TOUKO FUKAWA"
msgid "<CLT 26>Are you asking me!?<CLT>"
msgstr ""

#. <CLT 26>怒鳴らないでください…<CLT>
msgctxt "0011 | TOUKO FUKAWA"
msgid "<CLT 26>Please don't yell...<CLT>"
msgstr ""
