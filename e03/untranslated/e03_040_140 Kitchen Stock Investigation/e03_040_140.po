msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0016 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi khu vực này sao?\n"
"<CLT>"
