#. <CLT 4>ロッカーだ…
#. <CLT>
msgctxt "0001 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Lockers...\n"
"<CLT>"
msgstr ""
"<CLT 4>Tủ đồ...\n"
"<CLT>"

#. <CLT 4>特に何もなさそうだ…
#. <CLT>
msgctxt "0002 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It doesn't look like they have anything in them.\n"
"<CLT>"
msgstr ""
"<CLT 4>Có vẻ như bên trong chẳng có gì cả.\n"
"<CLT>"

#. <CLT 4>マッサージチェアがある…
#. <CLT>
msgctxt "0003 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There's the massage chair.\n"
"<CLT>"
msgstr ""
"<CLT 4>Có một chiếc ghế massage.\n"
"<CLT>"

#. <CLT 4>随分、古い感じだな…
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It looks pretty old...\n"
"<CLT>"
msgstr ""
"<CLT 4>Nó trông khá cũ kỹ...\n"
"<CLT>"

#. はい
msgctxt "0005 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0006 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0007 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi đây?\n"
"<CLT>"
