#. １階の保健室だ。
#. <CLT>
msgctxt "0037 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hifumi's body was in the nurse's office on the 1st\n"
"floor.\n"
"<CLT>"
msgstr ""
"<CLT 4>Xác của Hifumi đã ở trong phòng y tế tại tầng 1.\n"
"<CLT>"

#. <CLT 4>台車を使っても、
#. １階から３階に運ぶのは不可能だし…
#. <CLT>
msgctxt "0038 | MAKOTO NAEGI"
msgid ""
