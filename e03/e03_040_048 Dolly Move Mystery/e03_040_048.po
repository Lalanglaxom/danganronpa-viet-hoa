#. はい
msgctxt "0046 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0047 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>物理準備室から出ますか？
#. <CLT>
msgctxt "0048 | NARRATION"
msgid ""
"<CLT 23>Leave the equipment room?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi phòng thiết bị?\n"
"<CLT>"
