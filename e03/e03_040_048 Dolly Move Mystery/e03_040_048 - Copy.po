msgctxt "0047 | CHOICE/RE:ACT"
msgid "No"
msgstr ""

#. <CLT 23>物理準備室から出ますか？
#. <CLT>
msgctxt "0048 | NARRATION"
msgid ""
"<CLT 23>Leave the equipment room?\n"
"<CLT>"
msgstr ""
