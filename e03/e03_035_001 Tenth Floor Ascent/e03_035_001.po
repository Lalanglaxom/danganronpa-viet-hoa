msgctxt "0001 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Everyone else is already on the 3rd floor. I have to\n"
"hurry...!\n"
"<CLT>"
msgstr ""
"<CLT 4>Mọi người khác đều đã ở trên tầng 3 rồi. Mình phải\n"
"nhanh lên mới được...!\n"
"<CLT>"
