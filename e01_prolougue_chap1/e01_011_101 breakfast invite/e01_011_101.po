#. もちろん, 入る訳にはいかない…
#. <CLT>
msgctxt "0036 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is the girls bathroom. Obviously I can't go in...\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là nhà vệ sinh nữ... Tất nhiên là mình không thể \n"
