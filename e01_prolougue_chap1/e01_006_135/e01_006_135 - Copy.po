#. 霧切さん、おはよう。
msgctxt "0001 | MAKOTO NAEGI"
msgid "Good morning, Kyoko."
msgstr ""

#. …おはよう。
msgctxt "0002 | KYOUKO KIRIGIRI"
msgid "...Morning."
msgstr ""

#. ………………
msgctxt "0003 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. ………………
msgctxt "0004 | KYOUKO KIRIGIRI"
msgid "..."
msgstr "..."

#. <CLT 4>か、会話が…続かない…
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This doesn't seem to be going anywhere.\n"
"<CLT>"
msgstr ""

#. えっと…
msgctxt "0006 | MAKOTO NAEGI"
msgid "Umm..."
msgstr ""

#. …何か用？
msgctxt "0007 | KYOUKO KIRIGIRI"
msgid "Did you need something?"
msgstr ""

#. あ、ううん。
#. 特には…
msgctxt "0008 | MAKOTO NAEGI"
msgid "Oh, uh...no, nothing in particular."
msgstr ""

#. そう…
msgctxt "0009 | KYOUKO KIRIGIRI"
msgid "Well then..."
msgstr ""

#. <CLT 4>行っちゃった…
#. <CLT>
msgctxt "0010 | MAKOTO NAEGI"
msgid ""
"<CLT 4>She left.\n"
"<CLT>"
msgstr ""

#. <CLT 4>霧切さんって…
#. 無口というか…クールな人だな。
#. <CLT>
msgctxt "0011 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Kyoko seems kind of...how should I put it? Taciturn?\n"
"Or maybe she just plays things cool.\n"
"<CLT>"
msgstr ""

#. おはよう、十神クン。
msgctxt "0012 | MAKOTO NAEGI"
msgid "Good morning, Byakuya."
msgstr ""

#. ………………
msgctxt "0013 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. <CLT 4>あれ、聞こえなかったのかな？
#. <CLT>
msgctxt "0014 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Huh? Did he not hear me?\n"
"<CLT>"
msgstr ""

#. 十神クン！　おはよう！
msgctxt "0015 | MAKOTO NAEGI"
msgid "Hey Byakuya! Good morning!"
msgstr ""

#. 一度言えば十分だ。
msgctxt "0016 | BYAKUYA TOGAMI"
msgid "Once is enough..."
msgstr ""

#. …え？
msgctxt "0017 | MAKOTO NAEGI"
msgid "Huh...?"
msgstr ""

#. 俺は朝食の為にここにいる…
#. お前と話す必要などない。下がれ。
msgctxt "0018 | BYAKUYA TOGAMI"
msgid ""
"I'm only here to get breakfast. I have neither need\n"
"nor desire to talk to you. Now withdraw."
msgstr ""

#. ………………
msgctxt "0019 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. <CLT 4>聞こえた上で…
#. 返事もしなかったって訳か…
#. <CLT>
msgctxt "0020 | MAKOTO NAEGI"
msgid ""
"<CLT 4>So he *did* hear me. He just didn't respond.\n"
"<CLT>"
msgstr ""

#. ………………
msgctxt "0021 | BYAKUYA TOGAMI"
msgid "..."
msgstr "..."

#. <CLT 4>これ以上話しかけても無駄だよな…
#. <CLT>
msgctxt "0022 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I don't think he's in the mood to talk.\n"
"<CLT>"
msgstr ""

#. あ、苗木君。
#. おはようございますぅ。
msgctxt "0023 | CHIHIRO FUJISAKI"
msgid "Oh, good morning Makoto..."
msgstr ""

#. おはよう、不二咲さん。
msgctxt "0024 | MAKOTO NAEGI"
msgid "Good morning, Chihiro."
msgstr ""

#. こうして朝の挨拶をしてもぉ…
msgctxt "0025 | CHIHIRO FUJISAKI"
msgid ""
"You know...we're standing here exchanging morning\n"
"greetings, but..."
msgstr ""

#. 窓の外も見えないし…
#. 本当に朝なのかわかんないねぇ…
msgctxt "0026 | CHIHIRO FUJISAKI"
msgid ""
"We can't even look out the window to see if it really\n"
"is morning..."
msgstr ""

#. う、うん…
msgctxt "0027 | MAKOTO NAEGI"
msgid "Y-Yeah, true..."
msgstr ""

#. あ、ごめんなさい…！
#. 変な事言っちゃって…
msgctxt "0028 | CHIHIRO FUJISAKI"
msgid "S-Sorry if that was kinda weird...!"
msgstr ""

#. そんな…謝る事ないよ…
msgctxt "0029 | MAKOTO NAEGI"
msgid "You don't have to apologize..."
msgstr ""

#. 本当にごめんね…
msgctxt "0030 | CHIHIRO FUJISAKI"
msgid "Sorry..."
msgstr ""

#. <CLT 4>すごくしょんぼりしてる…
#. なんか、悪い事をした気分だ…
#. <CLT>
msgctxt "0031 | MAKOTO NAEGI"
msgid ""
"<CLT 4>She looks really sad. I feel like I did something\n"
"wrong...\n"
"<CLT>"
msgstr ""

#. 変な事言っちゃって…
#. 本当にごめんなさい…
msgctxt "0032 | CHIHIRO FUJISAKI"
msgid "I'm really sorry if I creeped you out..."
msgstr ""

#. いいんだって。
#. もう気にしないでよ。
msgctxt "0033 | MAKOTO NAEGI"
msgid "It's okay, really. Don't worry about it."
msgstr ""

#. うん…
msgctxt "0034 | CHIHIRO FUJISAKI"
msgid "Okay..."
msgstr ""

#. <CLT 4>モノクマが写るモニター…
#. <CLT>
msgctxt "0035 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is one of the monitors Monokuma appears on.\n"
"<CLT>"
msgstr ""

#. <CLT 4>今は校章が浮かんでいるだけか…
#. <CLT>
msgctxt "0036 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Right now, it's just showing the school crest.\n"
"<CLT>"
msgstr ""

#. <CLT 4>でも、またいつモノクマが出てくるかと思うと…
#. <CLT>
msgctxt "0037 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I don't even wanna think about when he might show up\n"
"on that thing next...\n"
"<CLT>"
msgstr ""

#. はあ……
msgctxt "0038 | MAKOTO NAEGI"
msgid "Urgh..."
msgstr ""

#. <CLT 4>監視カメラ…
#. <CLT>
msgctxt "0039 | MAKOTO NAEGI"
msgid ""
"<CLT 4>A surveillance camera...\n"
"<CLT>"
msgstr ""

#. <CLT 4>こんなカメラで見られていると思うと、
#. 気分が悪いけど…
#. <CLT>
msgctxt "0040 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I hate the idea that someone might be watching me\n"
"right now.\n"
"<CLT>"
msgstr ""

#. <CLT 4>校則によると、監視カメラを壊したらマズイんだよな…
#. <CLT>
msgctxt "0041 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I have to keep in mind that it's against school\n"
"regulations to mess with any of the cameras.\n"
"<CLT>"
msgstr ""

#. <CLT 4>ムカツクけど、放っておくしかない…
#. <CLT>
msgctxt "0042 | MAKOTO NAEGI"
msgid ""
"<CLT 4>As much as it gets on my nerves, I'd better leave it\n"
"alone.\n"
"<CLT>"
msgstr ""

#. <CLT 4>時間さえも正しいのかわからない。
#. もう何を信じていいのやら…
#. <CLT>
msgctxt "0043 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I can't even be sure if that clock is right. I don't\n"
"know what to believe anymore...\n"
"<CLT>"
msgstr ""

#. はい
msgctxt "0044 | CHOICE/RE:ACT"
msgid "Yes"
msgstr ""

#. いいえ
msgctxt "0045 | CHOICE/RE:ACT"
msgid "No"
msgstr ""

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0046 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
