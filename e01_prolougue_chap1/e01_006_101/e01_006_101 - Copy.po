msgstr ""

#. じゃあ、早く行きましょう！
msgctxt "0082 | SAYAKA MAIZONO"
msgid "Good. Then let's get moving!"
msgstr ""

#. <CLT 4>ここは霧切さんの部屋だ。
#. 今は、特に用はないかな…
#. <CLT>
msgctxt "0083 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is Kyoko's room. I don't really have anything to\n"
"talk to her about right now...\n"
"<CLT>"
msgstr ""

#. <CLT 4>ドアの横のインターホンを押せばいいのか？
#. <CLT>
msgctxt "0084 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There's a doorbell next to the door. I guess I\n"
"should use that.\n"
"<CLT>"
msgstr ""

#. <CLT 23>「ピンポーン…」
#. <CLT>
msgctxt "0085 | NARRATION"
msgid ""
"<CLT 23>*Ding dong*\n"
"<CLT>"
msgstr ""

#. <CLT 4>………………
#. <CLT>
msgctxt "0086 | MAKOTO NAEGI"
msgid ""
"<CLT 4>...\n"
"<CLT>"
msgstr ""

#. はい…
msgctxt "0087 | SAYAKA MAIZONO"
msgid "Hello...?"
msgstr ""

#. …おはよう、舞園さん。
msgctxt "0088 | MAKOTO NAEGI"
msgid "Good morning, Sayaka."
msgstr ""

#. あ、苗木君。ちょうどよかった！
msgctxt "0089 | SAYAKA MAIZONO"
msgid "Oh, Makoto! Perfect timing!"
msgstr ""

#. …ちょうどよかった？
msgctxt "0090 | MAKOTO NAEGI"
msgid "Huh...?"
msgstr ""

#. あのですね…
#. ちょっと<CLT 1>【お願い事】<CLT>があるんです…
msgctxt "0091 | SAYAKA MAIZONO"
msgid "Listen, I have a <CLT 1>[favor]<CLT> to ask..."
msgstr ""

#. 苗木君。
#. どうして私の部屋に入ろうとしてるんですか？
msgctxt "0092 | SAYAKA MAIZONO"
msgid "Um...why are you trying to get into my room?"
msgstr ""

#. え、ええと、それは…
msgctxt "0093 | MAKOTO NAEGI"
msgid "Oh, uh..."
msgstr ""

#. ほら、早く行きましょう。
msgctxt "0094 | SAYAKA MAIZONO"
msgid "Come on, let's hurry up and go."
msgstr ""

#. ねぇ、苗木君。
#. どうして私の部屋に入ろうとしてるんですか？
msgctxt "0095 | SAYAKA MAIZONO"
msgid "Hey, um...why are you trying to get into my room?"
msgstr ""

#. え、ええと、それは…
msgctxt "0096 | MAKOTO NAEGI"
msgid "Oh, uh..."
msgstr ""

#. <CLT 4>ここは腐川さんの部屋みたいだ。
#. 今は、特に用はないかな…
#. <CLT>
