msgstr ""

#. <CLT 9>セレスティア<CLT>
#. なんとか…さん？
msgctxt "0009 | JUNKO ENOSHIMA (REAL)"
msgid ""
"<CLT 9>Celestia<CLT>\n"
"Lu—whatever?"
msgstr ""

#. それとも、
#. <CLT 9>大神さくら<CLT>さん？
msgctxt "0010 | JUNKO ENOSHIMA (REAL)"
msgid ""
"Or maybe\n"
"<CLT 9>Sakura Ogami<CLT>?"
msgstr ""

#. いやいやいや…
msgctxt "0011 | JUNKO ENOSHIMA (REAL)"
msgid "No no no..."
msgstr ""

#. やっぱ、<CLT 9>２回殺されたなんて<CLT>
#. あり得ないよ！
msgctxt "0012 | JUNKO ENOSHIMA (REAL)"
msgid ""
"There's no way anyone\n"
"was <CLT 9>murdered twice<CLT>!"
msgstr ""

