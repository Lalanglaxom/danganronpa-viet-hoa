#. 顔がわからないんだから…
msgctxt "0001 | JUNKO ENOSHIMA (REAL)"
msgid "You never saw their face, right?"
msgstr ""

#. 覆面の中身だって
#. わからないじゃん！
msgctxt "0002 | JUNKO ENOSHIMA (REAL)"
msgid ""
"So you can't have any idea\n"
"who was under that mask!"
msgstr ""

#. やっぱり、<CLT 9>正体は
#. 戦刃むくろ<CLT>だったんだよ！
msgctxt "0003 | JUNKO ENOSHIMA (REAL)"
msgid ""
"I'm telling you now,\n"
"<CLT 9>it was Mukuro Ikusaba<CLT>!"
msgstr ""

#. いいえ、
#. 顔がわからなくても…
msgctxt "0004 | KYOUKO KIRIGIRI"
msgid ""
"You're wrong.\n"
"Even without seeing their face..."
msgstr ""

#. 他の特徴と比べてみれば、
#. 答えは見えるはずよ。
msgctxt "0005 | KYOUKO KIRIGIRI"
msgid ""
"...there's another part of the attacker\n"
"we can use to prove it wasn't her."
msgstr ""

#. 他の特徴なんて
#. どこにあんの…？
msgctxt "0006 | JUNKO ENOSHIMA (REAL)"
msgid ""
"Oh?\n"
"And what is this other part?"
msgstr ""

#. <CLT 9>右手<CLT>にあるの？
msgctxt "0007 | JUNKO ENOSHIMA (REAL)"
msgid "Is it the <CLT 9>right hand<CLT>?"
msgstr ""

#. <CLT 9>左手<CLT>にあるの？
msgctxt "0008 | JUNKO ENOSHIMA (REAL)"
msgid "Or the <CLT 9>left hand<CLT>?"
msgstr ""

#. <CLT 9>右足<CLT>にあるの？
msgctxt "0009 | JUNKO ENOSHIMA (REAL)"
msgid "Maybe the <CLT 9>right foot<CLT>?"
msgstr ""

#. <CLT 9>左足<CLT>にあるの？
msgctxt "0010 | JUNKO ENOSHIMA (REAL)"
msgid "Or perhaps the <CLT 9>left foot<CLT>?"
msgstr ""

#. それとも、
#. <CLT 9>ヒップ<CLT>かしらん！？
msgctxt "0011 | JUNKO ENOSHIMA (REAL)"
msgid ""
"Or could it be...\n"
"the <CLT 9>hips<CLT>!?"
msgstr ""

#. <CLT 26>覆面が戦刃むくろだと？<CLT>
msgctxt "0012 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>The person under the mask was...Mukuro?<CLT>"
msgstr ""

#. <CLT 26>急にあやしいべ…<CLT>
msgctxt "0013 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>I'm totally doubtful, man!<CLT>"
msgstr ""

#. <CLT 26>何か隠してるよ！<CLT>
msgctxt "0014 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>He's hiding something!<CLT>"
msgstr ""

#. <CLT 26>右手<CLT>
msgctxt "0015 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>the right hand...<CLT>"
msgstr ""

#. <CLT 26>左手<CLT>
msgctxt "0016 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>the left hand...<CLT>"
msgstr ""

#. <CLT 26>右足<CLT>
msgctxt "0017 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>the right foot...<CLT>"
msgstr ""

#. <CLT 26>左足<CLT>
msgctxt "0018 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>the left foot...<CLT>"
msgstr ""

#. <CLT 26>ヒップ<CLT>
msgctxt "0019 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>the hips...<CLT>"
msgstr ""
