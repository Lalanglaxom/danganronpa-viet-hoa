msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0021 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi đây?\n"
"<CLT>"

#. <CLT 4>これは、冷蔵庫か…
#. <CLT>
msgctxt "0022 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The fridge...\n"
"<CLT>"
msgstr ""

#. <CLT 4>最後に、片っ端から片付けてやろうかな…
#. <CLT>
