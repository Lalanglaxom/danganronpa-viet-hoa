#. 戦刃むくろが別の誰かとして
#. 殺されてるって？
msgctxt "0001 | JUNKO ENOSHIMA (REAL)"
msgid ""
"Who is this \"someone else\"\n"
"that Mukuro was killed as?"
msgstr ""
"Cái \"người khác\" mà Mukuro\n"
"bị giết dưới danh tính đó là ai cơ?"

#. 別の誰かって…
#. <CLT 9>舞園さやか<CLT>さんの事？
msgctxt "0002 | JUNKO ENOSHIMA (REAL)"
msgid ""
"Was it...\n"
"<CLT 9>Sayaka Maizono<CLT>?"
msgstr ""
"Có phải là...\n"
"<CLT 9>Sayaka Maizono<CLT>?"

#. <CLT 9>江ノ島盾子<CLT>さん？
msgctxt "0003 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 9>Junko Enoshima<CLT>?"
msgstr "<CLT 9>Junko Enoshima<CLT>?"

#. <CLT 9>桑田怜恩<CLT>クン？
msgctxt "0004 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 9>Leon Kuwata<CLT>?"
msgstr "<CLT 9>Leon Kuwata<CLT>?"

#. <CLT 9>不二咲千尋<CLT>クン？
msgctxt "0005 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 9>Chihiro Fujisaki<CLT>?"
msgstr "<CLT 9>Chihiro Fujisaki<CLT>?"

#. <CLT 9>大和田紋土<CLT>クン？
msgctxt "0006 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 9>Mondo Owada<CLT>?"
msgstr "<CLT 9>Mondo Owada<CLT>?"

#. <CLT 9>石丸清多夏<CLT>クン？
msgctxt "0007 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 9>Kiyotaka Ishimaru<CLT>?"
msgstr "<CLT 9>Kiyotaka Ishimaru<CLT>?"

#. <CLT 9>山田一二三<CLT>クン？
msgctxt "0008 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 9>Hifumi Yamada<CLT>?"
msgstr "<CLT 9>Hifumi Yamada<CLT>?"

#. <CLT 9>セレスティア<CLT>
#. なんとか…さん？
msgctxt "0009 | JUNKO ENOSHIMA (REAL)"
msgid ""
"<CLT 9>Celestia<CLT>\n"
"Lu—whatever?"
msgstr ""
"<CLT 9>Celestia<CLT>\n"
"Lu—gì gì đó?"

#. それとも、
#. <CLT 9>大神さくら<CLT>さん？
msgctxt "0010 | JUNKO ENOSHIMA (REAL)"
msgid ""
"Or maybe\n"
"<CLT 9>Sakura Ogami<CLT>?"
msgstr ""
"Hay có lẽ là\n"
"<CLT 9>Sakura Ogami<CLT>?"

#. いやいやいや…
msgctxt "0011 | JUNKO ENOSHIMA (REAL)"
msgid "No no no..."
msgstr "Không không không..."

#. やっぱ、<CLT 9>２回殺されたなんて<CLT>
#. あり得ないよ！
msgctxt "0012 | JUNKO ENOSHIMA (REAL)"
msgid ""
"There's no way anyone\n"
"was <CLT 9>murdered twice<CLT>!"
msgstr ""
"Không đời nào có ai lại\n"
"bị <CLT 9>giết hai lần<CLT> cả!"

