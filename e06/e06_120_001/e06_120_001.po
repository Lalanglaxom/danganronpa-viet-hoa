#. あたし達が植物庭園で
#. 見つけた死体…
msgctxt "0001 | TOUKO FUKAWA"
msgid "The body we f-found in the garden..."
msgstr ""

#. あ、あれは…
#. <CLT 9>戦刃むくろじゃない<CLT>のよ！
msgctxt "0002 | TOUKO FUKAWA"
msgid "It <CLT 9>wasn't Mukuro<CLT>!"
msgstr ""

#. じゃあ、戦刃むくろって
#. 生きてるの！？
msgctxt "0003 | AOI ASAHINA"
msgid "Then she's still alive!?"
msgstr ""

#. そ、そうよ…江ノ島の死体を
#. 自分に見せかける事でね…！
msgctxt "0004 | TOUKO FUKAWA"
msgid ""
"Th-That's right. She made it\n"
"look like Junko's b-body was her!"
msgstr ""

#. つまり、戦刃むくろこそが
#. <CLT 9>黒幕の正体<CLT>よ…！
msgctxt "0005 | TOUKO FUKAWA"
msgid ""
"S-So the <CLT 9>mastermind's true identity<CLT>\n"
"is...Mukuro!"
msgstr ""

#. どうだ、モノクマ！
#. 観念しろ！！
msgctxt "0006 | YASUHIRO HAGAKURE"
msgid ""
"Whaddya say, Monokuma!?\n"
"Do you give up!?"
msgstr ""

#. <CLT 9>シーン……<CLT>
msgctxt "0007 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 9>Hmmmmmmm...<CLT>"
msgstr ""

#. <CLT 26>なるほどな！<CLT>
msgctxt "0008 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>Interesting!<CLT>"
msgstr "Thú vị đấy!"

#. <CLT 26>ちょっと待って…<CLT>
msgctxt "0009 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>Hold on...<CLT>"
msgstr "Khoan đã..."

#. <CLT 26>何か…見落としてる。<CLT>
msgctxt "0010 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>We're missing something...<CLT>"
msgstr ""

#. <CLT 26>モノクマを操ってるのは…<CLT>
msgctxt "0011 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>The one controlling Monokuma...<CLT>"
msgstr ""

#. <CLT 26>戦刃むくろなんだね！<CLT>
msgctxt "0012 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>It's Mukuro Ikusaba!<CLT>"
msgstr ""

#. <CLT 26>落ち着け腐川…<CLT>
msgctxt "0013 | JUNKO ENOSHIMA (REAL)"
msgid "<CLT 26>Just calm down, Toko...<CLT>"
msgstr ""
