#. ボク達は…負けない…
msgctxt "0001 | MAKOTO NAEGI"
msgid "We won't give up...!"
msgstr ""

#. <CLT 9>希望<CLT>がある限り、
#. 負けないんだ！
msgctxt "0002 | MAKOTO NAEGI"
msgid ""
"As long as there's <CLT 9>hope<CLT>,\n"
"we'll never give up!"
msgstr ""

#. もし、アタシが処刑
#. されたりしたら…
msgctxt "0003 | JUNKO ENOSHIMA (REAL)"
msgid "If I were to die..."
msgstr ""

#. 希望ヶ峰学園は
#. 終わりだから。
msgctxt "0004 | JUNKO ENOSHIMA (REAL)"
msgid ""
"...that would be the end of\n"
"Hope's Peak Academy."
msgstr ""

#. <CLT 9>…………<CLT>
msgctxt "0005 | YASUHIRO HAGAKURE"
msgid "<CLT 9>... ... ...<CLT>"
msgstr ""

#. ちなみに、外の世界は
#. 汚染されてるよ。
msgctxt "0006 | JUNKO ENOSHIMA (REAL)"
msgid ""
"By the way,\n"
"the air outside is totally polluted,\n"
"ya know."
msgstr ""

#. ここが平気なのは…
msgctxt "0007 | JUNKO ENOSHIMA (REAL)"
msgid "The only reason we're okay in here..."
msgstr ""

#. 物理室の
#. 空気清浄機のおかげ。
msgctxt "0008 | JUNKO ENOSHIMA (REAL)"
msgid ""
"...is thanks to the air purifiers\n"
"in the physics lab."
msgstr ""

#. <CLT 9>…………<CLT>
msgctxt "0009 | AOI ASAHINA"
msgid "<CLT 9>... ... ...<CLT>"
msgstr ""

#. アタシが死んだら
#. 空気清浄機も強制停止。
msgctxt "0010 | JUNKO ENOSHIMA (REAL)"
msgid ""
"If I die, the purifiers\n"
"will screech to a halt."
msgstr ""

#. つまり、アタシが
#. 処刑された時点で…
msgctxt "0011 | JUNKO ENOSHIMA (REAL)"
msgid ""
"In other words,\n"
"as soon as I die..."
msgstr ""

#. この学園での
#. 共同生活は終わりよ。
msgctxt "0012 | JUNKO ENOSHIMA (REAL)"
msgid ""
"...the communal life you've\n"
"all been living will come to an end."
msgstr ""

#. <CLT 9>…………<CLT>
msgctxt "0013 | TOUKO FUKAWA"
msgid "<CLT 9>... ... ...<CLT>"
msgstr ""

#. そして、オマエラは
#. 出ていかなければならない。
msgctxt "0014 | JUNKO ENOSHIMA (REAL)"
msgid "All of you will have to leave."
msgstr ""

#. 絶望と死だけが存在する
#. 外の世界にね…
msgctxt "0015 | JUNKO ENOSHIMA (REAL)"
msgid ""
"You'll have to go into the world outside,\n"
"where only death and despair are waiting..."
msgstr ""

#. <CLT 9>…………<CLT>
msgctxt "0016 | BYAKUYA TOGAMI"
msgid "<CLT 9>... ... ...<CLT>"
msgstr ""

#. さぁ、どうする気？
msgctxt "0017 | JUNKO ENOSHIMA (REAL)"
msgid "So? What are you gonna do?"
msgstr ""

#. 死ぬの？
#. 死にたいの？
msgctxt "0018 | JUNKO ENOSHIMA (REAL)"
msgid ""
"Will you just die?\n"
"Is that what you want?"
msgstr ""

#. …………
msgctxt "0019 | KYOUKO KIRIGIRI"
msgid "..."
msgstr "..."

#. 俺は…俺の直感を
#. 信じる事にしたべ！
msgctxt "0020 | YASUHIRO HAGAKURE"
msgid ""
"I...I've decided\n"
"to have faith in myself!"
msgstr ""

#. 何言われたって、
#. 私はもう決めたよっ！！
msgctxt "0021 | AOI ASAHINA"
msgid ""
"Say whatever you want,\n"
"I've made my decision!"
msgstr ""

#. 生きられる！
#. 白夜様の愛があれば！
msgctxt "0022 | TOUKO FUKAWA"
msgid ""
"I can keep on living, as long as\n"
"I have my master's love!"
msgstr ""

#. 言ったはずだ。
#. 必ず黒幕を殺すと…
msgctxt "0023 | BYAKUYA TOGAMI"
msgid ""
"I already said I would claim\n"
"the mastermind's life,\n"
"by whatever means necessary."
msgstr ""

#. <CLT 9>…………<CLT>
msgctxt "0024 | KYOUKO KIRIGIRI"
msgid "<CLT 9>... ... ...<CLT>"
msgstr ""

#. <CLT 26>絶望絶望絶望絶望絶望<CLT>
msgctxt "0025 | KYOUKO KIRIGIRI"
msgid "<CLT 26>Despair...despair...despair...despair...despair...<CLT>"
msgstr ""

