msgid ""
"<CLT 4>There's a bunch of magazines in here. I guess that's a\n"
"good way to kill time while you're doing laundry.\n"
"<CLT>"
msgstr ""

#. <CLT 4>今、気付いたけど、
#. このスクール水着って！
#. <CLT>
msgctxt "0019 | MAKOTO NAEGI"
msgid ""
"<CLT 4>You know, all this time the swimsuit's been here, I\n"
"never found out whose it was. Let's see...\n"
"<CLT>"
msgstr ""

#. <CLT 4>…葉隠って書いてあるぞ！
#. 騙されてた！　色んな意味で！
#. <CLT>
msgctxt "0020 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Ah! It has Hiro's name written on it! I've been lied\n"
"to! In so many ways!\n"
"<CLT>"
msgstr ""

#. <CLT 4>自販機だ…
#. なんかケミカルな飲み物ばっかりだな。
#. <CLT>
msgctxt "0021 | MAKOTO NAEGI"
msgid ""
"<CLT 4>All that's inside the vending machine is energy\n"
"drinks...\n"
"<CLT>"
msgstr ""
"<CLT 4>Tất cả những gì có bên trong máy bán hàng tự động\n"
"là nước tăng lực...\n"
"<CLT>"

