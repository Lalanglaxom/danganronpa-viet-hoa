#. 包丁を持ち出したのは苗木だ！
#. 証拠もねーだろ！？
msgctxt "0001"
msgid ""
"Makoto's the one that took the knife!\n"
"Can you prove I'm wrong!?"
msgstr ""
"Makoto mới là kẻ đã lấy con dao đó!\n"
"Mày có chứng minh được là tao sai không!?"
#. 苗木が犯人だ！
msgctxt "0002"
msgid "You did it, Makoto!"
msgstr "Mày là kẻ sát nhân, Makoto!"
#. 怪しいぜ！
msgctxt "0003"
msgid "Very suspicious, man!"
msgstr "Đáng nghi lắm đấy con trai!"
#. 言い訳無用！
msgctxt "0004"
msgid "Stop making excuses!"
msgstr "Ngưng bào chữa đi!"
#. 決まりだな！
msgctxt "0005"
msgid "It's all over!"
msgstr "Mọi chuyện kết thúc rồi!"
#. アホッ！
msgctxt "0006"
msgid "Stupid!"
msgstr "Đồ ngu!"
#. 嘘つくな！
msgctxt "0007"
msgid "Don't lie!"
msgstr "Đừng có xạo!"
#. 黙ってろ！
msgctxt "0008"
msgid "Stop talking!"
msgstr "Câm miệng đi!"
#. うるせぇ！
msgctxt "0009"
msgid "Shut up!"
msgstr "Biến đi!"
#. うぐっ！？
msgctxt "0010"
msgid "Grh!"
msgstr "Grh!"