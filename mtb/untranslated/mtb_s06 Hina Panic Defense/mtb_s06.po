#. さくらちゃんが毒薬を
#. 持ち出した証拠があるのっ！？
msgctxt "0001"
msgid ""
"Do you have any kind of proof\n"
"Sakura took the poison!?"
msgstr ""
"Mấy ông bà có bằng chứng nào cho thấy\n"
"Sakura đã lấy thuốc độc không!?"
#. そんなのウソだよ！
msgctxt "0002"
msgid "You're a liar!"
msgstr "Ông đang nói dối!"
#. 何言ってんの！？
msgctxt "0003"
msgid "What are you saying!?"
msgstr "Ông đang nói cái gì vậy!?"
#. 違う…違うもん！
msgctxt "0004"
msgid "Wrong... You're wrong!"
msgstr "Sai rồi... Ông sai rồi!"
#. 犯人は私だよ…
msgctxt "0005"
msgid "I'm telling you, I did it!"
msgstr "Tui đã nói rồi, chính tui là người làm!"
#. もう終わりにしてよッ…
msgctxt "0006"
msgid "Just let it end already!"
msgstr "Hãy kết thúc chuyện này đi mà!"
#. やめて言わないで！
msgctxt "0007"
msgid "Stop talking!"
msgstr "Đừng nói nữa!"
#. 聞きたくない！
msgctxt "0008"
msgid "I don't wanna hear it!"
msgstr "Tui không muốn nghe!"
#. 苗木のバカァ！
msgctxt "0009"
msgid "I hate you!"
msgstr "Tui ghét ông lắm!"
#. うぐッ！
msgctxt "0010"
msgid "Ngh!"
msgstr "Ngh!"