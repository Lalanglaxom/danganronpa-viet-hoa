#. あ、あたしが娯楽室に隠れてたなんて…
#. そんな訳…な、ないじゃない…ッ！
msgctxt "0001"
msgid "Hiding i-in the rec room? Don't be r-r-ridiculous!"
msgstr "Tr-Trốn trong phòng giải trí á? Đừng có n-n-nực cười như vậy!"
#. 言いがかりよ！
msgctxt "0002"
msgid "It's a l-lie!"
msgstr "Đó là l-lời nói dối!"
#. 認めないから…！
msgctxt "0003"
msgid "I admit n-nothing!"
msgstr "Tôi không th-thừa nhận gì hết!"
#. 迷惑なのよ！
msgctxt "0004"
msgid "I h-hate you!"
msgstr "Tôi gh-ghét cậu!"
#. 呪ってやる…！
msgctxt "0005"
msgid "I curse you...!"
msgstr "Tôi nguyền rủa cậu...!"
#. こっち見んな！
msgctxt "0006"
msgid "Shut up...!"
msgstr "Câm miệng...!"
#. 違う違う違う！
msgctxt "0007"
msgid "N-No no no!"
msgstr "Kh-Không không không!"
#. 知らないわよ…！
msgctxt "0008"
msgid "I d-don't know anything!"
msgstr "Tôi kh-không biết gì hết!"
#. いい加減にしてよ…！
msgctxt "0009"
msgid "That's en-nough!"
msgstr "Đủ r-rồi đó!"
#. ひぃぃ…ッ！
msgctxt "0010"
msgid "Kyeeh!"
msgstr "Kyeeh!"