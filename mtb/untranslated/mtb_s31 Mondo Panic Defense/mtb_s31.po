#. 証拠がなけりゃ、ただのデッチ上げだ！
#. そんなモン認めねーぞ！！
msgctxt "0001"
msgid ""
"Without evidence, it's all bullshit!\n"
"It's bullshit and I refuse to acknowledge it!"
msgstr ""
"Không có bằng chứng thì toàn là nhảm nhí hết!\n"
"Toàn là vớ vẩn và tao đéo chấp nhận chuyện này!"
#. 証拠あんのかッ！
msgctxt "0002"
msgid "Where's your proof!?"
msgstr "Bằng chứng của mày đâu!?"
#. ふざけんなッ！
msgctxt "0003"
msgid "You kiddin' me!?"
msgstr "Mày đang giỡn mặt với tao hả!?"
#. 認めねー！
msgctxt "0004"
msgid "Not a chance!"
msgstr "Không đời nào!"
#. オレじゃねぇ！
msgctxt "0005"
msgid "It wasn't me!"
msgstr "Đéo phải tao!"
#. アホッ！
msgctxt "0006"
msgid "Stupid!"
msgstr "Đồ ngu!"
#. 嘘だッ！
msgctxt "0007"
msgid "You lie!"
msgstr "Mày xạo!"
#. 黙ってろッ！
msgctxt "0008"
msgid "Stop talking!"
msgstr "Câm miệng đi!"
#. うるせぇ！
msgctxt "0009"
msgid "Shut up!"
msgstr "Biến đi!"
#. うぐっ！？
msgctxt "0010"
msgid "Grh!"
msgstr "Grh!"