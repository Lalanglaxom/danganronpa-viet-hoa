#. 明日に絶望しろッ！　未知に絶望しろッ！
#. 思い出に絶望しろーッ！
msgctxt "0001"
msgid ""
"Despair into tomorrow!\n"
"Despair into your memories!\n"
"Despair into nothingness!"
msgstr ""
"Hãy tuyệt vọng vào ngày mai đi!\n"
"Hãy tuyệt vọng vào những ký ức của ngươi đi!\n"
"Hãy tuyệt vọng vào sự hư vô đi!"
#. ウザイんだよ！
msgctxt "0002"
msgid "You suck!"
msgstr "Cậu tệ hại thật đấy!"
#. なんなのよッ！
msgctxt "0003"
msgid "Whaddya want!?"
msgstr "Muốn cái gì hả!?"
#. 寒いんだってばッ！
msgctxt "0004"
msgid "SO uncool!"
msgstr "Chẳng ngầu chút nào luôn!"
#. ふざけろ希望ッ！
msgctxt "0005"
msgid "Hope is a joke!"
msgstr "Hy vọng chỉ là một trò đùa thôi!"
#. 外には絶望だけだッ！
msgctxt "0006"
msgid "Outside is only despair!"
msgstr "Bên ngoài chỉ toàn là tuyệt vọng thôi!"
#. あんたなんか…！
msgctxt "0007"
msgid "Who *are* you!?"
msgstr "Ngươi nghĩ mình là ai hả!?"
#. 気持ち悪いッ！！
msgctxt "0008"
msgid "You're gross!"
msgstr "Kinh tởm thật đấy!"
#. 本当は怖いんだろッ！
msgctxt "0009"
msgid "You're scared, aren't you?"
msgstr "Ngươi đang sợ hãi, có đúng không?"
#. 絶望に侵されろ！
msgctxt "0010"
msgid "Suffer from despair!"
msgstr "Hãy gặm nhấm sự tuyệt vọng đi!"
#. 私様に逆らうというの！？
msgctxt "0011"
msgid "You dare to stand against us?"
msgstr "Cậu dám đứng lên chống lại bọn tớ sao?"
#. 戯れ言はここまでよ…
msgctxt "0012"
msgid "Your idiocy ends here..."
msgstr "Sự ngu ngốc của ngươi kết thúc tại đây rồi..."
#. 絶望的に愛してる！
msgctxt "0013"
msgid "I just looove despair!"
msgstr "Tớ chỉ yê-ê-êu tuyệt vọng thôi!"
#. 大っ嫌いクマー！
msgctxt "0014"
msgid "You're unbearable!"
msgstr "Ngươi thật không thể chịu nổi mà!"
#. 死にたいのですか…！？
msgctxt "0015"
msgid "Would you like to die?"
msgstr "Ngươi có muốn chết không...?"
#. 無駄無駄無駄ッ！
msgctxt "0016"
msgid "Everything is pointless!"
msgstr "Mọi thứ đều là vô nghĩa!"
#. イヤッ！
msgctxt "0017"
msgid "No...!"
msgstr "Không...!"
#. このぉ…！
msgctxt "0018"
msgid "Damn you...!"
msgstr "Chết tiệt...!"