#. ところで、苗木君に１つ質問があります。
msgctxt "0001 | SAYAKA MAIZONO"
msgid "Listen, may I ask you just one question?"
msgstr ""

#. また急に改まって…どうしたの？
msgctxt "0002 | MAKOTO NAEGI"
msgid "So polite again...! What's going on?"
msgstr ""

#. また急に改まって聞きますけど…
msgctxt "0003 | SAYAKA MAIZONO"
msgid "And so polite again, I'd like to ask..."
msgstr ""

#. 苗木君って<CLT 3>彼女<CLT>はいるんですか？
msgctxt "0004 | SAYAKA MAIZONO"
msgid "Do you have a <CLT 3>girlfriend<CLT>?"
msgstr ""

#. え…ええっ！？
msgctxt "0005 | MAKOTO NAEGI"
msgid "Wh-What!?"
msgstr ""

#. な、なんで、急にそんな事…！？
msgctxt "0006 | MAKOTO NAEGI"
msgid "That's like, way outta nowhere!"
msgstr ""

#. あれ、焦ってます？
#. つまり、いるって事ですか…？
msgctxt "0007 | SAYAKA MAIZONO"
msgid "Huh? Are you embarrassed? Does that mean you do?"
msgstr ""

#. い、いや…いないよ！
#. 彼女なんて…まだ全然だよッ！
msgctxt "0008 | MAKOTO NAEGI"
msgid "N-No, I don't! A girlfriend...? Not at all!"
msgstr ""

#. …じゃあ、好きな人は？
msgctxt "0009 | SAYAKA MAIZONO"
msgid "Then...do you at least have a crush on someone?"
msgstr ""

#. ちょ、ちょっと待ってよ！
msgctxt "0010 | MAKOTO NAEGI"
msgid "J-Just wait a second!"
msgstr ""

#. さっきから、どうしたの？
#. なんで、そんな質問するの？
msgctxt "0011 | MAKOTO NAEGI"
msgid ""
"What's going on here? Why are you asking all these\n"
"questions?"
msgstr ""

#. 気になったから聞いてみただけですよ。
#. ダメですか？
msgctxt "0012 | SAYAKA MAIZONO"
msgid "I was just curious, so I thought I'd ask. Is that bad?"
msgstr ""

#. ダ、ダメって言うか…
msgctxt "0013 | MAKOTO NAEGI"
msgid "I-It's not that it's bad..."
msgstr ""

#. でも…気になって当然じゃないですか…
#. だって、苗木君は…
msgctxt "0014 | SAYAKA MAIZONO"
msgid ""
"But it's only natural I'd be curious, right?\n"
"Because we're..."
msgstr ""

#. <CLT 4>ボ、ボクは！？
#. <CLT>
msgctxt "0015 | MAKOTO NAEGI"
msgid ""
"<CLT 4>W-We're—!?\n"
"<CLT>"
msgstr ""

#. …同じ境遇にいる<CLT 3>仲間同士<CLT>なんですから。
msgctxt "0016 | SAYAKA MAIZONO"
msgid ""
"Because we're <CLT 3>classmates<CLT>, going through the same\n"
"thing together."
msgstr ""

#. <CLT 4>仲間…
#. <CLT>
msgctxt "0017 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Classmates...\n"
"<CLT>"
msgstr ""

#. でも…本当はそれだけじゃありません…
msgctxt "0018 | SAYAKA MAIZONO"
msgid "Although...that's not all there is to it."
msgstr ""

#. 私と苗木君は仲間を超えた…
msgctxt "0019 | SAYAKA MAIZONO"
msgid "You and I are more than just classmates..."
msgstr ""

#. <CLT 4>…仲間を超えた！？
#. <CLT>
msgctxt "0020 | MAKOTO NAEGI"
msgid ""
"<CLT 4>More than that...!?\n"
"<CLT>"
msgstr ""

#. <CLT 3>友達<CLT>ですもんね。中学時代からの。
msgctxt "0021 | SAYAKA MAIZONO"
msgid ""
"We're <CLT 3>friends<CLT>. We've been friends since middle\n"
"school, in a way."
msgstr ""

#. <CLT 4>そう…だよな…
#. <CLT>
msgctxt "0022 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Th-That's true...\n"
"<CLT>"
msgstr ""

#. <CLT 4>うん、友達だよな…
#. もちろん、そうだよな…
#. <CLT>
msgctxt "0023 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Yeah, we're friends. Of course...\n"
"<CLT>"
msgstr ""

#. ………………
msgctxt "0024 | SAYAKA MAIZONO"
msgid "..."
msgstr "..."

#. …苗木君は聞いてくれないんですか？
msgctxt "0025 | SAYAKA MAIZONO"
msgid "So? Aren't you going to ask me?"
msgstr ""

#. え？　何を？
msgctxt "0026 | MAKOTO NAEGI"
msgid "Huh? What?"
msgstr ""

#. 何を…じゃなくってですね…
msgctxt "0027 | SAYAKA MAIZONO"
msgid "No, not what."
msgstr ""

#. 私に<CLT 3>彼氏がいないか<CLT>ですよ。
msgctxt "0028 | SAYAKA MAIZONO"
msgid ""
"Aren't you going to ask if I have a <CLT 3>boyfriend<CLT> or\n"
"not?"
msgstr ""

#. <CLT 4>正直、聞きたいけど…
#. 聞きたくないって言うか…
#. <CLT>
msgctxt "0029 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I mean, it's not like I don't want to know. Of course\n"
"I want to know...\n"
"<CLT>"
msgstr ""

#. 舞園さんなんて色んな人からモテるだろうし、
#. やっぱり…いてもおかしくは…
msgctxt "0030 | MAKOTO NAEGI"
msgid ""
"You're really popular, right? So I wouldn't be\n"
"surprised if you did..."
msgstr ""

#. ブブーッ！　彼氏なんていません！
msgctxt "0031 | SAYAKA MAIZONO"
msgid "Nooope! I definitely don't!"
msgstr ""

#. …って言うか、忙しくて作るヒマないって言うのが、
#. 本当なんですけどね…
msgctxt "0032 | SAYAKA MAIZONO"
msgid ""
"...The truth is, I'm way too busy for things like\n"
"that."
msgstr ""

#. じゃ、じゃあさ…
msgctxt "0033 | MAKOTO NAEGI"
msgid "Th-Then..."
msgstr ""

#. 好きな人…とかは…？
msgctxt "0034 | MAKOTO NAEGI"
msgid "Do you have a...crush on someone?"
msgstr ""

#. …うふふ、どうでしょうね？
msgctxt "0035 | SAYAKA MAIZONO"
msgid "Hmhm. I wonder..."
msgstr ""

#. <CLT 3>気になる人<CLT>なら…いますけど…
msgctxt "0036 | SAYAKA MAIZONO"
msgid "Let's just say...there's someone I'm <CLT 3>interested in<CLT>."
msgstr ""

#. <CLT 4>舞園さん真っ直ぐボクの目を見つめていた。
#. その頬は、ほんの少し赤らんでいるようにも…
#. <CLT>
msgctxt "0037 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Sayaka stared straight into my eyes. I could swear her\n"
"cheeks were tinged with red...\n"
"<CLT>"
msgstr ""

#. <CLT 4>…え？　ボクを見つめて？
#. <CLT>
msgctxt "0038 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Wait...me?\n"
"<CLT>"
msgstr ""

#. でも、その気持ちはしばらくしまっておきます。
#. ここから出る事が最優先ですもんね。
msgctxt "0039 | SAYAKA MAIZONO"
msgid ""
"But I need to put those feelings aside for now.\n"
"Getting out of here is all that matters."
msgstr ""

#. う、うん…そうだね…
msgctxt "0040 | MAKOTO NAEGI"
msgid "Y-Yeah, you're right..."
msgstr ""

#. …苗木君、絶対に一緒にここから出ましょうね。
msgctxt "0041 | SAYAKA MAIZONO"
msgid ""
"Let's get out of here together, Makoto. No matter\n"
"what..."
msgstr ""

#. 私の事…裏切らないでくださいよ？
msgctxt "0042 | SAYAKA MAIZONO"
msgid "Please don't turn your back on me, okay?"
msgstr ""

#. も、もちろんだよ…！
#. ボクが舞園さんを裏切る訳ないじゃないか！
msgctxt "0043 | MAKOTO NAEGI"
msgid "O-Of course! I would never turn my back on you!"
msgstr ""

#. 苗木君…今から言うのは私の本心です。
#. 偽る事のない本心です…
msgctxt "0044 | SAYAKA MAIZONO"
msgid ""
"I want you to know something, Makoto. And I want you\n"
"to know that I mean it—I can't fake my feelings..."
msgstr ""

#. やっぱり…苗木君がいてくれて良かった…
msgctxt "0045 | SAYAKA MAIZONO"
msgid "I'm...really glad you're here."
msgstr ""

#. <CLT 4>その笑顔を目にした途端、
#. ボクの全身に力が満ち溢れていくようだった。
#. <CLT>
msgctxt "0046 | MAKOTO NAEGI"
msgid ""
"<CLT 4>When she smiled at me like that, I could feel my\n"
"entire body filling with power.\n"
"<CLT>"
msgstr ""

#. <CLT 4>舞園さんの笑顔が、
#. ボクの力に変わっていくようだった。
#. <CLT>
msgctxt "0047 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It was like her smile was a source of pure energy.\n"
"<CLT>"
msgstr ""

#. <CLT 4>彼女と仲良くなれたお陰で、
#. ボクは勇気を手に入れられたのかもしれない…
#. <CLT>
msgctxt "0048 | SAYAKA MAIZONO"
msgid ""
"<CLT 4>My friendship with her is my one source of courage...\n"
"<CLT>"
msgstr ""

#. <CLT 4>彼女との<CLT><CLT 3>“絆”<CLT><CLT 4>が、ボクを強くしてくれた。
#. <CLT>
msgctxt "0049 | SAYAKA MAIZONO"
msgid ""
"<CLT 4>My <CLT><CLT 3>bond<CLT><CLT 4> with her makes me stronger.\n"
"<CLT>"
msgstr ""

#. <CLT 4>だったら、今度はボクは頑張らないと！
#. <CLT>
msgctxt "0050 | SAYAKA MAIZONO"
msgid ""
"<CLT 4>So I have to do my best in here!\n"
"<CLT>"
msgstr ""

#. <CLT 4>…舞園さんの為にもだ！
#. <CLT>
msgctxt "0051 | SAYAKA MAIZONO"
msgid ""
"<CLT 4>For myself, and for Sayaka!\n"
"<CLT>"
msgstr ""

#. 嬉しいです。私の為に頑張ってくれるなんて！
msgctxt "0052 | SAYAKA MAIZONO"
msgid "I'm so happy you're going to do your best for me!"
msgstr ""

#. …え！？　聞こえたっ！？
msgctxt "0053 | MAKOTO NAEGI"
msgid "What!? You heard me!?"
msgstr ""

#. エスパーですから。
msgctxt "0054 | SAYAKA MAIZONO"
msgid "Like I said, I'm psychic."
msgstr ""

#. 冗談です。ただの勘です…けど…
msgctxt "0055 | SAYAKA MAIZONO"
msgid "Kidding! I just have really good intuition."
msgstr ""

#. …本当にそう思ってくれたんですか？
msgctxt "0056 | SAYAKA MAIZONO"
msgid "...But is that really what you were thinking?"
msgstr ""

#. え、えっと…それは…
msgctxt "0057 | MAKOTO NAEGI"
msgid "U-Umm...well..."
msgstr ""

#. と、とにかくさ！　一緒に協力して、
#. 絶対にここから出ようね！
msgctxt "0058 | MAKOTO NAEGI"
msgid ""
"A-Anyway, let's just help each other out and get out\n"
"of here, no matter what it takes!"
msgstr ""

#. ボクも…頑張るからさっ！！
msgctxt "0059 | MAKOTO NAEGI"
msgid "I'm gonna do my best for sure!"
msgstr ""

#. はい、そうですね。
#. 一緒に頑張りましょうね。
msgctxt "0060 | SAYAKA MAIZONO"
msgid ""
"Yeah, you're right. We need to work together and do\n"
"our best..."
msgstr ""

#. …うふふふ！
msgctxt "0061 | SAYAKA MAIZONO"
msgid "Hehehe...!"
msgstr ""

#. <CLT 4>頑張ろう…ボクはこの時ほど、
#. その言葉を強く胸に刻んだ時はない。
#. <CLT>
msgctxt "0062 | MAKOTO NAEGI"
msgid ""
"<CLT 4>\"I'm gonna do my best\"... I carved those words into\n"
"the walls of my soul.\n"
"<CLT>"
msgstr ""

#. <CLT 23>舞園さやかの<CLT><CLT 3>通信簿<CLT><CLT 23>に、今の情報を追記致しました。
#. <CLT>
msgctxt "0063 | NARRATION"
msgid ""
"<CLT 23>Sayaka's <CLT><CLT 3>Report Card<CLT><CLT 23> has been updated based on your\n"
"experience with her.\n"
"<CLT>"
msgstr ""

#. <CLT 23>おめでとうございます。
#. <CLT><CLT 3>“スキルポイント”<CLT><CLT 23>が上がりました。
#. <CLT>
msgctxt "0064 | NARRATION"
msgid ""
"<CLT 23>Your maximum number of <CLT><CLT 3>Skill Points<CLT><CLT 23> has increased!\n"
"Hey, look at you go!\n"
"<CLT>"
msgstr ""

#. <CLT 4>舞園さんと健闘を誓い合った後、
#. ボクは自分の部屋へと戻っていった。
#. <CLT>
msgctxt "0065 | MAKOTO NAEGI"
msgid ""
"<CLT 4>After vowing to Sayaka to give it my all, I went back\n"
"to my room.\n"
"<CLT>"
msgstr ""
