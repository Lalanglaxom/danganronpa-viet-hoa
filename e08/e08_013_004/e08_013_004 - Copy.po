#. あ、苗木じゃん。何してんの？
msgctxt "0001 | JUNKO ENOSHIMA (MUKURO)"
msgid "Hey, Makoto. What's up?"
msgstr ""

#. 一緒に過ごす
msgctxt "0002 | CHOICE/RE:ACT"
msgid "Spend some time with Junko"
msgstr ""

#. 他の場所へ行く
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Go see who else is around"
msgstr ""

#. <CLT 4>どうしよう？
#. 江ノ島さんと一緒に過ごそうか？
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hmm... Should I hang out with Junko for a while?\n"
"<CLT>"
msgstr ""

#. もしかして…
#. あたしをデートに誘ってんの？
msgctxt "0005 | JUNKO ENOSHIMA (MUKURO)"
msgid "Oooh... Are you asking me out on a DATE!?"
msgstr ""

#. アハハッ、苗木ってかわいいじゃーん！
msgctxt "0006 | JUNKO ENOSHIMA (MUKURO)"
msgid "Ahaha! You're such a little cutie!"
msgstr ""

#. <CLT 4>江ノ島さんと一緒にデートした。
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I guess I went on a date with Junko...\n"
"<CLT>"
msgstr ""

#. <CLT 4>江ノ島さんと少し仲良くなれたみたいだ…
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Junko and I grew a little closer today.\n"
"<CLT>"
msgstr ""

#. 渡す
msgctxt "0009 | CHOICE/RE:ACT"
msgid "Yes, definitely"
msgstr ""

#. 渡さない
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Not really, no"
msgstr ""

#. <CLT 3>プレゼント<CLT><CLT 23>を渡しますか？<CLT>
msgctxt "0011 | NARRATION"
msgid "<CLT 3><CLT><CLT 23>Would you like to give Junko a<CLT> <CLT 3>present<CLT><CLT 23>?<CLT>"
msgstr ""
