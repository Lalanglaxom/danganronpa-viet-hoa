#. てゆーか、閉じ込められたとか、
#. マジでドン引きなんですけど…
msgctxt "0001 | JUNKO ENOSHIMA (MUKURO)"
msgid "Getting stuck in here is, like...totally disgusting."
msgstr ""

#. はぁーあ…
#. どうやったら、ここから出られんの？
msgctxt "0002 | JUNKO ENOSHIMA (MUKURO)"
msgid "*Siiiiigh* I wanna get outta here!"
msgstr ""

#. 一緒に過ごす
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Spend some time with Junko"
msgstr ""

#. 他の場所へ行く
msgctxt "0004 | CHOICE/RE:ACT"
msgid "Go see who else is around"
msgstr ""

#. <CLT 4>どうしよう？
#. 江ノ島さんと一緒に過ごそうか？
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hmm... Should I hang out with Junko for a while?\n"
"<CLT>"
msgstr ""

#. なーんか、出口探し回るのも、
#. ダルくなってきたし…
msgctxt "0006 | JUNKO ENOSHIMA (MUKURO)"
msgid "Looking around for a way out sucks. I'm so bored!"
msgstr ""

#. じゃあ、一緒にサボろっか？
msgctxt "0007 | JUNKO ENOSHIMA (MUKURO)"
msgid "C'mon, let's get outta here and have some fun!"
msgstr ""

#. <CLT 4>江ノ島さんと一緒に過ごした…
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I spent some time with Junko...\n"
"<CLT>"
msgstr ""

#. <CLT 4>江ノ島さんと少し仲良くなれたみたいだ…
#. <CLT>
msgctxt "0009 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Junko and I grew a little closer today.\n"
"<CLT>"
msgstr ""

#. 渡す
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Yes, definitely"
msgstr ""

#. 渡さない
msgctxt "0011 | CHOICE/RE:ACT"
msgid "Not really, no"
msgstr ""

#. <CLT 3>プレゼント<CLT><CLT 23>を渡しますか？<CLT>
msgctxt "0012 | NARRATION"
msgid "<CLT 3><CLT><CLT 23>Would you like to give Junko a<CLT> <CLT 3>present<CLT><CLT 23>?<CLT>"
msgstr ""
