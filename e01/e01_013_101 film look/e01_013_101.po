"<CLT>"

#. 苗木君！？
#. そこ, 女子トイレですよ？
msgctxt "0020 | SAYAKA MAIZONO"
msgid "Makoto! That's the girls bathroom...!"
msgstr "Makoto!? Đó là nhà vệ sinh nữ mà cậu!?"

#. あれ？
#. ま, 間違えたみたいだ.
msgctxt "0021 | MAKOTO NAEGI"
msgid "Huh? O-Oh yeah. Sorry, I got confused..."
msgstr "Ơ? À, ừ nhỉ. Có vẻ tớ nhầm lẫn chút, xin lỗi nhé..."

#. しっかりしてください.
msgctxt "0022 | SAYAKA MAIZONO"
msgid "Come on, we have to concentrate."
msgstr "Tỉnh táo lại đi nha."

#. <CLT 4>ここには, 入れないみたいだ…
#. <CLT>
msgctxt "0023 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Looks like I can't get in there...\n"
"<CLT>"
msgstr ""
"<CLT 4>Có vẻ không vào đây được...\n"
"<CLT>"

#. 苗木君.
#. ここでは, 映像は見られないと思います.
msgctxt "0024 | SAYAKA MAIZONO"
msgid "I don't think we can watch the video here..."
msgstr "Makoto này. Tớ nghĩ chúng ta không xem đoạn phim ở đây được đâu."

#. あ, あぁ, そうだね.
