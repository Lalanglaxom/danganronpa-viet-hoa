#. <CLT 4>このロッカーに、
#. ジャスティスロボが入ってたんだ…
#. <CLT>
msgctxt "0001 | MAKOTO NAEGI"
msgid ""
"<CLT 4>We found \"Robo Justice\" stuffed in this locker last\n"
"time.\n"
"<CLT>"
msgstr ""
"<CLT 4>Lần trước chúng ta đã tìm thấy \"Robo Công Lý\" bị nhét\n"
"trong tủ đồ này.\n"
"<CLT>"

#. はい
msgctxt "0002 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0003 | CHOICE/RE:ACT"
msgid "No"
msgstr ""

#. <CLT 23>室内プールから出ますか？
#. <CLT>
msgctxt "0004 | NARRATION"
msgid ""
"<CLT 23>Leave the pool?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi hồ bơi?\n"
"<CLT>"
