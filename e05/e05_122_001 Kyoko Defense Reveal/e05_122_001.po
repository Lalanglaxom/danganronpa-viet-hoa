#. 今の言葉は…
#. どういう意味だ…？
msgctxt "0001 | BYAKUYA TOGAMI"
msgid ""
"Those words you just spoke...\n"
"What do you mean?"
msgstr ""
"Những lời cô vừa nói...\n"
"Ý cô là gì?"

#. そのままの意味よ…
msgctxt "0002 | KYOUKO KIRIGIRI"
msgid "Exactly what I said."
msgstr "Đúng như những gì tôi đã nói."

#. 私が<CLT 9>犯人じゃない<CLT>
#. という事は…
msgctxt "0003 | KYOUKO KIRIGIRI"
msgid "I'm <CLT 9>not the killer<CLT>."
msgstr "Tôi <CLT 9>không phải hung thủ<CLT>."

#. あなたが１番
#. よく知っているはず…
msgctxt "0004 | KYOUKO KIRIGIRI"
msgid ""
"You should understand\n"
"that more than anyone here."
msgstr ""
"Cậu đáng lẽ phải hiểu điều đó\n"
"hơn bất kỳ ai ở đây."

#. 十神っち、
#. なんか隠してんのか！？
msgctxt "0005 | YASUHIRO HAGAKURE"
msgid ""
"Byakuya,\n"
"what are you hiding!?"
msgstr ""
"Byakuya,\n"
"cậu đang che giấu chuyện gì sao!?"

#. 白夜様が…あたしに
#. 隠し事する訳ないじゃない…！
msgctxt "0006 | TOUKO FUKAWA"
msgid ""
"Master would\n"
"n-never hide something from me!"
msgstr ""
"Ngài ấy sẽ k-không bao giờ\n"
"giấu chuyện gì với tôi đâu!"

#. 霧切…お前が
#. <CLT 9>犯人ではない根拠<CLT>が…
msgctxt "0007 | BYAKUYA TOGAMI"
msgid ""
"<CLT 9>There's proof<CLT> that\n"
"you aren't the culprit..."
msgstr ""
"<CLT 9>Có bằng chứng<CLT> rằng\n"
"cô không phải hung thủ..."

#. あるとでも言うのか…？
msgctxt "0008 | BYAKUYA TOGAMI"
msgid "Is that what you're saying?"
msgstr ""
"<CLT 4>Đó là những gì ngươi đang muốn nói sao?\n"
"<CLT>"

#. さっきの、
#. あなた達の推理だと…
msgctxt "0009 | KYOUKO KIRIGIRI"
msgid "You stated a theory earlier."
msgstr "Trước đó, các cậu đã đưa ra một giả thuyết."

#. 私は武道場のロッカーに
#. 証拠を隠し…
msgctxt "0010 | KYOUKO KIRIGIRI"
msgid ""
"You said I hid the evidence of\n"
"my crime in the dojo locker..."
msgstr ""
"Các cậu nói rằng tôi đã giấu bằng chứng\n"
"về tội ác của mình trong tủ khóa ở võ đường..."

#. その<CLT 9>鍵を自分の部屋に
#. 置いた<CLT>らしいわね？
msgctxt "0011 | KYOUKO KIRIGIRI"
msgid ""
"...and then left \n"
"<CLT 9>the locker key in my own room<CLT>.\n"
"Correct?"
msgstr ""
"...và sau đó để\n"
"<CLT 9>chìa khóa tủ khóa trong chính phòng của tôi<CLT>.\n"
"Đúng không?"

#. 本当に、私にそんな事が
#. 出来たのかしら？
msgctxt "0012 | KYOUKO KIRIGIRI"
msgid "But...could I really have done that?"
msgstr "Nhưng... tôi thật sự có thể làm chuyện đó sao?"

#. <CLT 26>犯人じゃないんか！？<CLT>
msgctxt "0013 | KYOUKO KIRIGIRI"
msgid "<CLT 26>She's not the killer!?<CLT>"
msgstr "<CLT 26>Cô ấy không phải hung thủ sao!?<CLT>"

#. <CLT 26>どういう事だ？<CLT>
msgctxt "0014 | KYOUKO KIRIGIRI"
msgid "<CLT 26>What does that mean?<CLT>"
msgstr "<CLT 26>Ý là sao?<CLT>"

#. <CLT 26>霧切ちゃん…ホント？<CLT>
msgctxt "0015 | KYOUKO KIRIGIRI"
msgid "<CLT 26>Is it really true?<CLT>"
msgstr "<CLT 26>Có thật vậy không?<CLT>"

#. <CLT 26>むしろ、本音を言わないべ…<CLT>
msgctxt "0016 | KYOUKO KIRIGIRI"
msgid "<CLT 26>Just tell us what's going on already...!<CLT>"
msgstr "<CLT 26>Nói cho chúng tôi biết chuyện gì đang xảy ra đi...!<CLT>"

#. <CLT 26>きっと根拠があるんだよ！<CLT>
msgctxt "0017 | KYOUKO KIRIGIRI"
msgid "<CLT 26>There's gotta be a reason!<CLT>"
msgstr "<CLT 26>Chắc chắn phải có lý do!<CLT>"

#. <CLT 26>それが…どうした…！？<CLT>
msgctxt "0018 | KYOUKO KIRIGIRI"
msgid "<CLT 26>What is it, then?<CLT>"
msgstr "<CLT 26>Vậy thì là gì?<CLT>"

#. <CLT 26>何を言ってるのよ？<CLT>
msgctxt "0019 | KYOUKO KIRIGIRI"
msgid "<CLT 26>What are you saying?<CLT>"
msgstr "<CLT 26>Cậu đang nói gì vậy?<CLT>"

#. <CLT 26>自分の部屋に…？<CLT>
msgctxt "0020 | KYOUKO KIRIGIRI"
msgid "<CLT 26>Your own room...?<CLT>"
msgstr "<CLT 26>Phòng của mình sao...?<CLT>"
