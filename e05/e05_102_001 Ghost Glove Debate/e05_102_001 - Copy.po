#. そこにいる霧切っちは
#. 幽霊なんだ！
msgctxt "0001 | YASUHIRO HAGAKURE"
msgid "That \"Kyoko\" there is just a ghost!"
msgstr ""

#. そ、そんな訳…
#. ないじゃない…
msgctxt "0002 | TOUKO FUKAWA"
msgid "I-Impossible..."
msgstr ""

#. なら、霧切っちが
#. 幽霊じゃねーって証明してみろ！
msgctxt "0003 | YASUHIRO HAGAKURE"
msgid ""
"Okay, then prove it!\n"
"Prove she's not a ghost!"
msgstr ""

#. あの死体って、
#. <CLT 9>手袋してなかった<CLT>よ！
msgctxt "0004 | AOI ASAHINA"
msgid "The dead body <CLT 9>wasn't wearing gloves<CLT>!"
msgstr ""

#. 爆発のせいで
#. 燃えただけだべ！
msgctxt "0005 | YASUHIRO HAGAKURE"
msgid "They got burnt up in the explosion!"
msgstr ""

#. じゃあ…爆発前は
#. 手袋をしてたの…？
msgctxt "0006 | TOUKO FUKAWA"
msgid ""
"Then...she was wearing gloves\n"
"before the explosion...?"
msgstr ""

#. きっと、<CLT 9>手袋はしてた<CLT>はずだべ！
msgctxt "0007 | YASUHIRO HAGAKURE"
msgid ""
"Well, yeah! She <CLT 9>must've\n"
"been wearing gloves<CLT>!"
msgstr ""

#. だって、死んだのは
#. 霧切っちなんだからな！
msgctxt "0008 | YASUHIRO HAGAKURE"
msgid "Cuz that corpse is absolutely Kyoko!"
msgstr ""

#. バカバカしい議論だ…
msgctxt "0009 | BYAKUYA TOGAMI"
msgid "This entire discussion is idiotic..."
msgstr ""

#. <CLT 26>いーや、違うべ！<CLT>
msgctxt "0010 | BYAKUYA TOGAMI"
msgid "<CLT 26>You're all wrong!<CLT>"
msgstr ""

#. <CLT 26>そ、そうよ…<CLT>
msgctxt "0011 | BYAKUYA TOGAMI"
msgid "<CLT 26>We're right...<CLT>"
msgstr ""

#. <CLT 26>私が幽霊？　面白いわね…<CLT>
msgctxt "0012 | BYAKUYA TOGAMI"
msgid "<CLT 26>I'm a ghost? Interesting...<CLT>"
msgstr ""

#. <CLT 26>それを証明しなさいよ！<CLT>
msgctxt "0013 | BYAKUYA TOGAMI"
msgid "<CLT 26>Prove it!<CLT>"
msgstr ""

#. <CLT 26>お前らいい加減にしろ…<CLT>
msgctxt "0014 | BYAKUYA TOGAMI"
msgid "<CLT 26>Just stop this nonsense...<CLT>"
msgstr ""
