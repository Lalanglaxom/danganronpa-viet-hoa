#. これは、グランドピアノか…
msgctxt "0001 | MAKOTO NAEGI"
msgid "Is this...a grand piano?"
msgstr "Đây là... một cây đại dương cầm sao?"

#. <CLT 4>きっといい音を奏でるに違いない…
#. でも、ボクの世代的には携帯プレイヤーで十分だ。
#. <CLT>
msgctxt "0002 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I'm sure it sounds nice, but most people these days\n"
"would rather just listen to music on their phones.\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình chắc là âm thanh của nó sẽ rất hay, nhưng hầu hết mọi người\n"
"bây giờ đều thích nghe nhạc trên điện thoại hơn.\n"
"<CLT>"

#. はい
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0004 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0005 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi đây?\n"
"<CLT>"
