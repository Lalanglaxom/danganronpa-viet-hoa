#. <CLT 4>ロッカーだ…
#. アルターエゴも…もういないんだ…
#. <CLT>
msgctxt "0001 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Alter Ego...isn't here anymore.\n"
"<CLT>"
msgstr ""
"<CLT 4>Alter Ego... không còn ở đây nữa rồi.\n"
"<CLT>"

#. <CLT 4>マッサージチェアがある…
#. <CLT>
msgctxt "0002 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The massage chair...\n"
"<CLT>"
msgstr ""
"<CLT 4>Chiếc ghế massage...\n"
"<CLT>"

#. <CLT 4>なんか罠があったら大変だ。
#. 使うのはやめておこう。
#. <CLT>
msgctxt "0003 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I'm gonna stay away, in case it's been booby-trapped\n"
"somehow...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình sẽ tránh xa nó ra, phòng trường hợp nó bị gài bẫy\n"
"theo cách nào đó...\n"
"<CLT>"

#. はい
msgctxt "0004 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0005 | CHOICE/RE:ACT"
msgid "No"
msgstr ""

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0006 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi đây?\n"
"<CLT>"
