#. やはり、恥ずかしい秘密とやらを
#. 告白し合っておくべきだったのか…！
msgctxt "0001 | KIYOTAKA ISHIMARU"
msgid ""
"Maybe we should have confessed our embarrassing\n"
"secrets after all...!"
msgstr ""
"Chúng ta đáng lẽ nên tiết lộ mấy cái bí mật đáng\n"
"xấu hổ cho rồi...!"

#. ……………
#. くうっ！
#. すまん、不二咲くん…僕の力不足だッ！！
msgctxt "0002 | KIYOTAKA ISHIMARU"
msgid ""
"Dammit! I'm sorry, Chihiro... It's all because I\n"
"wasn't strong enough!"
msgstr ""
"Chết tiệt! Xin lỗi, Chihiro... Tất cả là vì tớ không\n"
"đủ mạnh mẽ!"

#. ……………
msgctxt "0003 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I really don't wanna go in... I don't wanna see this\n"
"place ever again...!\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình thực sự không muốn vào đó... Mình không muốn nhìn thấy nơi\n"
"này thêm một lần nào nữa...!\n"
"<CLT>"

msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 23>*Rattle rattle*\n"
"<CLT>"
msgstr ""
"<CLT 23>“Lạch cạch lạch cạch!”\n"
"<CLT>"

msgctxt "0006 | MAKOTO NAEGI"
msgid "The door won't budge. It must be locked."
msgstr "Không mở được... Hình như bị khóa rồi."

msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is the girls bathroom.\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là nhà vệ sinh nữ.\n"
"<CLT>"

msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Obviously I can't go in...\n"
"<CLT>"
msgstr ""
"<CLT 4>Tất nhiên là mình không thể vào rồi...\n"
"<CLT>"
