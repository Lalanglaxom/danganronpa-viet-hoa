#. はぁ～あ…
msgctxt "0001 | CHIHIRO FUJISAKI"
msgid "*Sigh*"
msgstr "*Phù~*"

#. ………………
msgctxt "0002 | CHIHIRO FUJISAKI"
msgid "..."
msgstr "..."

#. あ、苗木君…
#. いつから、そこにいたの…？
msgctxt "0003 | CHIHIRO FUJISAKI"
msgid "Oh, Makoto. I didn't realize you were there..."
msgstr "A, Makoto... Cậu đứng đó từ khi nào vậy...?"

#. 一緒に過ごす
msgctxt "0004 | CHOICE/RE:ACT"
msgid "Spend some time with Chihiro"
msgstr "Dành thời gian với Chihiro"

#. 他の場所へ行く
msgctxt "0005 | CHOICE/RE:ACT"
msgid "Go see who else is around"
msgstr "Đi xem còn ai khác quanh đây"

#. <CLT 4>…どうしよう？
#. 不二咲さんを励まそうか？
#. <CLT>
msgctxt "0006 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hmm... Should I try to cheer up Chihiro...?\n"
"<CLT>"
msgstr ""
"<CLT 4>...Nên làm gì đây? Có nên thử khích lệ Chihiro không nhỉ?\n"
"<CLT>"

#. うん、そうだね…
#. 気分転換した方がいいよね…
msgctxt "0007 | CHIHIRO FUJISAKI"
msgid "Yeah, I could use a little change of scenery..."
msgstr ""
"Ừm, đúng vậy nhỉ... Tớ cũng nên thay đổi không khí một chút cho\n"
"khuây khỏa..."

#. じゃあ、いいかな？
#. 苗木君と一緒にいても…
msgctxt "0008 | CHIHIRO FUJISAKI"
msgid "Do you mind keeping me company for a while..."
msgstr "Vậy thì, tớ ở bên cạnh Makoto một lát có được không...?"

#. <CLT 4>不二咲さんと一緒に、
#. のんびりとした時間を過ごした。
#. <CLT>
msgctxt "0009 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I spent a nice, relaxing time with Chihiro...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình đã dành một khoảng thời gian thư thả bên cạnh Chihiro...\n"
"<CLT>"

#. <CLT 4>不二咲さんと少し仲良くなれたみたいだ…
#. <CLT>
msgctxt "0010 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Chihiro and I grew a little closer today.\n"
"<CLT>"
msgstr ""
"<CLT 4>Dường như hôm nay mình và Chihiro đã trở nên thân thiết hơn một\n"
"chút...\n"
"<CLT>"

#. 渡す
msgctxt "0011 | CHOICE/RE:ACT"
msgid "Yes, definitely"
msgstr "Có, chắc chắn rồi"

#. 渡さない
msgctxt "0012 | CHOICE/RE:ACT"
msgid "Not really, no"
msgstr "Không hẳn"

#. <CLT 3>プレゼント<CLT><CLT 23>を渡しますか？<CLT>
msgctxt "0013 | NARRATION"
msgid "<CLT 3><CLT><CLT 23>Would you like to give Chihiro a<CLT> <CLT 3>present<CLT><CLT 23>?<CLT>"
msgstr "<CLT 23>Bạn có muốn tặng <CLT><CLT 3>quà<CLT><CLT 23> cho Chihiro không?<CLT>"
