#. 苗木君、１人でお散歩ですか？
msgctxt "0001 | SAYAKA MAIZONO"
msgid "Out for a walk, Makoto?"
msgstr "Makoto đang đi dạo một mình đó sao?"

#. だったら、私も誘ってくださいよ。
#. うふふ…
msgctxt "0002 | SAYAKA MAIZONO"
msgid "I wouldn't mind if you invited me along. Hmhm..."
msgstr "Nếu vậy thì, hãy rủ tớ đi cùng với nhé. Hmhm..."

#. 一緒に過ごす
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Spend some time with Sayaka"
msgstr "Dành thời gian bên Sayaka"

#. 他の場所へ行く
msgctxt "0004 | CHOICE/RE:ACT"
msgid "Go see who else is around"
msgstr "Đi xem còn ai khác quanh đây"

#. <CLT 4>…どうしよう？
#. 舞園さんを誘ってみようか？
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hmm... Should I talk to Sayaka for a while?\n"
"<CLT>"
msgstr ""
"<CLT 4>Nên làm gì đây? Có nên rủ Sayaka nói chuyện một \n"
"lát không nhỉ?\n"
"<CLT>"

#. じゃあ、一緒にお散歩しましょうか。
#. 気分転換になりますもんね！
msgctxt "0006 | SAYAKA MAIZONO"
msgid ""
"Okay, let's go for a walk! I think it'll help cheer\n"
"both of us up!"
msgstr ""
"Vậy thì, chúng ta cùng đi dạo nhé. Chắc chắn sẽ giúp tâm \n"
"trạng khá hơn đấy!"

#. <CLT 4>舞園さんと一緒に散歩を楽しんだ。
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I enjoyed a long, leisurely walk with Sayaka...\n"
"<CLT>"
msgstr ""
"<CLT 4>Tôi đã có một buổi đi dạo thật vui vẻ bên Sayaka...\n"
"<CLT>"

#. <CLT 4>舞園さんと少し仲良くなれたみたいだ…
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Sayaka and I grew a little closer today.\n"
"<CLT>"
msgstr ""
"<CLT 4>Dường như tôi và Sayaka đã trở nên thân thiết hơn \n"
"một chút...\n"
"<CLT>"

#. 渡す
msgctxt "0009 | CHOICE/RE:ACT"
msgid "Yes, definitely"
msgstr "Có, chắc chắn rồi"

#. 渡さない
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Not really, no"
msgstr "Không hẳn"

#. <CLT 3>プレゼント<CLT><CLT 23>を渡しますか？<CLT>
msgctxt "0011 | NARRATION"
msgid "<CLT 3><CLT><CLT 23>Would you like to give Sayaka a<CLT> <CLT 3>present<CLT><CLT 23>?<CLT>"
msgstr "<CLT 23>Bạn có muốn tặng <CLT><CLT 3>quà<CLT><CLT 23> cho Sayaka không?<CLT>"
