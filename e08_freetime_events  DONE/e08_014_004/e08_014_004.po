#. 苗木君だ。こんにちは。
msgctxt "0001 | CHIHIRO FUJISAKI"
msgid "Hello there, Makoto."
msgstr "Chào cậu, Makoto."

#. えへへ、奇遇だね…
msgctxt "0002 | CHIHIRO FUJISAKI"
msgid "Ehehe...how nice to see you here."
msgstr "Hì hì, đúng là ngộ thật đó..."

#. 一緒に過ごす
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Spend some time with Chihiro"
msgstr "Dành thời gian với Chihiro"

#. 他の場所へ行く
msgctxt "0004 | CHOICE/RE:ACT"
msgid "Go see who else is around"
msgstr "Đi xem còn ai khác quanh đây"

#. <CLT 4>…どうしよう？
#. 不二咲さんと一緒に過ごそうか？
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hmm... Should I hang out with Chihiro for a while?\n"
"<CLT>"
msgstr ""
"<CLT 4>...Nên làm gì đây? Có nên dành thời gian với Chihiro một lát\n"
"không nhỉ?\n"
"<CLT>"

#. えへへ！　やった！
#. 苗木君とお話するの好きなんだ！
msgctxt "0006 | CHIHIRO FUJISAKI"
msgid "Eheh...yay! I really like talking to you."
msgstr "Hì hì! Tuyệt quá! Tớ thích được nói chuyện với Makoto lắm!"

#. <CLT 4>不二咲さんと一緒に、
#. お話をして過ごした…
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I spent some time talking with Chihiro...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình đã dành thời gian để trò chuyện cùng với Chihiro...\n"
"<CLT>"

#. <CLT 4>不二咲さんと少し仲良くなれたみたいだ…
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Chihiro and I grew a little closer today.\n"
"<CLT>"
msgstr ""
"<CLT 4>Dường như hôm nay mình và Chihiro đã trở nên thân thiết hơn một\n"
"chút...\n"
"<CLT>"

#. 渡す
msgctxt "0009 | CHOICE/RE:ACT"
msgid "Yes, definitely"
msgstr "Có, chắc chắn rồi"

#. 渡さない
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Not really, no"
msgstr "Không hẳn"

#. <CLT 3>プレゼント<CLT><CLT 23>を渡しますか？<CLT>
msgctxt "0011 | NARRATION"
msgid "<CLT 3><CLT><CLT 23>Would you like to give Chihiro a<CLT> <CLT 3>present<CLT><CLT 23>?<CLT>"
msgstr "<CLT 23>Bạn có muốn tặng <CLT><CLT 3>quà<CLT><CLT 23> cho Chihiro không?<CLT>"
