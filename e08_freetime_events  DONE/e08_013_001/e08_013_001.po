#. てゆーか、閉じ込められたとか、
#. マジでドン引きなんですけど…
msgctxt "0001 | JUNKO ENOSHIMA (MUKURO)"
msgid "Getting stuck in here is, like...totally disgusting."
msgstr ""
"Mà nói thiệt nha, cái vụ bị nhốt ở đây làm tớ thấy tụt mood \n"
"kinh khủng luôn á..."

#. はぁーあ…
#. どうやったら、ここから出られんの？
msgctxt "0002 | JUNKO ENOSHIMA (MUKURO)"
msgid "*Siiiiigh* I wanna get outta here!"
msgstr "*Haizz*... làm sao để biến khỏi đây bây giờ trời?"

#. 一緒 ở 過ごす
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Spend some time with Junko"
msgstr "Dành thời gian với Junko"

#. 他の場所へ行く
msgctxt "0004 | CHOICE/RE:ACT"
msgid "Go see who else is around"
msgstr "Đi xem còn ai khác quanh đây"

#. <CLT 4>どうしよう？
#. 江ノ島さんと一緒に過ごそうか？
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hmm... Should I hang out with Junko for a while?\n"
"<CLT>"
msgstr ""
"<CLT 4>Nên làm gì đây? Hay là dành thời gian với Junko một lát nhỉ?\n"
"<CLT>"

#. なーんか、出口探し回るのも、
#. ダルくなってきたし…
msgctxt "0006 | JUNKO ENOSHIMA (MUKURO)"
msgid "Looking around for a way out sucks. I'm so bored!"
msgstr ""
"Đi lòng vòng tìm lối ra nản quá hà, chán \n"
"chết đi được!"

#. じゃあ、一緒にサボろっか？
msgctxt "0007 | JUNKO ENOSHIMA (MUKURO)"
msgid "C'mon, let's get outta here and have some fun!"
msgstr "Vậy tụi mình cùng trốn đi chơi xíu không?"

#. <CLT 4>江ノ島さんと一緒に過ごした…
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I spent some time with Junko...\n"
"<CLT>"
msgstr ""
"<CLT 4>Tôi đã dành một khoảng thời gian bên cạnh Junko...\n"
"<CLT>"

#. <CLT 4>江ノ島さんと少し仲良くなれたみたいだ…
#. <CLT>
msgctxt "0009 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Junko and I grew a little closer today.\n"
"<CLT>"
msgstr ""
"<CLT 4>Dường như hôm nay tôi và Junko đã trở nên thân \n"
"thiết hơn một chút...\n"
"<CLT>"

#. 渡す
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Yes, definitely"
msgstr "Có, chắc chắn rồi"

#. 渡さない
msgctxt "0011 | CHOICE/RE:ACT"
msgid "Not really, no"
msgstr "Không hẳn"

#. <CLT 3>プレゼント<CLT><CLT 23>を渡しますか？<CLT>
msgctxt "0012 | NARRATION"
msgid "<CLT 3><CLT><CLT 23>Would you like to give Junko a<CLT> <CLT 3>present<CLT><CLT 23>?<CLT>"
msgstr "<CLT 23>Bạn có muốn tặng <CLT><CLT 3>quà<CLT><CLT 23> cho Junko không?<CLT>"
