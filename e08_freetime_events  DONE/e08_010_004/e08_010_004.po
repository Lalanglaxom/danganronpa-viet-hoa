#. 放って置いてよ…
#. あ、あたしに…あまり構わないで…
msgctxt "0001 | TOUKO FUKAWA"
msgid ""
"Leave me alone. You d-don't have to pay attention to\n"
"me..."
msgstr ""
"Cứ mặc kệ tôi đi... Đ-Đừng có để tâm đến tôi quá \n"
"mức làm gì..."

#. 一緒に過ごす
msgctxt "0002 | CHOICE/RE:ACT"
msgid "Spend some time with Toko"
msgstr "Dành thời gian với Toko"

#. 他の場所へ行く
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Go see who else is around"
msgstr "Đi xem còn ai khác quanh đây"

#. <CLT 4>どうしよう？
#. 腐川さんと一緒に過ごそうか？
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hmm... Should I hang out with Toko for a while?\n"
"<CLT>"
msgstr ""
"<CLT 4>Hmm... Có nên dành thời gian với Toko không nhỉ?\n"
"<CLT>"

#. ふ、ふん…
msgctxt "0005 | TOUKO FUKAWA"
msgid "H-Hmph."
msgstr "H-Hừm."

#. 好きに…すれば…？
msgctxt "0006 | TOUKO FUKAWA"
msgid "Just d-do whatever you want."
msgstr "Cậu thích làm gì... thì tùy cậu..."

#. <CLT 4>腐川さんと一緒に過ごした…
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I spent some time with Toko...\n"
"<CLT>"
msgstr ""
"<CLT 4>Tôi đã dành một khoảng thời gian ở bên cạnh Toko...\n"
"<CLT>"

#. <CLT 4>腐川さんと少し仲良くなれたみたいだ…
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Toko and I grew a little closer today.\n"
"<CLT>"
msgstr ""
"<CLT 4>Dường như hôm nay tôi và Toko đã trở nên thân thiết \n"
"hơn một chút...\n"
"<CLT>"

#. 渡す
msgctxt "0009 | CHOICE/RE:ACT"
msgid "Yes, definitely"
msgstr "Có, chắc chắn rồi"

#. 渡さない
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Not really, no"
msgstr "Không hẳn"

#. <CLT 3>プレゼント<CLT><CLT 23>を渡しますか？<CLT>
msgctxt "0011 | NARRATION"
msgid "<CLT 3><CLT><CLT 23>Would you like to give Toko a<CLT> <CLT 3>present<CLT><CLT 23>?<CLT>"
msgstr "<CLT 23>Bạn có muốn tặng <CLT><CLT 3>quà<CLT><CLT 23> cho Toko không?<CLT>"
