#. 誰かを殺さなければ、
#. この閉鎖された学園から出る事は出来ない…
msgctxt "0001 | BYAKUYA TOGAMI"
msgid "So the only way to get out of here is to kill someone."
msgstr "Vậy ra cách duy nhất để thoát khỏi đây là phải giết một ai đó."

#. なるほどな…
msgctxt "0002 | BYAKUYA TOGAMI"
msgid "Interesting..."
msgstr "Thú vị đấy..."

#. 一緒に過ごす
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Spend some time with Byakuya"
msgstr "Dành thời gian với Byakuya"

#. 他の場所へ行く
msgctxt "0004 | CHOICE/RE:ACT"
msgid "Go see who else is around"
msgstr "Xem thử còn ai ở quanh đây không"

#. <CLT 4>…どうしよう？
#. 十神クンと一緒に過ごそうか？
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hmm... Should I hang out with Byakuya for a while?\n"
"<CLT>"
msgstr ""
"<CLT 4>Hừm... Mình có nên ở bên cạnh Byakuya một lát\n"
"không nhỉ?\n"
"<CLT>"

#. ………………
msgctxt "0006 | BYAKUYA TOGAMI"
msgid "..."
msgstr "..."

#. ………………
msgctxt "0007 | BYAKUYA TOGAMI"
msgid "..."
msgstr "..."

#. <CLT 4>無言の十神クンと一緒に過ごした。
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I spent some time with Byakuya in silence...\n"
"<CLT>"
msgstr ""
"<CLT 4>Tôi đã ở cạnh Byakuya trong sự im lặng bao trùm...\n"
"<CLT>"

#. <CLT 4>十神クンと少し仲良くなれたみたいだ…
#. <CLT>
msgctxt "0009 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Byakuya and I grew a little closer today.\n"
"<CLT>"
msgstr ""
"<CLT 4>Có vẻ như hôm nay tôi và Byakuya đã thân thiết \n"
"hơn một chút...\n"
"<CLT>"

#. 渡す
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Yes, definitely"
msgstr "Có, chắc chắn rồi"

#. 渡さない
msgctxt "0011 | CHOICE/RE:ACT"
msgid "Not really, no"
msgstr "Không, không hẳn"

#. <CLT 3>プレゼント<CLT><CLT 23>を渡しますか？<CLT>
msgctxt "0012 | NARRATION"
msgid "<CLT 3><CLT><CLT 23>Would you like to give Byakuya a<CLT> <CLT 3>present<CLT><CLT 23>?<CLT>"
msgstr "<CLT 23>Bạn có muốn tặng <CLT><CLT 3>quà<CLT><CLT 23> cho Byakuya không?<CLT>"
