#. あら、苗木君.
#. ご機嫌いかがですか？
msgctxt "0001 | CELES"
msgid "Ah, Makoto. How are you?"
msgstr "Ô kìa, Makoto. Cậu vẫn khỏe chứ?"

#. 一緒に過ごす
msgctxt "0002 | CHOICE/RE:ACT"
msgid "Spend some time with Celeste"
msgstr "Dành thời gian với Celeste"

#. 他の場所へ行く
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Go see who else is around"
msgstr "Đi xem còn ai khác quanh đây"

#. <CLT 4>どうしよう？
#. セレスさんと一緒に過ごそうか？
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hmm... Should I hang out with Celeste for a while?\n"
"<CLT>"
msgstr ""
"<CLT 4>Nên làm gì đây? Có nên dành thời gian với Celeste \n"
"không nhỉ?\n"
"<CLT>"

#. では、わたくしとギャンブルでもしますか？
msgctxt "0005 | CELES"
msgid "Would you like to play a game of chance with me?"
msgstr "Vậy thì, cậu có muốn thử vận may một ván với tôi không?"

#. うふふ、絞りとって差し上げますわよ.
msgctxt "0006 | CELES"
msgid ""
"I would be happy to empty your wallet and show it to\n"
"you."
msgstr ""
"Ư fư fư... tôi sẽ lột sạch sành sanh túi tiền của \n"
"cậu cho mà xem."

#. <CLT 4>セレスさんから容赦なく絞り取られた…
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Celeste gave me the business...\n"
"<CLT>"
msgstr ""
"<CLT 4>Tôi đã bị Celeste lột sạch túi tiền không chút nương tay...\n"
"<CLT>"

#. <CLT 4>セレスさんと少し仲良くなれたみたいだ…
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Celeste and I grew a little closer today.\n"
"<CLT>"
msgstr ""
"<CLT 4>Dường như hôm nay tôi và Celeste đã trở nên thân \n"
"thiết hơn một chút...\n"
"<CLT>"

#. 渡す
msgctxt "0009 | CHOICE/RE:ACT"
msgid "Yes, definitely"
msgstr "Có, chắc chắn rồi"

#. 渡さない
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Not really, no"
msgstr "Không hẳn"

#. <CLT 3>プレゼント<CLT><CLT 23>を渡しますか？<CLT>
msgctxt "0011 | NARRATION"
msgid "<CLT 3><CLT><CLT 23>Would you like to give Celeste a<CLT> <CLT 3>present<CLT><CLT 23>?<CLT>"
msgstr "<CLT 23>Bạn có muốn tặng <CLT><CLT 3>quà<CLT><CLT 23> cho Celeste không?<CLT>"
