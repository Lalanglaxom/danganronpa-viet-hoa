# #. ………………
msgctxt "0001 | TOUKO FUKAWA"
msgid "..."
msgstr "..."

#. ………………
msgctxt "0002 | TOUKO FUKAWA"
msgid "..."
msgstr "..."

#. <CLT 4>腐川さん、ずっとボクの前に立ってるけど、
#. 何か用なのかな…？
#. <CLT>
msgctxt "0003 | MAKOTO NAEGI"
msgid ""
"<CLT 4>She's just standing there. Does she want something...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Toko cứ đứng đó suốt, cậu ấy có việc gì không \n"
"nhỉ...?\n"
"<CLT>"

#. ………………
msgctxt "0004 | TOUKO FUKAWA"
msgid "..."
msgstr "..."

#. <CLT 4>でも、何も喋らないし…
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>But she's not saying anything...\n"
"<CLT>"
msgstr ""
"<CLT 4>Nhưng cậu ấy chẳng chịu nói năng gì cả...\n"
"<CLT>"

#. ………………
msgctxt "0006 | TOUKO FUKAWA"
msgid "..."
msgstr "..."

#. <CLT 4>むしろ、こっちから、
#. 話題を振ってあげた方がいいのかな？
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Maybe I should try to start a conversation...\n"
"<CLT>"
msgstr ""
"<CLT 4>Hay là mình nên chủ động gợi chuyện trước nhỉ?\n"
"<CLT>"

#. あ、あのさ…腐川さん…？
msgctxt "0008 | MAKOTO NAEGI"
msgid "U-Um, Toko...?"
msgstr "À, này... Toko ơi...?"

#. 何よ？　あたしと話したいの？
#. し、仕方ないわね…！　話しなさいよ！
msgctxt "0009 | TOUKO FUKAWA"
msgid ""
"What? You wanna t-talk to me? Well, I can't stop\n"
"y-you. So talk already!"
msgstr ""
"Gì hả? Cậu muốn n-nói chuyện với tôi à? Đ-Đành chịu thôi...! \n"
"Có gì thì nói đi!"

#. <CLT 4>でも、話題を振るって言っても…
#. えーっと…
#. <CLT>
msgctxt "0010 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Okay, sure, but...what should I say?\n"
"<CLT>"
msgstr ""
"<CLT 4>Nhưng biết nói gì bây giờ nhỉ... Ừm...\n"
"<CLT>"

#. …あのさ、腐川さんってさ、
#. 普段は何をしてるの？
msgctxt "0011 | MAKOTO NAEGI"
msgid "So, uh, what do you like to do in your spare time?"
msgstr "...Này Toko, bình thường cậu hay làm gì thế?"

#. な、なんで…そんな事聞くの…？
msgctxt "0012 | TOUKO FUKAWA"
msgid "Why do you w-wanna know...?"
msgstr "T-Tại sao... cậu lại hỏi chuyện đó...?"

#. いや…なんでって言うか…
msgctxt "0013 | MAKOTO NAEGI"
msgid "Well, I mean, you know..."
msgstr "À thì... cũng không hẳn là tại sao..."

#. 一緒に閉じ込められた<CLT 3>“仲間”<CLT>だし、
#. お互いの事を色々と知っておいた方がいいかなって…
msgctxt "0014 | MAKOTO NAEGI"
msgid ""
"We're trapped here together, right? If we're gonna be\n"
"<CLT 3>friends<CLT>, it'd be nice to get to know each other."
msgstr ""
"Dù sao tụi mình cũng là <CLT 3>“đồng đội”<CLT> đang bị\n"
"nhốt ở \n"
"đây mà, tớ nghĩ tụi mình nên hiểu về nhau một chút..."

#. …え？　なんて言った？
msgctxt "0015 | TOUKO FUKAWA"
msgid "Huh? What'd you just s-say?"
msgstr "...Hả? Cậu vừa nói cái gì cơ?"

#. は…？
msgctxt "0016 | MAKOTO NAEGI"
msgid "Um..."
msgstr "Um..."

#. 一緒に閉じ込められた…なんて言った？
msgctxt "0017 | TOUKO FUKAWA"
msgid ""
"After that p-part about being trapped...\n"
"We're gonna be wh-what?"
msgstr "Cái câu sau đoạn bị nhốt ấy... Cậu bảo tụi mình là cái g-gì?"

#. 仲間…
msgctxt "0018 | MAKOTO NAEGI"
msgid "Uh...friends?"
msgstr "Đồng đội…?"

#. うふ…うふふふ…
msgctxt "0019 | TOUKO FUKAWA"
msgid "Hmmmeeheheheeh..."
msgstr "Ư hư... ư hì hì hì..."

#. な、何が仲間よ…そんな言葉で騙そうたって…
#. そうはいかないわよ…！
msgctxt "0020 | TOUKO FUKAWA"
msgid ""
"Whaddya mean, f-friends!? You think I'm s-stupid?\n"
"You're trying to trick me!"
msgstr ""
"Đ-Đồng đội cái nỗi gì... đừng có hòng dùng mấy lời đó để l-\n"
"lừa tôi... Không có chuyện đó đâu...!"

#. 前に…それで痛い目に遭った事だってあるのよ…
#. だ、だから…もう騙されないわよ…！
msgctxt "0021 | TOUKO FUKAWA"
msgid ""
"I've already been h-hurt once before... I'm not gonna\n"
"l-let it happen again...!"
msgstr ""
"T-Trước đây... tôi cũng từng nếm trái đắng vì mấy lời đó rồi... \n"
"N-Nên là... tôi không mắc lừa nữa đâu...!"

#. <CLT 4>それで痛い目って…何があったんだ？
#. <CLT>
msgctxt "0022 | MAKOTO NAEGI"
msgid ""
"<CLT 4>You've been hurt? What happened...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Nếm trái đắng sao... chuyện gì đã xảy ra với cậu ấy vậy?\n"
"<CLT>"

#. そ、そもそも…あたしの事を知りたいなんて…
#. 口から出まかせでしょ？
msgctxt "0023 | TOUKO FUKAWA"
msgid "Come on, y-you don't really care about m-me..."
msgstr ""
"V-Với lại... cái chuyện muốn tìm hiểu về tôi... chỉ là lời đ-đãi \n"
"bôi thôi đúng không?"

#. ど、どうせ、あたしになんか興味ないのよ！
#. それくらい…わ、わかってるわよ！！
msgctxt "0024 | TOUKO FUKAWA"
msgid ""
"You don't want to kn-know about me! Even I know\n"
"that...!"
msgstr ""
"Đ-Đằng nào thì cậu cũng chẳng hứng thú gì với cái hạng \n"
"như tôi đâu! Chuyện đó... t-tôi thừa biết!!"

#. い、いや…そんな事は…
msgctxt "0025 | MAKOTO NAEGI"
msgid "N-No, that's not true...!"
msgstr "Kh-Không... không phải như vậy đâu...!"

#. だ、だったら答えてみなさいよ…
msgctxt "0026 | TOUKO FUKAWA"
msgid "Fine. Then t-tell me..."
msgstr "V-Vậy thì cậu thử trả lời xem..."

#. …何を？
msgctxt "0027 | MAKOTO NAEGI"
msgid "Tell you what?"
msgstr "...Trả lời cái gì?"

#. あ、あたしが<CLT 3>“超高校級の文学少女”<CLT>って事は…
#. さすがに…知ってるわよね…？
msgctxt "0028 | TOUKO FUKAWA"
msgid ""
"You know why they c-call me the <CLT 3>Ultimate Writing\n"
"Prodigy<CLT>, right?"
msgstr ""
"Việc tôi là <CLT 3>“Siêu Học Sinh Thần Đồng Văn học”<CLT>... \n"
"chắc là cậu... cũng biết rồi đúng không...?"

#. うん、もちろん…
#. 文学賞だって、たくさん受賞してるって…
msgctxt "0029 | MAKOTO NAEGI"
msgid ""
"Yeah, sure. You've won all kinds of literature prizes\n"
"and stuff."
msgstr ""
"Ừ, dĩ nhiên rồi... tôi biết cậu từng đạt rất nhiều giải thưởng \n"
"văn học mà..."

#. あたしが得意とする<CLT 3>小説のジャンル<CLT>…
#. それを答えてみなさいよ…！
msgctxt "0030 | TOUKO FUKAWA"
msgid ""
"Then tell me wh-what I'm good at... Tell m-me what my\n"
"<CLT 3>genre specialty<CLT> is!"
msgstr ""
"Vậy hãy thử nêu tên <CLT 3>thể loại tiểu thuyết<CLT> sở \n"
"trường của tôi xem...!"

#. あ, あたしに興味あるって言うなら…
#. 答えられるはずよ！
msgctxt "0031 | TOUKO FUKAWA"
msgid ""
"If you r-really wanna convince me you give a crap, you\n"
"should at least kn-know that...!"
msgstr ""
"N-Nếu thực sự có hứng thú với tôi... thì chắc chắn cậu phải \n"
"trả lời được chứ!"

#. 恋愛小説
msgctxt "0032 | CHOICE/RE:ACT"
msgid "Romance"
msgstr "Tiểu thuyết tình cảm"

#. ノンフィクション
msgctxt "0033 | CHOICE/RE:ACT"
msgid "Non-fiction"
msgstr "Phi hư cấu"

#. <CLT 4>ノンフィクション…だったっけ…？
#. <CLT>
msgctxt "0034 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It's non-fiction, right?\n"
"<CLT>"
msgstr ""
"<CLT 4>Phi hư cấu... phải không nhỉ?\n"
"<CLT>"

#. <CLT 4>いや、違うな。
#. “超高校級の文学少女”って言うくらいだし…
#. <CLT>
msgctxt "0035 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Wait, that can't be right. I don't think you need to\n"
"be a \"writing prodigy\" for that kinda thing.\n"
"<CLT>"
msgstr ""
"<CLT 4>Không, không phải rồi. Đã được gọi là “Siêu Học Sinh Văn học” thì...\n"
"<CLT>"

#. なに？
#. ほら、早く言ってみなさいよ…！
msgctxt "0036 | TOUKO FUKAWA"
msgid "C'mon, if you r-really know, hurry up and say it...!"
msgstr "Gì đây? N-Nào, mau nói thử xem xem...!"

#. ええっと…
msgctxt "0037 | MAKOTO NAEGI"
msgid "Umm..."
msgstr "Ờ thì..."

#. ライトノベル
msgctxt "0038 | CHOICE/RE:ACT"
msgid "Young adult"
msgstr "Light novel"

#. <CLT 4>ライトノベル…
#. <CLT>
msgctxt "0039 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Young adult?\n"
"<CLT>"
msgstr ""
"<CLT 4>Light novel...\n"
"<CLT>"

#. <CLT 4>ではなかったよな。
#. <CLT>
msgctxt "0040 | MAKOTO NAEGI"
msgid ""
"<CLT 4>No, that's not it...\n"
"<CLT>"
msgstr ""
"<CLT 4>Chắc cũng không phải rồi.\n"
"<CLT>"

#. …ちょっと。
#. 今…ロクでもない事を考えてなかった…？
msgctxt "0041 | TOUKO FUKAWA"
msgid ""
"H-Hey...! Were you just thinking some w-worthless\n"
"thought?"
msgstr ""
"...N-Này. Vừa rồi... cậu đang nghĩ mấy thứ v-vớ vẩn đúng \n"
"không...?"

#. えっ…
msgctxt "0042 | MAKOTO NAEGI"
msgid "Huh?"
msgstr "Ơ...?"

#. い、いつまで待たせるのよ…
#. さっさと答えなさい…！
msgctxt "0043 | TOUKO FUKAWA"
msgid ""
"How long are you gonna m-make me wait? Answer\n"
"already...!"
msgstr "Đ-Định bắt tôi đợi đến bao giờ hả... Mau trả lời đi...!"

#. ほ…ほら見なさい…
#. 答えられないじゃない…！
msgctxt "0044 | TOUKO FUKAWA"
msgid "S-See? You don't know!"
msgstr "Th-Thấy chưa... cậu có trả lời được đâu...!"

#. やっぱり、あたしになんか興味ないんでしょ！？
msgctxt "0045 | TOUKO FUKAWA"
msgid "You don't care about me at a-all!"
msgstr "Quả nhiên là cậu chẳng hề h-hứng thú gì với tôi hết!"

#. そんなことないよ！
#. ちゃんと答えられるってば！
msgctxt "0046 | MAKOTO NAEGI"
msgid "That's not true! I do know the answer!"
msgstr "Không phải đâu! Tôi trả lời được mà!"

#. <CLT 4>“超高校級の文学少女”腐川さんが得意とする
#. 小説のジャンルは…
#. <CLT>
msgctxt "0047 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The genre that the Ultimate Writing Prodigy\n"
"specializes in...\n"
"<CLT>"
msgstr ""
"<CLT 4>Thể loại tiểu thuyết sở trường của “Siêu Học Sinh \n"
"Văn học” Toko là...\n"
"<CLT>"

#. 恋愛小説…だよね？
msgctxt "0048 | MAKOTO NAEGI"
msgid "It's romance, of course."
msgstr "Tiểu thuyết tình cảm... đúng không?"

#. あ, あら…答えられた…？
msgctxt "0049 | TOUKO FUKAWA"
msgid "Oh...you a-actually knew?"
msgstr "Ơ... c-cậu trả lời được thật à...?"

#. 『磯の香りの消えぬ間に』は、
#. 腐川さんの代表作ともいえる恋愛小説で…
msgctxt "0050 | MAKOTO NAEGI"
msgid ""
"Your biggest success was \"So Lingers the Ocean,\"\n"
"right? Everyone says it's your masterpiece."
msgstr ""
"Tác phẩm 『Trước khi hương biển tan biến』 là tiểu thuyết \n"
"tình cảm tiêu biểu của cậu, và..."

#. 影響を受けた若い女性の間で漁師が大人気になるなど、
#. 社会現象を生み出す大ヒットとなった…でしょ？
msgctxt "0051 | MAKOTO NAEGI"
msgid ""
"The book was such a hit that fishermen shot to\n"
"the top of all the \"Hottest Men\" polls...right?"
msgstr ""
"Nó đã tạo nên một cú hích lớn, thành hiện tượng đến mức \n"
"nghề ngư dân cực kỳ được phái nữ ưa chuộng... phải không?"

#. ど, どうして覚えていられるの？
msgctxt "0052 | TOUKO FUKAWA"
msgid "How did y-you know all that...?"
msgstr "S-Sao cậu lại có thể nhớ được những chuyện đó?"

#. だって…あたしの事なんて…
#. なんの興味もないはずなのに…！
msgctxt "0053 | TOUKO FUKAWA"
msgid "There's no way you c-care about me...!"
msgstr ""
"Rõ ràng... là cậu chẳng thể nào có h-hứng thú với tôi cơ \n"
"mà...!"

#. だから, 興味ない事ないって。
#. だって, ボク達は仲間なんだよ？
msgctxt "0054 | MAKOTO NAEGI"
msgid ""
"I'm telling you, I do! I mean, we're friends,\n"
"aren't we?"
msgstr ""
"Tôi đã bảo là có hứng thú mà. Vì tụi mình là đồng đội mà \n"
"đúng không?"

#. ううっ！　眩しいわ！
#. あんたの真っ直ぐさが眩しいわ…！
msgctxt "0055 | TOUKO FUKAWA"
msgid ""
"Nng...! I'm blind! Your s-straightforward nature\n"
"blinded me!"
msgstr ""
"Ư ư! Chói mắt quá! Cái sự thẳng thắn của cậu làm tôi chói \n"
"mắt quá...!"

#. ひぃぃぃぃぃ…！
msgctxt "0056 | TOUKO FUKAWA"
msgid "Hyeeeeeeeehhh!"
msgstr "Hiiiiiiiiiiiiiiii...!"

#. <CLT 4>妙な奇声を発しながら、
#. 腐川さんは走って逃げて行った…
#. <CLT>
msgctxt "0057 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Toko ran off, screaming like a banshee.\n"
"<CLT>"
msgstr ""
"<CLT 4>Vừa thốt lên những tiếng kêu kỳ lạ, Toko vừa chạy \n"
"biến đi mất...\n"
"<CLT>"

#. なんだか、よくわからないけど…
#. 嫌われたっぽいな…
msgctxt "0058 | MAKOTO NAEGI"
msgid "I'm not really sure... Does she hate me now?"
msgstr "Chẳng hiểu kiểu gì luôn... nhưng hình như mình bị ghét rồi..."

#. <CLT 23>腐川冬子の<CLT><CLT 3>通信簿<CLT><CLT 23>に、今の情報を追記致しました.
#. <CLT>
msgctxt "0059 | NARRATION"
msgid ""
"<CLT 23>Toko's <CLT><CLT 3>Report Card<CLT><CLT 23> has been updated based on your\n"
"experience with her.\n"
"<CLT>"
msgstr ""
"<CLT 3>Bảng điểm<CLT><CLT 23> của Toko đã được cập nhật dựa trên \n"
"trải nghiệm của bạn với cậu ấy.\n"
"<CLT>"

#. <CLT 23>おめでとうございます.
#. スキル<CLT><CLT 3>“ボキャブラリー”<CLT><CLT 23>を獲得致しました.
#. <CLT>
msgctxt "0060 | NARRATION"
msgid ""
"<CLT 23>You just unlocked the skill <CLT><CLT 3>Vocabulary<CLT><CLT 23>!\n"
"Give yourself a pat on the back. You've earned it!\n"
"<CLT>"
msgstr ""
"<CLT 23>Bạn vừa mở khóa được kỹ năng <CLT><CLT 3>Vốn từ vựng<CLT><CLT 23>! \n"
"Cho một tràng pháo tay đi nào. Vì bạn xứng đáng!\n"
"<CLT>"

#. <CLT 4>腐川さんと別れた後、
#. ボクは、いったん自分の部屋へと戻った.
#. <CLT>
msgctxt "0061 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Once we were all done, I headed back to my room for a\n"
"little while...\n"
"<CLT>"
msgstr ""
"<CLT 4>Sau khi chia tay Toko, tôi tạm thời trở về phòng của mình.\n"
"<CLT>"
