#. おーっす、苗木！
#. また、さぼってんの！？
msgctxt "0001 | JUNKO ENOSHIMA (MUKURO)"
msgid "Heeey, Makoto~! Slacking off again, huh?"
msgstr "Ê hê hê, Makoto~! Lại đang trốn đi chơi đấy hả!?"

#. 一緒に過ごす
msgctxt "0002 | CHOICE/RE:ACT"
msgid "Spend some time with Junko"
msgstr "Dành thời gian với Junko"

#. 他の場所へ行く
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Go see who else is around"
msgstr "Đi xem còn ai khác quanh đây"

#. <CLT 4>どうしよう？
#. 江ノ島さんと一緒に過ごそうか？
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hmm... Should I hang out with Junko for a while?\n"
"<CLT>"
msgstr ""
"<CLT 4>Nên làm gì đây? Có nên dành thời gian với Junko một lát\n"
"không nhỉ?\n"
"<CLT>"

#. あたしも退屈してたんだよねぇ…
msgctxt "0005 | JUNKO ENOSHIMA (MUKURO)"
msgid "Yeah, I'm bored too."
msgstr "Mà tớ cũng đang chán muốn xỉu đây nè..."

#. …いいよ。ちょっとだけ付き合ってあげる。
msgctxt "0006 | JUNKO ENOSHIMA (MUKURO)"
msgid "Let's chill for a while!"
msgstr "...Được thôi. Tớ sẽ chơi với cậu một lát vậy!"

#. <CLT 4>江ノ島さんと一緒に過ごした…
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I spent some time with Junko...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình đã dành một khoảng thời gian bên cạnh Junko...\n"
"<CLT>"

#. <CLT 4>江ノ島さんと少し仲良くなれたみたいだ…
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Junko and I grew a little closer today.\n"
"<CLT>"
msgstr ""
"<CLT 4>Dường như hôm nay mình và Junko đã trở nên thân thiết hơn\n"
"một chút...\n"
"<CLT>"

#. 渡す
msgctxt "0009 | CHOICE/RE:ACT"
msgid "Yes, definitely"
msgstr "Có, chắc chắn rồi"

#. 渡さない
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Not really, no"
msgstr "Không hẳn"

#. <CLT 3>プレゼント<CLT><CLT 23>を渡しますか？<CLT>
msgctxt "0011 | NARRATION"
msgid "<CLT 3><CLT><CLT 23>Would you like to give Junko a<CLT> <CLT 3>present<CLT><CLT 23>?<CLT>"
msgstr "<CLT 23>Bạn có muốn tặng <CLT><CLT 3>quà<CLT><CLT 23> cho Junko không?<CLT>"
