#. つーかさ、マジなんか？
#. オレら、マジで閉じ込められたんか？
msgctxt "0001 | LEON KUWATA"
msgid "Seriously? We're seriously trapped in here?"
msgstr "Thiệt hả trời? Tụi mình thật sự bị nhốt trong này luôn à?"

#. 一緒に過ごす
msgctxt "0002 | CHOICE/RE:ACT"
msgid "Spend some time with Leon"
msgstr "Dành chút thời gian với Leon"

#. 他の場所へ行く
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Go see who else is around"
msgstr "Đi xem còn ai ở quanh đây"

#. <CLT 4>…どうしよう？
#. 桑田クンと一緒に過ごそうか？
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hmm... Should I hang out with Leon for a while?\n"
"<CLT>"
msgstr ""
"<CLT 4>Hmm... Mình có nên dành chút thời gian với Leon không nhỉ?\n"
"<CLT>"

#. 何よ、苗木…
#. オレの事心配してんの？
msgctxt "0005 | LEON KUWATA"
msgid "Hey, were you worried about me or something?"
msgstr "Gì vậy, Cậu lo cho tui à?"

#. お前っていいヤツだな！　意外と！
msgctxt "0006 | LEON KUWATA"
msgid "Damn, that's actually kinda nice of you!"
msgstr "Ông đúng là người tốt ghê đó! Không ngờ luôn!"

#. <CLT 4>桑田クンと一緒に、
#. 騒がしい時間を過ごした。
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I had a roaring good time with Leon...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình đã trải qua một khoảng thời gian khá ồn ào với Leon...\n"
"<CLT>"

#. <CLT 4>桑田クンと少し仲良くなれたみたいだ…
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Leon and I grew a little closer today.\n"
"<CLT>"
msgstr ""
"<CLT 4>Có vẻ hôm nay mình và Leon đã thân thiết hơn một chút...\n"
"<CLT>"

#. 渡す
msgctxt "0009 | CHOICE/RE:ACT"
msgid "Yes, definitely"
msgstr "Có, chắc chắn rồi"

#. 渡さない
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Not really, no"
msgstr "Không hẳn, chắc là không"

#. <CLT 3>プレゼント<CLT><CLT 23>を渡しますか？<CLT>
msgctxt "0011 | NARRATION"
msgid "<CLT 3><CLT><CLT 23>Would you like to give Leon a<CLT> <CLT 3>present<CLT><CLT 23>?<CLT>"
msgstr "<CLT 3><CLT><CLT 23>Bạn có muốn tặng Leon một <CLT> <CLT 3>món quà<CLT><CLT 23> không?<CLT>"
