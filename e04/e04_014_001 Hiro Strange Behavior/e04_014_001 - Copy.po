#. うおっ！　苗木っち！！
msgctxt "0001 | YASUHIRO HAGAKURE"
msgid "Uwah! Makoto!?"
msgstr ""

#. どうしたの…そんなに驚いて？
msgctxt "0002 | MAKOTO NAEGI"
msgid "What the...? Why do you seem so surprised?"
msgstr ""

#. ど、どうもしないべ！　どうもする訳ないべ！
#. アハ…アハハハ…
msgctxt "0003 | YASUHIRO HAGAKURE"
msgid ""
"N-Nothing's wrong! Why would anything be wrong!?\n"
"Ahahaha! Ahaha...hah."
msgstr ""

#. <CLT 4>なんか…様子が変だな…
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>He's acting really strange...\n"
"<CLT>"
msgstr ""

#. <CLT 4>まぁ…変なのはいつもの事か…
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Well, I guess he's *always* acting really strange.\n"
"<CLT>"
msgstr ""

#. じゃあ、俺は部屋に帰るんで、
#. このへんで失礼させてもらうべ！！
msgctxt "0006 | YASUHIRO HAGAKURE"
msgid ""
"Okay, well, gonna go back to my room now! Take 'er\n"
"easy, pardner!"
msgstr ""

#. ま、またな…！
#. アハ…アハハハハ…！
msgctxt "0007 | YASUHIRO HAGAKURE"
msgid "S-See ya! Ahahaha...!"
msgstr ""

#. ビビバビバビブビー！
msgctxt "0008 | TOUKO FUKAWA"
msgid "Bibibabibabibubiii!"
msgstr ""

#. アタシの中のマイブーム！
msgctxt "0009 | TOUKO FUKAWA"
msgid "My obsession!"
msgstr ""

#. ビビバビバビブビー！
msgctxt "0010 | TOUKO FUKAWA"
msgid "Bibibabibabibubiii!"
msgstr ""

#. で…何してるの？
msgctxt "0011 | MAKOTO NAEGI"
msgid "What are you doing...?"
msgstr ""

#. 生きてるの！
msgctxt "0012 | TOUKO FUKAWA"
msgid "Living!"
msgstr ""

#. そう…
msgctxt "0013 | MAKOTO NAEGI"
msgid "I see..."
msgstr ""

#. 部屋に帰るッ！　部屋で大人しく生きてるからッ！！
msgctxt "0014 | TOUKO FUKAWA"
msgid ""
"Anyway, I'm headed back to my room! I'll just be\n"
"there, living, totally calm!"
msgstr ""

#. ビビバビバビブビー！！
msgctxt "0015 | TOUKO FUKAWA"
msgid "Bibibabibabibubiii!"
msgstr ""

#. …そこ、女子トイレよ。
msgctxt "0016 | KYOUKO KIRIGIRI"
msgid "That's the girls bathroom."
msgstr ""

#. 急ぎましょう…
msgctxt "0017 | KYOUKO KIRIGIRI"
msgid "Come on, we have to hurry..."
msgstr ""
