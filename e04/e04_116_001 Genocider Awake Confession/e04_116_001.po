#. アタシは
#. すやすや寝てただけ…
msgctxt "0001 | TOUKO FUKAWA"
msgid "I was just sleeping peacefully..."
msgstr "Tớ chỉ đang ngủ say sưa thôi mà..."

#. そこをオーガちんに
#. 起こされたの！
msgctxt "0002 | TOUKO FUKAWA"
msgid ""
"And all of a sudden,\n"
"Sakura was right there in front of me!"
msgstr "Và bỗng nhiên, Sakura xuất hiện ngay trước mặt tớ!"

#. 目が覚めたのは
#. 雑誌棚の前だったわ！
msgctxt "0003 | TOUKO FUKAWA"
msgid ""
"I remember waking up right\n"
"in front of the magazine shelf!"
msgstr "Tớ nhớ là mình tỉnh dậy ngay trước kệ tạp chí!"

#. <CLT 9>血だらけのオーガ<CLT>に
#. 驚いたオメーは…
msgctxt "0004 | YASUHIRO HAGAKURE"
msgid ""
"And you were taken by surprise\n"
"when you saw <CLT 9>Ogre covered in blood<CLT>..."
msgstr "Và mi đã giật nảy mình lên khi nhìn thấy <CLT 9>Ogre bê bết máu<CLT>..."

#. モノクマボトルで
#. オーガを殴ったんだな？
msgctxt "0005 | YASUHIRO HAGAKURE"
msgid ""
"So you smashed her head in\n"
"with the Monokuma Bottle?"
msgstr "Thế nên mi đã đập nát đầu con bé bằng chiếc chai Monokuma phải không?"

#. そう！　オーガちんを殴打ちん！！
msgctxt "0006 | TOUKO FUKAWA"
msgid "You got it! I smashed her good!"
msgstr "Đúng rồi đấy! Tớ đã táng con bé tơi bời luôn!"

#. お前が大神を殴った
#. 場所はどこだ？
msgctxt "0007 | BYAKUYA TOGAMI"
msgid "And where did the attack take place?"
msgstr "Và vụ tấn công đã diễn ra ở đâu?"

#. アタシが目覚めた場所と
#. 一緒よん！
msgctxt "0008 | TOUKO FUKAWA"
msgid "Right where I woke up!"
msgstr "Ngay tại chỗ mà tớ tỉnh dậy chứ đâu!"

#. <CLT 9>雑誌棚の前<CLT>で、
#. 殺っちゃいました！
msgctxt "0009 | TOUKO FUKAWA"
msgid "I killed her there <CLT 9>in front of the shelf<CLT>!"
msgstr "Tớ đã giết con bé ở ngay đó, <CLT 9>ngay trước chiếc kệ<CLT>!"

#. <CLT 26>葉隠君が殴った傷ね…<CLT>
msgctxt "0010 | TOUKO FUKAWA"
msgid "<CLT 26>It was cuz of Hiro!<CLT>"
msgstr "<CLT 26>Tất cả là tại Hiro đấy...!<CLT>"

#. <CLT 26>意外に繊細だな…<CLT>
msgctxt "0011 | TOUKO FUKAWA"
msgid "<CLT 26>She's surprisingly delicate...<CLT>"
msgstr "<CLT 26>Cô ta mong manh hơn tớ tưởng đấy chứ...<CLT>"

#. <CLT 26>二転三転…うぷぷ。<CLT>
msgctxt "0012 | TOUKO FUKAWA"
msgid "<CLT 26>Things change, and change again. Puhuhu...<CLT>"
msgstr "<CLT 26>Mọi chuyện cứ xoay vần liên hồi. Upupuhu...<CLT>"

#. <CLT 26>ゲラゲラゲラゲラ！<CLT>
msgctxt "0013 | TOUKO FUKAWA"
msgid "<CLT 26>Kyeeehahaha!<CLT>"
msgstr "Kyeeehahaha!"

#. <CLT 26>笑うとこじゃないよ！<CLT>
msgctxt "0014 | TOUKO FUKAWA"
msgid "<CLT 26>Now's no time for laughing!<CLT>"
msgstr "<CLT 26>Giờ đâu phải lúc để cười cợt chứ!<CLT>"

#. <CLT 26>ジェノサイダー翔が…<CLT>
msgctxt "0015 | TOUKO FUKAWA"
msgid "<CLT 26>Genocide Jack...<CLT>"
msgstr "Jack Đồ Tể..."

#. <CLT 26>犯人だったの？<CLT>
msgctxt "0016 | TOUKO FUKAWA"
msgid "<CLT 26>Did she kill her?<CLT>"
msgstr "<CLT 26>Chính cô ấy đã ra tay sát hại sao?<CLT>"

#. <CLT 26>やっぱジェノサイダーか！<CLT>
msgctxt "0017 | TOUKO FUKAWA"
msgid "<CLT 26>It was definitely her!<CLT>"
msgstr "<CLT 26>Quả nhiên chính là con nhỏ đó rồi!<CLT>"
