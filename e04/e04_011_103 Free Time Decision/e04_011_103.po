#. ふぅ…
msgctxt "0001 | MAKOTO NAEGI"
msgid "Whew..."
msgstr "Phù..."

#. ………………
msgctxt "0002 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. <CLT 4>今日はこれから…どうしよう…
#. <CLT>
msgctxt "0003 | MAKOTO NAEGI"
msgid ""
"<CLT 4>So, what should I do today?\n"
"<CLT>"
msgstr ""
"<CLT 4>Thế, hôm nay mình nên làm gì đây?\n"
"<CLT>"

#. <CLT 4>まだ、時間はあるな…
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I have plenty of time...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình vẫn còn nhiều thời gian...\n"
"<CLT>"

#. <CLT 4>じっとしている気分じゃないし、
#. どこかに行ってみようかな…
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I don't feel like just sitting here. I should go\n"
"somewhere...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình không muốn cứ ngồi yên một chỗ như thế này.\n"
"Mình nên đi đâu đó thôi...\n"
"<CLT>"

#. はい
msgctxt "0006 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0007 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 4>時間もあるし、少し休もうかな…
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I have some time, so maybe I should take a little\n"
"rest...\n"
"<CLT>"
msgstr ""
"<CLT 4>Vẫn còn thời gian, hay là mình nên nghỉ ngơi \n"
"một chút...\n"
"<CLT>"

#. はい
msgctxt "0009 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0010 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0011 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi đây?\n"
"<CLT>"
