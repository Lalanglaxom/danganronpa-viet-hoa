#. うわぁぁぁああああああああッ！！
msgctxt "0001 | NO NAME"
msgid "UWAAAAAAAAAAHH!!!"
msgstr "UWAAAAAAAAAAHH!!!"

#. …えッ！？
msgctxt "0002 | MAKOTO NAEGI"
msgid "Huh!?"
msgstr "Hả!?"

#. <CLT 4>悲鳴…！？
#. <CLT>
msgctxt "0003 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Was that someone screaming!?\n"
"<CLT>"
msgstr ""
"<CLT 4>Có ai đó vừa hét lên sao!?\n"
"<CLT>"

#. <CLT 4>今のって、食堂の方から聞こえたよな！？
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I think it came from the dining hall!\n"
"<CLT>"
msgstr ""
"<CLT 4>Tiếng hét vừa rồi phát ra từ phía nhà ăn!\n"
"<CLT>"

#. <CLT 4>悲鳴が聞こえたのは、
#. 食堂の方からだ。
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I'm positive that scream came from the dining hall...!\n"
"<CLT>"
msgstr ""
"<CLT 4>Chắc chắn tiếng hét đó phát ra từ phía nhà ăn...!\n"
"<CLT>"

#. <CLT 4>寄り道している場合じゃないぞ。
#. <CLT>
msgctxt "0006 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Now's no time for taking detours!\n"
"<CLT>"
msgstr ""
"<CLT 4>Bây giờ không phải lúc đi đường vòng đâu!\n"
"<CLT>"

#. <CLT 4>寄り道している場合じゃない！
#. 悲鳴が聞こえたのは、食堂の方からだ。
