#. さくらちゃんに
#. 呼び出されてたなんて…
msgctxt "0001 | AOI ASAHINA"
msgid ""
"The fact that Sakura wanted\n"
"to meet with all three of them..."
msgstr ""
"Việc Sakura muốn gặp mặt \n"
"cả ba người họ..."

#. どう考えても怪しいよ！
msgctxt "0002 | AOI ASAHINA"
msgid "There's no way that's not suspicious!"
msgstr "Kiểu gì cũng thấy cực kỳ đáng ngờ!"

#. 絶対、あんた達の中に
#. 犯人がいるんだよ！
msgctxt "0003 | AOI ASAHINA"
msgid "One of you is absolutely guilty!"
msgstr ""
"Một trong các người chắc \n"
"chắn là có tội!"

#. 呼び出された事は
#. 確かだが…
msgctxt "0004 | BYAKUYA TOGAMI"
msgid ""
"I don't deny that she wanted\n"
"to meet with us, but..."
msgstr ""
"Chuyện cô ta muốn gặp chúng \n"
"tôi là sự thật, nhưng mà..."

#. 俺は会いに<CLT 9>行ってない<CLT>ぞ。
msgctxt "0005 | BYAKUYA TOGAMI"
msgid "I <CLT 9>never went<CLT> to see her."
msgstr "Tôi <CLT 9>chưa từng đi<CLT> gặp cô ta."

#. あ、あたしも…
#. <CLT 9>行ってない<CLT>わ…
msgctxt "0006 | TOUKO FUKAWA"
msgid "<CLT 9>I-I didn't either<CLT>..."
msgstr "<CLT 9>T-Tôi cũng không hề<CLT>..."

#. お、俺も…
#. 会いには<CLT 9>行ってない<CLT>べ…
msgctxt "0007 | YASUHIRO HAGAKURE"
msgid "Yeah, same here! <CLT 9>I never saw her<CLT>...!"
msgstr "Đây cũng thế! <CLT 9>Tớ chưa từng gặp cô ấy<CLT>...!"

#. 誰も会いに行ってない訳
#. ないじゃん！
msgctxt "0008 | AOI ASAHINA"
msgid ""
"Come on!\n"
"There's no way *none* of you went!"
msgstr ""
"Thôi nào!\n"
"Làm gì có chuyện *không một ai* đến gặp chứ!"

#. 誰かがウソついてんだよ！！
msgctxt "0009 | AOI ASAHINA"
msgid "At least one of you is lying!"
msgstr "Ít nhất một trong các người đang nói dối!"
