#. <CLT 4>これって…なんだ？
#. サウナの熱源…かな？
#. <CLT>
msgctxt "0001 | MAKOTO NAEGI"
msgid ""
"<CLT 4>What's this? Is it...the heat source for the sauna?\n"
"<CLT>"
msgstr ""
"<CLT 4>Cái gì thế này? Có phải là... nguồn nhiệt cho phòng xông\n"
"hơi không nhỉ?\n"
"<CLT>"

#. はい
msgctxt "0002 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0003 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>サウナから出ますか？
#. <CLT>
msgctxt "0004 | NARRATION"
msgid ""
"<CLT 23>Leave the sauna?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi phòng xông hơi?\n"
"<CLT>"
