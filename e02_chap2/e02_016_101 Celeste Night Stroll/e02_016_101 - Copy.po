msgid ""
"<CLT 4>There's no food here. I should just head to the\n"
"<CLT><CLT 3>dining hall<CLT><CLT 4>.\n"
"<CLT>"
msgstr ""

#. <CLT 4>ここは女子トイレだ…
#. もちろん、入る訳にはいかない…
#. <CLT>
msgctxt "0031 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is the girls bathroom. Obviously I can't go in...\n"
"<CLT>"
msgstr ""

#. <CLT 4>ここに食べ物はないな…
#. <CLT><CLT 3>食堂<CLT><CLT 4>へ行こう。
#. <CLT>
msgctxt "0032 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There's no food here. I should head to the <CLT><CLT 3>dining\n"
"hall<CLT><CLT 4>.\n"
"<CLT>"
msgstr ""

#. <CLT 4>ここは霧切さんの部屋だ。
#. 今は用事はないかな…
#. <CLT>
msgctxt "0033 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is Kyoko's room. There's nothing I need to do\n"
"here right now...\n"
"<CLT>"
msgstr ""

#. <CLT 23>「ガタガタガタ！」
#. <CLT>
msgctxt "0034 | NARRATION"
msgid ""
"<CLT 23>*Rattle rattle*\n"
"<CLT>"
msgstr ""

