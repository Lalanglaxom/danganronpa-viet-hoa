msgid ""
"<CLT 4>The gate is blocking access to the stairs.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cánh cửa sập đang chặn lối lên cầu thang.\n"
"<CLT>"

#. <CLT 4>こっちは行けるようにはならないのか…
#. <CLT>
msgctxt "0042 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I wonder if this'll open up at some point...\n"
"<CLT>"
msgstr ""
"<CLT 4>Không biết đến lúc nào đó nó mới mở ra nhỉ...\n"
"<CLT>"

#. <CLT 4>鉄格子だ…
#. かなり頑丈そうだな。
#. <CLT>
msgctxt "0043 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This gate seems remarkably sturdy.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cánh cửa này trông có vẻ cực kỳ kiên cố.\n"
"<CLT>"

#. <CLT 4>なんだって、こんなに厳重に
#. 封鎖してるんだろう…
#. <CLT>
msgctxt "0044 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Why would someone go to all the trouble of blocking\n"
"off this entire area?\n"
"<CLT>"
msgstr ""
"<CLT 4>Tại sao lại có kẻ phải tốn công tốn sức đến mức phong\n"
"tỏa toàn bộ khu vực này chứ?\n"
"<CLT>"
