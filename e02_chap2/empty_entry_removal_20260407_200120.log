msgid "No"
msgstr "Không"

#. <CLT 23><CLT><CLT 3>リトライ<CLT><CLT 23>なさいますか？
#. <CLT>
msgctxt "0013 | NARRATION"
msgid ""
"<CLT 23>Whaddya say? Wanna <CLT><CLT 3>give it another shot<CLT><CLT 23>?\n"
"<CLT>"
msgstr ""
"<CLT 23>Bạn nói sao nào? Có muốn <CLT><CLT 3>thử lại lần nữa<CLT><CLT 23> không?\n"
"<CLT>"


────────────────────────────────────────────────────────────────────────
  CHAPTER  e02_200_000 Mondo Killer Reveal
────────────────────────────────────────────────────────────────────────

  [ERROR]  e02_200_000
    ✗ msgid ""
msgstr ""
