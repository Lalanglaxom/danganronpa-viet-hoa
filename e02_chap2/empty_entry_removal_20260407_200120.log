msgid "The door won't budge. It must be locked."
msgstr "Cánh cửa không hề nhúc nhích. Chắc là nó đã bị khóa rồi."

#. <CLT 4>セレスさんの部屋だ。
#. <CLT>
msgctxt "0044 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is Celeste's room.\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là phòng của Celeste.\n"
"<CLT>"

#. <CLT 23>「コンコン」
#. <CLT>
msgctxt "0045 | NARRATION"
msgid ""
"<CLT 23>*Knock knock*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Cốc cốc*\n"
"<CLT>"

#. ………………
msgctxt "0046 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. <CLT 23>「コンコン」
#. <CLT>
msgctxt "0047 | NARRATION"
msgid ""
"<CLT 23>*Knock knock*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Cốc cốc*\n"
"<CLT>"

#. ………………
msgctxt "0048 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. <CLT 4>いないみたいだ…
#. <CLT>
msgctxt "0049 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Looks like nobody's here.\n"
"<CLT>"
msgstr ""
"<CLT 4>Có vẻ không có ai ở đây cả.\n"
"<CLT>"

#. <CLT 4>大神さんの部屋だ。
#. 今は特に用もないな。
#. <CLT>
msgctxt "0050 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is Sakura's room. I don't have anything I need to\n"
"talk to her about right now...\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là phòng của Sakura. Hiện tại mình không có chuyện\n"
"gì cần phải nói với cậu ấy cả...\n"
"<CLT>"

#. <CLT 23>「ガタガタガタ！」
#. <CLT>
msgctxt "0051 | NARRATION"
msgid ""
"<CLT 23>*Rattle rattle*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Lạch cạch lạch cạch*\n"
"<CLT>"

#. 開かない…
#. 鍵が掛かってるみたいだ…
msgctxt "0052 | MAKOTO NAEGI"
msgid "The door won't budge. It must be locked."
msgstr "Cánh cửa không hề nhúc nhích. Chắc là nó đã bị khóa rồi."

#. <CLT 4>葉隠クンの部屋はここだ。
#. 今は特に用もないな。
#. <CLT>
msgctxt "0053 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is Hiro's room. I don't have anything I need to\n"
"talk to him about right now...\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là phòng của Hiro. Hiện tại mình không có chuyện gì\n"
"cần phải nói với cậu ấy cả...\n"
"<CLT>"

#. <CLT 4>ここは山田クンの部屋だ。
#. <CLT>
msgctxt "0054 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is Hifumi's room.\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là phòng của Hifumi.\n"
"<CLT>"

#. <CLT 23>「コンコン」
#. <CLT>
msgctxt "0055 | NARRATION"
msgid ""
"<CLT 23>*Knock knock*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Cốc cốc*\n"
"<CLT>"

#. ………………
msgctxt "0056 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. <CLT 23>「コンコン」
#. <CLT>
msgctxt "0057 | NARRATION"
msgid ""
"<CLT 23>*Knock knock*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Cốc cốc*\n"
"<CLT>"

#. ………………
msgctxt "0058 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. <CLT 4>いないみたいだ…
#. <CLT>
msgctxt "0059 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Looks like nobody's here.\n"
"<CLT>"
msgstr ""
"<CLT 4>Có vẻ không có ai ở đây cả.\n"
"<CLT>"

#. <CLT 4>階段には、シャッターが降りてる。
#. <CLT>
msgctxt "0060 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The gate is blocking access to the stairs.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cánh cửa sập đang chặn lối lên cầu thang.\n"
"<CLT>"

#. <CLT 4>この先で何かあった…とは考えられない。
#. <CLT>
msgctxt "0061 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I can't imagine anything's happened through there...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình không nghĩ là có chuyện gì đã xảy ra ở phía sau đó đâu...\n"
"<CLT>"

#. <CLT 4>鉄格子だ…
#. かなり頑丈そうだな。
#. <CLT>
msgctxt "0062 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This gate seems remarkably sturdy.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cánh cửa này trông có vẻ cực kỳ kiên cố.\n"
"<CLT>"

#. <CLT 4>なんだって、こんなに厳重に
#. 封鎖してるんだろう…
#. <CLT>
msgctxt "0063 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Why would someone go to all the trouble of blocking\n"
"off this entire area?\n"
"<CLT>"
msgstr ""
"<CLT 4>Tại sao lại có kẻ phải tốn công tốn sức đến mức phong\n"
"tỏa toàn bộ khu vực này chứ?\n"
"<CLT>"


────────────────────────────────────────────────────────────────────────
  CHAPTER  e02_025_135 Gathering After Announcement
────────────────────────────────────────────────────────────────────────

  [ERROR]  e02_025_135
    ✗ msgid ""
msgstr ""
"Project-Id-Version: DR1 (PC)\n"
"Report-Msgid-Bugs-To: your_email\n"
"POT-Creation-Date: 3/26/2026\n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: en_US\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Generator: Poedit 3.8\n"

#. あっ、苗木！！
msgctxt "0001 | AOI ASAHINA"
msgid "Ah, Makoto!"
msgstr "A, Makoto!"

#. …無事だったん？
msgctxt "0002 | YASUHIRO HAGAKURE"
msgid "Are you okay?"
msgstr "Cậu vẫn ổn chứ?"

#. お主も、モノクマに話を聞いて、
#. ここにやって来たんだな？
msgctxt "0003 | SAKURA OOGAMI"
msgid "Did Monokuma talk to you, too?"
msgstr "Chắc hẳn cậu cũng đã nghe Monokuma nói rồi đúng không?"

#. 葉隠クン、朝日奈さん、大神さん…
#. それに…
msgctxt "0004 | MAKOTO NAEGI"
msgid "Hiro, Hina, Sakura, and..."
msgstr "Hiro, Hina, Sakura, và..."

#. ………………
msgctxt "0005 | BYAKUYA TOGAMI"
msgid "..."
msgstr "..."

#. 十神クン…
msgctxt "0006 | MAKOTO NAEGI"
msgid "Byakuya..."
msgstr "Byakuya..."

#. この４人だけ…？　他のみんなは？
msgctxt "0007 | MAKOTO NAEGI"
msgid "You're the only ones here? Where's everyone else?"
msgstr "Chỉ có bốn người ở đây thôi sao? Mọi người đâu hết rồi?"

#. すでにモノクマの言葉を確かめに行っているか、
#. あるいは…
msgctxt "0008 | BYAKUYA TOGAMI"
msgid ""
"Either they're already off trying to verify what\n"
"Monokuma said..."
msgstr "Hoặc là họ đã đi xác thực những gì Monokuma vừa nói..."

#. ヤツの言う<CLT 3>“何か”<CLT>に巻き込まれているか…
msgctxt "0009 | BYAKUYA TOGAMI"
msgid ""
"...or they've fallen victim to the \"<CLT 3>something<CLT>\" that\n"
"Monokuma mentioned ."
msgstr ""
"...hoặc là họ đã trở thành nạn nhân của \"<CLT 3>chuyện gì đó<CLT>\"\n"
"mà Monokuma đã đề cập."

#. な、何かって…？
msgctxt "0010 | MAKOTO NAEGI"
msgid "The...something?"
msgstr "Chuyện... gì đó sao?"

#. もしや…また起きたのではあるまいな…
msgctxt "0011 | SAKURA OOGAMI"
msgid "It can't be... Has it happened again?"
msgstr "Không thể nào... Chẳng lẽ nó lại xảy ra rồi sao?"

#. 殺人が……
msgctxt "0012 | SAKURA OOGAMI"
msgid "Murder...?"
msgstr "Giết người sao...?"

#. <CLT 4>それは、モノクマの言葉を聞いて、
#. 真っ先に頭に浮かんだ最悪の可能性…
#. <CLT>
msgctxt "0013 | MAKOTO NAEGI"
msgid ""
"<CLT 4>After hearing what Monokuma had to say, the worst\n"
"possibility forced its way into my mind...\n"
"<CLT>"
msgstr ""
"<CLT 4>Sau khi nghe những gì Monokuma nói, khả năng tồi tệ nhất\n"
"đã len lỏi vào tâm trí mình...\n"
"<CLT>"

#. <CLT 4>最悪ゆえに…
#. 真っ先に追い払われた可能性…
#. <CLT>
msgctxt "0014 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It took everything I had to drive that thought away.\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình đã phải dùng hết sức bình sinh để xua tan ý nghĩ đó đi.\n"
"<CLT>"

#. だ、だとしたら、昨日のあれのせいって事か？
msgctxt "0015 | YASUHIRO HAGAKURE"
msgid ""
"S-So if something really did happen... Does that mean\n"
"someone did it cuz of what happened yesterday?"
msgstr ""
"V-Vậy nếu thực sự có chuyện gì đó xảy ra... Có nghĩa là\n"
"ai đó đã làm vậy vì chuyện ngày hôm qua sao?"

#. ありえないよ！　たかが<CLT 3>“思い出”<CLT>だよ！？
msgctxt "0016 | AOI ASAHINA"
msgid ""
"It can't be! That stuff was just a bunch of <CLT 3>old\n"
"memories<CLT>!"
msgstr ""
"Không thể nào! Mấy thứ đó chỉ là một đống <CLT 3>kỷ niệm cũ\n"
"rích<CLT> thôi mà!"

#. たかが…？　それはどうかな…
msgctxt "0017 | BYAKUYA TOGAMI"
msgid "\"Just\" old memories? Don't be so sure about that."
msgstr "\"Chỉ là\" kỷ niệm cũ thôi sao? Đừng có chắc chắn như vậy."

#. そう思えない人間だって、
#. いたはずだぞ…
msgctxt "0018 | BYAKUYA TOGAMI"
msgid "Clearly someone felt it was more important than that."
msgstr "Rõ ràng là đã có kẻ cảm thấy nó còn quan trọng hơn thế đấy."

#. えっ…？
msgctxt "0019 | MAKOTO NAEGI"
msgid "Huh...?"
msgstr "Hả...?"

#. 自分を基準にして価値判断を行う…
#. それが、どれほど危険な行為か気付かないのか？
msgctxt "0020 | BYAKUYA TOGAMI"
msgid ""
"To judge someone else's values based on your own\n"
"outlook... Do you realize how dangerous that is?"
msgstr ""
"Dùng quan điểm của bản thân để đánh giá giá trị của người\n"
"khác... Mi có nhận ra hành động đó nguy hiểm đến mức nào không?"

#. だったら…なんで昨日そう言わなかったのよ…！
msgctxt "0021 | AOI ASAHINA"
msgid "Wh—? Why didn't you say something yesterday!?"
msgstr "Cái—? Tại sao hôm qua ông không nói gì chứ!?"

#. もう忘れたのか？　これは協力し合うゲームじゃない。
#. 蹴落とし合うゲームなんだ。
msgctxt "0022 | BYAKUYA TOGAMI"
msgid ""
"Did you already forget? This isn't a co-op game. It's\n"
"every man for himself."
msgstr ""
"Bộ cô quên rồi sao? Đây không phải trò chơi hợp tác. Mà\n"
"là mạnh ai nấy sống."

#. わざわざ助け船を出して、
#. 俺になんの得がある…！
msgctxt "0023 | BYAKUYA TOGAMI"
msgid ""
"What good does it do me to go out of my way to help\n"
"you?"
msgstr ""
"Việc phí công đi giúp đỡ các người thì có lợi lộc gì cho\n"
"tôi chứ?"

#. まだ…そんな事言ってんの…？
msgctxt "0024 | AOI ASAHINA"
msgid "Stop saying that already!"
msgstr "Đừng có nói mấy lời đó nữa!"

#. どうかしてんべ。
#. リアルな話、洗脳でもされてんじゃねーか？
msgctxt "0025 | YASUHIRO HAGAKURE"
msgid ""
"There's something wrong with him, for serious. Did he\n"
"get brainwashed or something?"
msgstr "Hắn ta có vấn đề thật rồi. Hay là hắn bị tẩy não rồi nhỉ?"

#. 待て、それよりも今は
#. 何があったのかを突き止めるのが先だ…
msgctxt "0026 | SAKURA OOGAMI"
msgid ""
"That's not important. What matters right now is that\n"
"we find out what happened..."
msgstr ""
"Chuyện đó không quan trọng. Điều cần thiết lúc này là\n"
"chúng ta phải tìm ra xem đã có chuyện gì xảy ra..."

#. そうだな…
#. では、手分けして探すとしようか。
msgctxt "0027 | BYAKUYA TOGAMI"
msgid "She's right. Let's all split up and begin looking."
msgstr "Cô ta nói đúng đấy. Hãy chia nhau ra và bắt đầu tìm kiếm đi."

#. フフ…行くぞ…
msgctxt "0028 | BYAKUYA TOGAMI"
msgid "Hmhm... The game is afoot."
msgstr "Hừm... Trò chơi bắt đầu rồi đấy."

#. <CLT 4>モノクマが写るモニター…
#. 今はこんな物を気にしている場合じゃない…
#. <CLT>
msgctxt "0029 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is one of the monitors Monokuma appears on. I\n"
"can't think about this right now...\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là một trong những chiếc màn hình mà Monokuma thường xuất\n"
"hiện. Mình không thể bận tâm về nó vào lúc này được...\n"
"<CLT>"

#. <CLT 4>監視カメラ…
#. <CLT>
msgctxt "0030 | MAKOTO NAEGI"
msgid ""
"<CLT 4>A surveillance camera...\n"
"<CLT>"
msgstr ""
"<CLT 4>Một chiếc camera giám sát...\n"
"<CLT>"

#. <CLT 4>もし、何かあったなら…
#. このカメラでそれも見てたはずだよな…
#. <CLT>
msgctxt "0031 | MAKOTO NAEGI"
msgid ""
"<CLT 4>If something did happen...one of these cameras must\n"
"have caught it.\n"
"<CLT>"
msgstr ""
"<CLT 4>Nếu thực sự có chuyện gì xảy ra... chắc chắn một trong\n"
"số những chiếc camera này đã ghi lại được.\n"
"<CLT>"

#. <CLT 4>時計があって時間はわかるけど…
#. <CLT>
msgctxt "0032 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There's a clock telling me what time it is...\n"
"<CLT>"
msgstr ""
"<CLT 4>Có một chiếc đồng hồ cho mình biết bây giờ là mấy giờ...\n"
"<CLT>"

#. <CLT 4>今は時間なんか気にしている場合じゃない…
#. <CLT>
msgctxt "0033 | MAKOTO NAEGI"
msgid ""
"<CLT 4>...but I can't worry about time right now.\n"
"<CLT>"
msgstr ""
"<CLT 4>...nhưng hiện tại mình không thể lo lắng về thời gian được.\n"
"<CLT>"

#. はい
msgctxt "0034 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0035 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0036 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi đây?\n"
"<CLT>"


────────────────────────────────────────────────────────────────────────
  CHAPTER  e02_025_137 Trash Room Investigation
────────────────────────────────────────────────────────────────────────

  [ERROR]  e02_025_137
    ✗ msgid ""
msgstr ""
"Project-Id-Version: DR1 (PC)\n"
"Report-Msgid-Bugs-To: your_email\n"
"POT-Creation-Date: 3/26/2026\n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: en_US\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Generator: Poedit 3.8\n"

#. ここは…何もないようだな…
msgctxt "0001 | SAKURA OOGAMI"
msgid "There doesn't appear to be anything here."
msgstr "Có vẻ như ở đây chẳng có gì cả."

#. 大神さんはどうしてここに？
#. 何か…気になる事があったの？
msgctxt "0002 | MAKOTO NAEGI"
msgid ""
"What are you doing here, Sakura? Did you...find\n"
"something?"
msgstr ""
"Cậu đang làm gì ở đây vậy, Sakura? Cậu có... tìm thấy\n"
"thứ gì không?"

#. いいや…
msgctxt "0003 | SAKURA OOGAMI"
msgid "Oh, no."
msgstr "À, không."

#. ただ…先日のお主の推理が…
#. 頭のどこかに残っていたのかもな…
msgctxt "0004 | SAKURA OOGAMI"
msgid ""
"It's just that...what you said the other day must have\n"
"been lurking in the back of my mind."
msgstr ""
"Chỉ là... những gì cậu nói hôm nọ chắc hẳn vẫn luôn luẩn\n"
"quẩn trong tâm trí tôi."

#. え？
msgctxt "0005 | MAKOTO NAEGI"
msgid "Huh?"
msgstr "Hả?"

#. 何かが起こったのならば…
#. ここでまた、<CLT 3>証拠隠滅<CLT>が行われる…
msgctxt "0006 | SAKURA OOGAMI"
msgid ""
"If something has happened, the killer might try to use\n"
"this to <CLT 3>destroy evidence<CLT> again."
msgstr ""
"Nếu có chuyện gì xảy ra, hung thủ có thể lại cố lợi dụng\n"
"nơi này để <CLT 3>tiêu hủy bằng chứng<CLT> một lần nữa."

#. そんな連想を…してしまったのかもしれんな…
msgctxt "0007 | SAKURA OOGAMI"
msgid ""
"I suppose that was floating around my subconscious,\n"
"and it led me here."
msgstr ""
"Tôi đoán là điều đó cứ lảng vảng trong tiềm thức, và nó\n"
"đã dẫn tôi đến đây."

#. ここは…何もないようだな…
msgctxt "0008 | SAKURA OOGAMI"
msgid "There doesn't appear to be anything here."
msgstr "Có vẻ như ở đây chẳng có gì cả."

#. <CLT 4>外の情報に飢えている…
#. ここでテレビでも見られればな…
#. <CLT>
msgctxt "0009 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I'm starving for information from the outside world.\n"
"If only there was a TV that worked...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình đang khao khát thông tin từ thế giới bên ngoài. Giá\n"
"mà có một chiếc tivi còn hoạt động ở đây nhỉ...\n"
"<CLT>"

#. <CLT 4>こんな監視カメラで見張られる生活が…
#. 一体、いつまで続くんだよ…
#. <CLT>
msgctxt "0010 | MAKOTO NAEGI"
msgid ""
"<CLT 4>How long am I going to be stuck here, being watched by\n"
"all these cameras...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Cuộc sống bị giám sát bởi tất cả những chiếc camera\n"
"này... Rốt cuộc sẽ còn kéo dài đến bao giờ đây...?\n"
"<CLT>"

#. <CLT 4>鉄格子の開閉スイッチだ…
#. <CLT>
msgctxt "0011 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It's the switch that raises and lowers the gate.\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là công tắc để nâng và hạ cánh cửa sắt.\n"
"<CLT>"

#. <CLT 4>ボクは鍵を持ってないから、開けられない…
#. <CLT>
msgctxt "0012 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I don't have the key, so I can't activate it.\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình không có chìa khóa, nên không thể kích hoạt nó được.\n"
"<CLT>"

#. <CLT 4>床に扉がある…
#. <CLT>
msgctxt "0013 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There's a hatch on the floor...\n"
"<CLT>"
msgstr ""
"<CLT 4>Có một cánh cửa sập trên sàn nhà...\n"
"<CLT>"

#. <CLT 23>「ガタガタガタ！」
#. <CLT>
msgctxt "0014 | NARRATION"
msgid ""
"<CLT 23>*Rattle rattle*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Lạch cạch lạch cạch*\n"
"<CLT>"

#. 開かない…
#. 鍵が掛かってるみたいだ…
msgctxt "0015 | MAKOTO NAEGI"
msgid "The door won't budge. It must be locked."
msgstr "Cánh cửa không hề nhúc nhích. Chắc là nó đã bị khóa rồi."

#. <CLT 4>ここはトラッシュルーム…つまりゴミ捨て場だな。
#. <CLT>
msgctxt "0016 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is the trash room. The dump, in other words.\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là phòng rác. Nói cách khác chính là bãi đổ rác.\n"
"<CLT>"

#. <CLT 4>だけど、鉄格子がジャマで中に入れない。
#. <CLT>
msgctxt "0017 | MAKOTO NAEGI"
msgid ""
"<CLT 4>But with the gate in the way, I can't actually get\n"
"inside.\n"
"<CLT>"
msgstr ""
"<CLT 4>Nhưng vì có cánh cửa sắt chặn đường, mình không thực sự\n"
"vào bên trong được.\n"
"<CLT>"

#. はい
msgctxt "0018 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0019 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0020 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi đây?\n"
"<CLT>"


────────────────────────────────────────────────────────────────────────
  CHAPTER  e02_026_026 Locker Room Suspicion Locker Room Discovery
────────────────────────────────────────────────────────────────────────

  [ERROR]  e02_026_026
    ✗ msgid ""
msgstr ""
"Project-Id-Version: DR1 (PC)\n"
"Report-Msgid-Bugs-To: your_email\n"
"POT-Creation-Date: 3/26/2026\n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: en_US\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Generator: Poedit 3.8\n"

#. <CLT 4>モノクマが写るモニター…
#. こんな物を気にしている場合じゃない…
#. <CLT>
msgctxt "0001 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is one of the monitors Monokuma appears on. Now's\nno time to think about it...\n<CLT>"
msgstr ""
msgid ""
"<CLT 4>This is one of the monitors Monokuma appears on. Now's\n"
"no time to think about it...\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là một trong những chiếc màn hình mà Monokuma xuất\n"
"hiện. Bây giờ không phải lúc để nghĩ về nó đâu...\n"
"<CLT>"

#. <CLT 4>監視カメラ…
#. <CLT>
msgctxt "0002 | MAKOTO NAEGI"
msgid ""
"<CLT 4>A surveillance camera...\n"
"<CLT>"
msgstr ""
"<CLT 4>Một chiếc camera giám sát...\n"
"<CLT>"

#. <CLT 4>もし、何かあったなら…
#. このカメラでそれも見ていたはずだよな…
#. <CLT>
msgctxt "0003 | MAKOTO NAEGI"
msgid ""
"<CLT 4>If something did happen...one of these cameras must\n"
"have caught it.\n"
"<CLT>"
msgstr ""
"<CLT 4>Nếu thực sự có chuyện gì xảy ra... chắc chắn một trong\n"
"số những chiếc camera này đã ghi lại được.\n"
"<CLT>"

#. <CLT 4>あれ…？
#. <CLT>
msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Huh...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Hả...?\n"
"<CLT>"

#. <CLT 4>…ドアが開くぞ？
#. ロックが掛かってるはずじゃなかったっけ…
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The door's open. But aren't these supposed to be\n"
"locked...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Cánh cửa đang mở. Nhưng chẳng phải mấy cánh cửa này phải\n"
"được khóa rồi sao...?\n"
"<CLT>"

#. <CLT 4>こっちは女子更衣室のドアだ。
#. ボクじゃロックを外せないから入れない…
#. <CLT>
msgctxt "0006 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The door to the girls locker room. I have no way of\n"
"unlocking it, so I couldn't go in if I wanted to.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cửa phòng thay đồ nữ. Mình không có cách nào mở khóa nó,\n"
"nên dù muốn mình cũng chẳng thể vào được.\n"
"<CLT>"

#. 更衣室のロックを解除するには…
#. 電子生徒手帳が必要なんだったよな。
msgctxt "0007 | MAKOTO NAEGI"
msgid "You need an e-Handbook to unlock the locker rooms..."
msgstr ""
"Cậu cần có sổ học sinh điện tử để mở khóa các phòng \n"
"thay đồ..."

#. <CLT 4>ボクは電子生徒手帳を取り出し、
#. それをカードリーダーに重ねた。
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I took out my handbook and swiped it across the card\n"
"reader.\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình lấy cuốn sổ tay của mình ra và quẹt nó qua máy đọc thẻ.\n"
"<CLT>"

#. <CLT 4>すると…
#. <CLT>
msgctxt "0009 | MAKOTO NAEGI"
msgid ""
"<CLT 4>And then...\n"
"<CLT>"
msgstr ""
"<CLT 4>Và rồi...\n"
"<CLT>"

#. <CLT 4>………………
#. <CLT>
msgctxt "0010 | MAKOTO NAEGI"
msgid ""
"<CLT 4>...\n"
"<CLT>"
msgstr ""
"<CLT 4>...\n"
"<CLT>"

#. あ…れ？
#. なんの反応も…ない。
msgctxt "0011 | MAKOTO NAEGI"
msgid "Huh? It...didn't do anything."
msgstr "Hả? Nó... không có phản ứng gì cả."

#. <CLT 4>こっちは女子更衣室のカードリーダーだ。
#. ボクの電子生徒手帳じゃ反応しないはず…
#. <CLT>
msgctxt "0012 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The girls locker room card reader. I'm listed as\n"
"\"male\" in my e-Handbook, so it can't open this door.\n"
"<CLT>"
msgstr ""
"<CLT 4>Máy đọc thẻ phòng thay đồ nữ. Trong sổ học sinh điện tử mình\n"
"được ghi là \"nam\", nên nó không thể mở cánh cửa này được.\n"
"<CLT>"

#. <CLT 4>これって…本物の銃だよな？
#. なんでこんな物があるんだよ…
#. <CLT>
msgctxt "0013 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Is that...a real gun? Why is there something like that\n"
"here...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Đó là... một khẩu súng thật sao? Tại sao một thứ như vậy\n"
"lại ở đây cơ chứ...?\n"
"<CLT>"

#. <CLT 4>水泳用の色々な用具がある…
#. なんに使うのかよくわからないものもある…
#. <CLT>
msgctxt "0014 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There's some swimming gear, and a bunch of other stuff\n"
"that I dunno what it's for.\n"
"<CLT>"
msgstr ""
"<CLT 4>Có vài dụng cụ bơi lội, và một đống thứ khác mình chẳng\n"
"rõ dùng để làm gì nữa.\n"
"<CLT>"

#. <CLT 4>浮き輪がある…
#. ボクは泳げるから必要ないな。
#. <CLT>
msgctxt "0015 | MAKOTO NAEGI"
msgid ""
"<CLT 4>A flotation donut... I know how to swim, so I don't\n"
"think I'll need something like that.\n"
"<CLT>"
msgstr ""
"<CLT 4>Một cái phao bơi... Mình biết bơi rồi nên chắc là không\n"
"cần thứ đó đâu.\n"
"<CLT>"

#. <CLT 4>もう少し…ここを調べてみよう…
#. <CLT>
msgctxt "0016 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I should probably look around a little more...\n"
"<CLT>"
msgstr ""
"<CLT 4>Chắc là mình nên quan sát xung quanh thêm chút nữa...\n"
"<CLT>"

#. <CLT 23>「キーン、コーン…　カーン、コーン」
#. <CLT>
msgctxt "0017 | NARRATION"
msgid ""
"<CLT 23>*Ding dong, bing bong*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Bính bong, binh bong*\n"
"<CLT>"

#. 現在は<CLT 3>“捜査”<CLT>の為に、ロックを解除してあります。
#. どうぞ、ご自由にお調べください。
msgctxt "0018 | MONOKUMA"
msgid ""
"For this <CLT 3>investigation<CLT>, I have unlocked the doors.\n"
"Please look around to your heart's content!"
msgstr ""
"Vì cuộc <CLT 3>điều tra<CLT> này, ta đã mở khóa tất cả các cánh cửa.\n"
"Hãy cứ tự nhiên quan sát cho thỏa thích nhé!"

#. そ、捜査って…！？
msgctxt "0019 | MAKOTO NAEGI"
msgid "I-Investigation...?"
msgstr "Đ-Điều tra sao...?"

#. やはりな…
msgctxt "0020 | BYAKUYA TOGAMI"
msgid "Just as I thought."
msgstr "Quả đúng như tôi nghĩ."

#. 十神クン…ッ！
msgctxt "0021 | MAKOTO NAEGI"
msgid "Byakuya—!"
msgstr "Byakuya—!"

#. 今のモノクマの口調からして…
#. やはり<CLT 3>“殺人”<CLT>が起きたのは間違いないようだ。
msgctxt "0022 | BYAKUYA TOGAMI"
msgid ""
"Judging from what he just said, there can be no doubt\n"
"a <CLT 3>murder<CLT> really has taken place."
msgstr ""
"Dựa vào những gì hắn vừa nói, không còn nghi ngờ gì nữa,\n"
"một vụ <CLT 3>giết người<CLT> thực sự đã xảy ra."

#. そ、そんなッ…！！
msgctxt "0023 | MAKOTO NAEGI"
msgid "C-Come on...!"
msgstr "Kh-Không thể nào...!"

#. それと、あっちの更衣室…
msgctxt "0024 | BYAKUYA TOGAMI"
msgid "And the locker rooms..."
msgstr "Và các phòng thay đồ nữa..."

#. 怪しいな…とても怪しい…
#. お前もそう思わないか？
msgctxt "0025 | BYAKUYA TOGAMI"
msgid ""
"They're suspicious. Very suspicious, indeed. Wouldn't\n"
"you agree?"
msgstr ""
"Chúng thật khả nghi. Thực sự rất khả nghi đấy. Cậu có\n"
"đồng ý không?"

#. え？　怪しいって…？
msgctxt "0026 | MAKOTO NAEGI"
msgid "Huh? Suspicious...?"
msgstr "Hả? Khả nghi sao...?"

#. 更衣室はまだ誰も見てないようだな。
#. では、まずは先に<CLT 3>女子更衣室<CLT>から見てみるか…
msgctxt "0027 | BYAKUYA TOGAMI"
msgid ""
"It seems nobody's searched the locker rooms. Let's\n"
"start with the <CLT 3>girls locker room<CLT>..."
msgstr ""
"Có vẻ như chưa có ai lục soát các phòng thay đồ cả. Hãy\n"
"bắt đầu với <CLT 3>phòng thay đồ nữ<CLT> trước đi..."

#. <CLT 4>十神クンは独り言のように、
#. そう呟き…
#. <CLT>
msgctxt "0028 | MAKOTO NAEGI"
msgid ""
"<CLT 4>He was muttering, as if talking only to himself.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu ta lẩm bẩm, như thể đang tự nói với \n"
"chính mình.\n"
"<CLT>"

#. <CLT 4>そして、ボクの返事も待たずに、
#. 女子更衣室のドアに手をかけた…
#. <CLT>
msgctxt "0029 | BYAKUYA TOGAMI"
msgid ""
"<CLT 4>Without waiting for a reply, he pressed his hand\n"
"against the girls locker room door...\n"
"<CLT>"
msgstr ""
"<CLT 4>Chẳng đợi mình trả lời, cậu ta đã đặt tay lên cánh cửa\n"
"phòng thay đồ nữ...\n"
"<CLT>"

#. <CLT 4>ドアは音もなくゆっくりと開き…
#. <CLT>
msgctxt "0030 | BYAKUYA TOGAMI"
msgid ""
"<CLT 4>...and the door swung open without a sound.\n"
"<CLT>"
msgstr ""
"<CLT 4>...và cánh cửa chậm rãi mở ra mà không hề phát ra\n"
"tiếng động.\n"
"<CLT>"

#. <CLT 4>そこで…時が止まった。
#. <CLT>
msgctxt "0031 | MAKOTO NAEGI"
msgid ""
"<CLT 4>In that moment, time seemed to freeze.\n"
"<CLT>"
msgstr ""
"<CLT 4>Vào khoảnh khắc đó, thời gian như thể ngừng trôi.\n"
"<CLT>"

#. え………………？
msgctxt "0032 | MAKOTO NAEGI"
msgid "What...?"
msgstr "Cái gì...?"

#. <CLT 4>その光景を、現実のものとして認識するまで、
#. しばらくの時間が必要だった。
#. <CLT>
msgctxt "0033 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I don't know how long it took for me to fully\n"
"comprehend the reality of what I was looking at.\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình chẳng rõ đã mất bao lâu để mình hoàn toàn nhận thức\n"
"được thực tại của những gì mình đang nhìn thấy.\n"
"<CLT>"

#. <CLT 4>そして、その認識が行われた後…
#. <CLT>
msgctxt "0034 | MAKOTO NAEGI"
msgid ""
"<CLT 4>But as soon as I did...\n"
"<CLT>"
msgstr ""
"<CLT 4>Nhưng ngay khi mình nhận thức được điều đó...\n"
"<CLT>"

#. うわぁぁあああああああああああああッ！！
msgctxt "0035 | MAKOTO NAEGI"
msgid "UwaaaaaaAAAAAAHHH!!!"
msgstr "U QUaaaaaAAAAAAAAHHHH!!!"

#. <CLT 4>ボクの口からは、
#. 自然と叫び声が溢れ出していた…
#. <CLT>
msgctxt "0036 | MAKOTO NAEGI"
msgid ""
"<CLT 4>A wild, almost primeval scream escaped from my mouth.\n"
"<CLT>"
msgstr ""
"<CLT 4>Một tiếng hét dữ dội, gần như thuần khiết đã thoát ra\n"
"khỏi miệng tôi.\n"
"<CLT>"


────────────────────────────────────────────────────────────────────────
  CHAPTER  e02_027_029 Chihiro Body Discovery
────────────────────────────────────────────────────────────────────────

  [ERROR]  e02_027_029
    ✗ msgid ""
msgstr ""
"Project-Id-Version: DR1 (PC)\n"
"Report-Msgid-Bugs-To: your_email\n"
"POT-Creation-Date: 3/26/2026\n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: en_US\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Generator: Poedit 3.8\n"

#. <CLT 4>いくら抑え付けようとしても、
#. 無駄だった。
#. <CLT>
msgctxt "0001 | MAKOTO NAEGI"
msgid "<CLT 4>I tried to suppress my screaming, but it was useless.\n<CLT>"
msgstr ""
msgid ""
"<CLT 4>I tried to suppress my screaming, but it was useless.\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình đã cố kìm nén tiếng hét của mình, nhưng vô ích.\n"
"<CLT>"

#. <CLT 4>地下から噴き出す湧水のように、
#. ボクの叫び声は、とめどなく溢れ出していた。
#. <CLT>
msgctxt "0002 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It surged out of me, like water from a spring gushing\n"
"out of the ground.\n"
"<CLT>"
msgstr ""
"<CLT 4>Nó trào dâng trong mình, như dòng nước suối tuôn ra từ lòng đất.\n"
"<CLT>"

#. <CLT 4>けど、そんなボクとは対照的に…
#. <CLT>
msgctxt "0003 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Byakuya, on the other hand...\n"
"<CLT>"
msgstr ""
"<CLT 4>Ngược lại, Byakuya thì...\n"
"<CLT>"

#. こいつは妙だな…
#. お前もそう思うだろ？
msgctxt "0004 | BYAKUYA TOGAMI"
msgid "Most unusual, don't you think...?"
msgstr "Thật quá bất thường, cậu có nghĩ vậy không...?"

#. <CLT 4>十神クンは、テレビの向こうの話でもしているみたいに
#. どこまでも冷静だった…
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>He was totally calm. Almost like he was watching this\n"
"all unfold in front of a TV screen.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu ta hoàn toàn bình tĩnh. Gần như thể cậu ta đang theo\n"
"dõi mọi chuyện diễn ra qua màn hình tivi vậy.\n"
"<CLT>"

#. 見ろ、不二咲千尋の死体は<CLT 3>“ハリツケ”<CLT>にされている。
#. それに…
msgctxt "0006 | BYAKUYA TOGAMI"
msgid "Look. Chihiro's corpse has been <CLT 3>suspended<CLT> somehow."
msgstr "Nhìn đi. Xác của Chihiro đã bị <CLT 3>treo lên<CLT> theo cách nào đó."

#. あの壁面に書かれた血文字…
msgctxt "0007 | BYAKUYA TOGAMI"
msgid "And something's been written on the wall, in blood..."
msgstr "Và có gì đó được viết trên tường bằng máu..."

#. <CLT 3>“チミドロフィーバー”<CLT>だと？
msgctxt "0008 | BYAKUYA TOGAMI"
msgid "\"<CLT 3>Bloodlust<CLT>\"?"
msgstr "\"<CLT 3>Bloodlust<CLT>\" sao?"

#. なんとも惨い殺し方…
#. いや、惨すぎる殺し方だ。
msgctxt "0009 | BYAKUYA TOGAMI"
msgid ""
"Such a brutal way to kill someone... No, this is\n"
"beyond brutal."
msgstr ""
"Thật là một cách giết người tàn bạo... Không, chuyện này\n"
"còn vượt xa cả sự tàn bạo."

#. そうは思わんか？
msgctxt "0010 | BYAKUYA TOGAMI"
msgid "Wouldn't you agree?"
msgstr "Cậu cũng đồng ý chứ?"

#. ひ、人が死んでるんだよ…
#. 惨くない訳が…
msgctxt "0011 | MAKOTO NAEGI"
msgid "They killed her. How could it *not* be brutal?"
msgstr "Chúng đã giết cậu ấy. Sao có thể *không* tàn bạo được chứ?"

#. …そういう事を言ってるんじゃない。
msgctxt "0012 | BYAKUYA TOGAMI"
msgid "No, that's not my point."
msgstr "Không, đó không phải ý tôi."

#. この殺人は、素人がやったにしては、
#. <CLT 3>猟奇的<CLT>過ぎるんだよ。
msgctxt "0013 | BYAKUYA TOGAMI"
msgid ""
"This murder is far too <CLT 3>bizarre<CLT> for any everyday\n"
"amateur to have committed it."
msgstr ""
"Vụ giết người này quá <CLT 3>quái đản<CLT> đối với bất kỳ kẻ nghiệp\n"
"dư thông thường nào."

#. 舞園さやかの時のように、
#. 誰かが仕方なく殺人に及んだという訳ではなさそうだ。
msgctxt "0014 | BYAKUYA TOGAMI"
msgid ""
"Unlike with Sayaka, this murder was not a crime of\n"
"passion or necessity."
msgstr ""
"Khác với vụ của Sayaka, vụ giết người này không phải là\n"
"hành động bộc phát hay do tình thế bắt buộc."

#. まるで<CLT 3>快楽殺人<CLT>のようだ。
#. そう思わないか？
msgctxt "0015 | BYAKUYA TOGAMI"
msgid ""
"It's almost as if whoever did this...<CLT 3>did it for fun<CLT>.\n"
"You see what I mean, don't you?"
msgstr ""
"Gần như thể kẻ làm chuyện này... <CLT 3>làm vậy vì khoái lạc<CLT>.\n"
"Cậu hiểu ý tôi mà, đúng không?"

#. …え？
msgctxt "0016 | MAKOTO NAEGI"
msgid "...What?"
msgstr "...Cái gì?"

#. <CLT 4>彼が何を言わんとしているのか…
#. 混乱したボクの頭では、すぐには理解出来なかった。
#. <CLT>
msgctxt "0017 | MAKOTO NAEGI"
msgid ""
"<CLT 4>My head was swimming. I was still reeling, too\n"
"confused to understand what he was trying to say.\n"
"<CLT>"
msgstr ""
"<CLT 4>Đầu óc mình quay cuồng. Mình vẫn còn choáng váng và quá\n"
"bối rối để hiểu được những gì cậu ta đang cố nói.\n"
"<CLT>"

#. <CLT 4>そして…そんな時間も与えられなかった…
#. <CLT>
msgctxt "0018 | MAKOTO NAEGI"
msgid ""
"<CLT 4>And before I could even begin to clear my head...\n"
"<CLT>"
msgstr ""
"<CLT 4>Và trước khi mình kịp lấy lại bình tĩnh...\n"
"<CLT>"

#. おい、悲鳴が聞こえたが何か……
msgctxt "0019 | KIYOTAKA ISHIMARU"
msgid "Hey, I heard screaming! Did something—?"
msgstr "Này, tôi nghe thấy tiếng hét! Có chuyện gì—?"

#. …ああああああああああッ！？
#. 不二咲くんッ！？
msgctxt "0020 | KIYOTAKA ISHIMARU"
msgid "...AAAAAAAAHH! Chihiro!?"
msgstr "...AAAAAAAAHH! Chihiro!?"

#. <CLT 23>「ピンポンパンポーン…！」
#. <CLT>
msgctxt "0021 | NARRATION"
msgid ""
"<CLT 23>*Ding dong, ding dong*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Bính bong, binh bong*\n"
"<CLT>"

#. 死体が発見されました！
msgctxt "0022 | MONOKUMA"
msgid "A body has been discovered!"
msgstr "Một thi thể đã được phát hiện!"

#. 一定の自由時間の後、<CLT 3>『学級裁判』<CLT>を開きまーす！
msgctxt "0023 | MONOKUMA"
msgid ""
"After a certain amount of time, which you may use\n"
"however you like, the <CLT 3>class trial<CLT> will begin!"
msgstr ""
"Sau một khoảng thời gian nhất định mà các em có thể sử\n"
"dụng tùy thích, <CLT 3>lớp xét xử<CLT> sẽ bắt đầu!"

#. い、今のって…？
msgctxt "0024 | MAKOTO NAEGI"
msgid "What the hell was that...?"
msgstr "Cái quái gì vậy...?"

#. そうか…舞園の時は、
#. お前は気を失っていたから知らんのか…
msgctxt "0025 | BYAKUYA TOGAMI"
msgid ""
"Ah, that's right. You were unconscious during\n"
"Sayaka's, so you don't know about it."
msgstr ""
"À, phải rồi. Cậu đã bất tỉnh trong vụ của Sayaka, nên\n"
"cậu không biết về nó."

#. あれは、<CLT 3>死体発見アナウンス<CLT>…
msgctxt "0026 | BYAKUYA TOGAMI"
msgid ""
"What you just heard was the <CLT 3>body discovery\n"
"announcement<CLT>."
msgstr "Thứ cậu vừa nghe thấy là <CLT 3>thông báo phát hiện thi thể<CLT>."

#. <CLT 3>３人以上の人間<CLT>が死体を発見すると、
#. あのアナウンスを流して、全員に知らせるらしい。
msgctxt "0027 | BYAKUYA TOGAMI"
msgid ""
"Apparently, when <CLT 3>three or more people<CLT> discover a\n"
"body, an announcement plays to let everyone know."
msgstr ""
"Có vẻ là, khi có từ <CLT 3>ba người trở lên<CLT> phát hiện ra thi\n"
"thể, một thông báo sẽ vang lên để cho mọi người biết."

#. 犯人当てを、公平に進める為のものらしいな。
msgctxt "0028 | BYAKUYA TOGAMI"
msgid ""
"I imagine it's so that the search for the culprit can\n"
"proceed fairly for everyone involved."
msgstr ""
"Tôi đoán là để việc tìm kiếm hung thủ có thể diễn ra\n"
"công bằng cho tất cả những người liên quan."

#. <CLT 4>犯人当てを…公平って…
#. <CLT>
msgctxt "0029 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Proceed...fairly?\n"
"<CLT>"
msgstr ""
"<CLT 4>Diễn ra... công bằng sao?\n"
"<CLT>"

#. 死体発見アナウンスって！
#. じゃあ、不二咲くんはッ！？
msgctxt "0030 | KIYOTAKA ISHIMARU"
msgid ""
"The body discovery announcement!? Then Chihiro really\n"
"is...?"
msgstr "Thông báo phát hiện thi thể sao!? Vậy Chihiro thực sự là...?"

#. そうだ。死んでいる。
msgctxt "0031 | BYAKUYA TOGAMI"
msgid "Dead, yes."
msgstr "Chết rồi, đúng vậy."

#. しっ、しっ、しっ、しっ…！！
msgctxt "0032 | KIYOTAKA ISHIMARU"
msgid "D-D-D-D—!"
msgstr "C-C-C-Chết—!"

#. …叫ぶ前に、全員をかき集めて来い。
#. どうやら、また始まるみたいだからな。
msgctxt "0033 | BYAKUYA TOGAMI"
msgid ""
"Before you start screaming your head off, go round\n"
"everyone up. It seems another game has begun."
msgstr ""
"Trước khi cậu hét toáng lên, hãy đi tập hợp mọi người\n"
"lại đi. Có vẻ một trò chơi khác đã bắt đầu rồi."

#. 命がけの…犯人当てゲームが……
msgctxt "0034 | BYAKUYA TOGAMI"
msgid "Another life-or-death game to uncover a killer..."
msgstr "Một trò chơi sinh tử khác để lột mặt nạ kẻ sát nhân..."

#. <CLT 4>すぐに、石丸クンは更衣室を飛び出した…
#. <CLT>
msgctxt "0035 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Taka bolted out of the locker room.\n"
"<CLT>"
msgstr ""
"<CLT 4>Taka lao ra khỏi phòng thay đồ.\n"
"<CLT>"

#. <CLT 4>他のみんなが集まるのに
#. 時間はかからなかった…と思う。
#. <CLT>
msgctxt "0036 | MAKOTO NAEGI"
msgid ""
"<CLT 4>As everyone made their way to the scene, it felt as if\n"
"no time at all passed.\n"
"<CLT>"
msgstr ""
"<CLT 4>Khi mọi người tiến về phía hiện trường, cảm giác như thể\n"
"không hề có thời gian trôi qua vậy.\n"
"<CLT>"

#. <CLT 4>その時のボクからは、
#. 時間の感覚なんて吹き飛んでしまっていた…
#. <CLT>
msgctxt "0037 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It was like my sense of time had just...taken wing and\n"
"flown away.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cứ như thể cảm giác về thời gian của mình đã... mọc cánh\n"
"và bay mất.\n"
"<CLT>"

#. <CLT 4>…とにかく、気付いた時には、
#. 困惑と恐怖と怒りの表情を露わにしたみんなが…
#. <CLT>
msgctxt "0038 | MAKOTO NAEGI"
msgid ""
"<CLT 4>When I finally came back to myself, I saw everyone had\n"
"the same look of confusion, fear, and anger.\n"
"<CLT>"
msgstr ""
"<CLT 4>Khi mình cuối cùng cũng tỉnh táo lại, mình thấy mọi\n"
"người đều cùng chung một vẻ bối rối, sợ hãi và giận dữ.\n"
"<CLT>"

#. <CLT 4>不二咲さんを取り囲むようにして、
#. その場に立ち尽くしていたんだ。
#. <CLT>
msgctxt "0039 | MAKOTO NAEGI"
msgid ""
"<CLT 4>We all just stood there, gathered around Chihiro's\n"
"body.\n"
"<CLT>"
msgstr ""
"<CLT 4>Tất cả chúng mình chỉ đứng đó, vây quanh xác của Chihiro.\n"
"<CLT>"

#. おのれ…守れなかったか…！
msgctxt "0040 | SAKURA OOGAMI"
msgid "Damn... I couldn't keep her safe...!"
msgstr "Chết tiệt... Tôi đã không thể bảo vệ cậu ấy!"

#. またしても…犠牲者が出てしまった…
msgctxt "0041 | KIYOTAKA ISHIMARU"
msgid "So there's another victim..."
msgstr "Vậy là lại có thêm một nạn nhân nữa..."

#. …という事は、また始まるのですね。
msgctxt "0042 | CELES"
msgid ""
"Which means we are now in the same position\n"
"once again."
msgstr ""
"Điều đó có nghĩa là chúng ta lại rơi vào hoàn cảnh tương\n"
"tự một lần nữa."

#. つ、つーかよぉ…
msgctxt "0043 | MONDO OOWADA"
msgid "Fuck, man..."
msgstr "Mẹ nó..."

#. なんなんだよ、コレはッ！！
msgctxt "0044 | MONDO OOWADA"
msgid "What the fuck IS this!?"
msgstr "Cái quái gì THẾ NÀY!?"

#. 夢だ…これは夢なんだ！　すべてが夢なんだッ！！
msgctxt "0045 | HIFUMI YAMADA"
msgid ""
"It's a dream... This is a dream! It's all just a\n"
"dream!"
msgstr "Mơ thôi... Đây là một giấc mơ! Tất cả chỉ là một giấc mơ thôi!"

#. そうだ、そもそも僕はまだ生まれてすらないんだ！
#. 生まれた時の記憶だってないし…
msgctxt "0046 | HIFUMI YAMADA"
msgid ""
"In fact, I haven't even been born yet! I don't have\n"
"any memory of ever being alive!"
msgstr ""
"Thực ra, tôi thậm chí còn chưa được sinh ra nữa! Tôi\n"
"không có bất kỳ ký ức nào về việc mình từng tồn tại cả!"

#. オギャア！！
msgctxt "0047 | HIFUMI YAMADA"
msgid "Ugyaaaah!"
msgstr "Ugyaaaah!"

#. うるさいですわよ…
msgctxt "0048 | CELES"
msgid "Shut up."
msgstr "Im đi."

#. まさか、我も利用するこの女子更衣室で…
#. 不二咲が殺されたとはな…
msgctxt "0049 | SAKURA OOGAMI"
msgid ""
"I use this locker room all the time. Now...it's become\n"
"the site of Chihiro's death."
msgstr ""
"Tôi sử dụng phòng thay đồ này suốt. Giờ thì... nó đã trở\n"
"thành nơi Chihiro trút hơi thở cuối cùng."

#. でも、不二咲さんは、
#. どうして更衣室なんかで殺されたのかな…
msgctxt "0050 | MAKOTO NAEGI"
msgid "But...why was she killed in the locker room?"
msgstr "Nhưng... tại sao cậu ấy lại bị giết trong phòng thay đồ?"

#. いや、殺された後に運ばれて来たって可能性も
#. あるかもしれないけど…
msgctxt "0051 | MAKOTO NAEGI"
msgid ""
"Actually, if you think about it, she could have been\n"
"killed somewhere else, then carried here."
msgstr ""
"Thực ra, nếu nghĩ kỹ lại, cậu ấy có thể đã bị giết ở đâu\n"
"đó khác, rồi mới được đưa đến đây."

#. 確かに、あいつの体重は軽い。
#. 殺された後に運ばれたとしても不思議ではないが…
msgctxt "0052 | SAKURA OOGAMI"
msgid ""
"She was very light, that is true. It wouldn't be hard\n"
"for someone to carry her. But still..."
msgstr ""
"Cậu ấy rất nhẹ, đó là sự thật. Việc ai đó mang cậu ấy đi\n"
"không hề khó. Nhưng dù vậy..."

#. 我は、あいつは<CLT 3>自らの足でこの場所に来た<CLT>のだと思う…
msgctxt "0053 | SAKURA OOGAMI"
msgid "I still think <CLT 3>she came here on her own, by choice<CLT>."
msgstr ""
"Tôi vẫn nghĩ <CLT 3>cậu ấy đã tự mình đến đây, theo lựa chọn\n"
"của bản thân<CLT>."

#. …どうして、そう思うの？
msgctxt "0054 | MAKOTO NAEGI"
msgid "What makes you say that?"
msgstr "Điều gì khiến cậu nói vậy?"

#. あいつは、ここ最近、
#. 体を鍛えたいとよく口にしていた…
msgctxt "0055 | SAKURA OOGAMI"
msgid ""
"She'd been talking a lot lately about how she wanted\n"
"to get stronger."
msgstr ""
"Dạo gần đây cậu ấy nói rất nhiều về việc bản thân muốn\n"
"trở nên mạnh mẽ hơn."

#. じゃあ、不二咲さんはトレーニングする為に、
#. 女子更衣室を訪れたの？
msgctxt "0056 | MAKOTO NAEGI"
msgid "So you're saying she came here to exercise?"
msgstr "Nên cậu cho rằng cậu ấy đến đây để tập luyện sao?"

#. でもさ、このモノクマファイルによると、
#. 不二咲さんは<CLT 3>“午前２時頃”<CLT>に殺されたみたいだよ…
msgctxt "0057 | MAKOTO NAEGI"
msgid ""
"But according to the Monokuma File, apparently she was\n"
"killed around <CLT 3>two in the morning<CLT>."
msgstr ""
"Nhưng theo Hồ sơ Monokuma, có vẻ cậu ấy bị giết vào\n"
"khoảng <CLT 3>hai giờ sáng<CLT>."

#. そんな時間に…トレーニング？
msgctxt "0058 | MAKOTO NAEGI"
msgid "Would she really have been exercising that late?"
msgstr "Liệu cậu ấy có thực sự tập luyện muộn đến vậy không?"

#. 昼間は、我や朝日奈がここにいる事が多い。
#. それを避けたのだろう…
msgctxt "0059 | SAKURA OOGAMI"
msgid ""
"Hina or myself are usually in the locker room during\n"
"the day. So she was probably avoiding it then."
msgstr ""
"Hina hoặc tôi thường ở trong phòng thay đồ vào ban ngày.\n"
"Nên có lẽ cậu ấy đã tránh lúc đó."

#. …避けた？
msgctxt "0060 | MAKOTO NAEGI"
msgid "Avoiding it...?"
msgstr "Tránh sao...?"

#. あいつは、我や朝日奈が何度誘っても、
#. 一緒にトレーニングをしようとはしなかった。
msgctxt "0061 | SAKURA OOGAMI"
msgid ""
"Although we invited her to join us more than once, she\n"
"never showed up."
msgstr ""
"Dù chúng tôi đã mời cậu ấy tham gia không chỉ một lần,\n"
"cậu ấy chưa bao giờ xuất hiện."

#. 我らと一緒になるのを、
#. 避けていたとしか思えん。
msgctxt "0062 | SAKURA OOGAMI"
msgid "So I can only assume she was trying to avoid us."
msgstr "Nên tôi chỉ có thể giả định rằng cậu ấy đang cố tránh chúng tôi."

#. それで…深夜に１人でこっそりトレーニングしようと？
msgctxt "0063 | MAKOTO NAEGI"
msgid ""
"And instead, she came to exercise in the middle of the\n"
"night?"
msgstr "Và thay vào đó, cậu ấy đến tập luyện vào giữa đêm sao?"

#. されど、１人でというのも考えにくいのだ…
msgctxt "0064 | SAKURA OOGAMI"
msgid ""
"Perhaps. But it's difficult for me to imagine she\n"
"would have come alone."
msgstr ""
"Có lẽ vậy. Nhưng thật khó để tôi hình dung được việc cậu\n"
"ấy sẽ đi một mình."

#. 不二咲はトレーニングを始めたがっていたが、
#. 自分１人では出来ないと口にしていた。
msgctxt "0065 | SAKURA OOGAMI"
msgid ""
"She did want to start exercising, but she specifically\n"
"mentioned she couldn't do it by herself."
msgstr ""
"Cậu ấy thực sự muốn bắt đầu tập luyện, nhưng cậu ấy đã\n"
"nói rằng mình không thể làm điều đó một mình."

#. <CLT 3>誰かに手伝って<CLT>もらいたいと…
msgctxt "0066 | SAKURA OOGAMI"
msgid "She needed <CLT 3>support from others<CLT>."
msgstr "Cậu ấy cần <CLT 3>sự hỗ trợ từ người khác<CLT>."

#. つまり、不二咲さんは深夜に、
#. こっそりトレーニングする為に更衣室を訪れた…
msgctxt "0067 | MAKOTO NAEGI"
msgid ""
"So you're saying she could have come here in the\n"
"middle of the night to train in secret..."
msgstr ""
"Vậy cậu nói rằng cậu ấy có thể đã đến đây vào giữa đêm\n"
"để tập luyện bí mật..."

#. しかも、１人じゃなく誰かと…
msgctxt "0068 | MAKOTO NAEGI"
msgid ""
"...but that she also would have come with someone\n"
"else."
msgstr "...và cậu ấy cũng sẽ đi cùng với ai đó khác."

#. その可能性も…あるのかもしれん。
msgctxt "0069 | SAKURA OOGAMI"
msgid "It's a possibility, I think."
msgstr "Tôi nghĩ đó là một khả năng."

#. <CLT 23><CLT><CLT 3>大神の証言<CLT><CLT 23>を手帳に記録しました。
#. 言弾（コトダマ）メニューで確認できます。
#. <CLT>
msgctxt "0070 | NARRATION"
msgid ""
"<CLT 23>\"<CLT><CLT 3>Sakura's Account<CLT><CLT 23>\" has been added to the Truth\n"
"Bullets section of your handbook.\n"
"<CLT>"
msgstr ""
"<CLT 23>\"<CLT><CLT 3>Lời khai của Sakura<CLT><CLT 23>\" đã được thêm vào mục Đạn Sự Thật\n"
"trong sổ học sinh của bạn.\n"
"<CLT>"

#. ………………
msgctxt "0071 | KYOUKO KIRIGIRI"
msgid "..."
msgstr "..."

#. <CLT 4>不二咲さんの死体をじっくりと調べ回っている。
#. しかも…
#. <CLT>
msgctxt "0072 | MAKOTO NAEGI"
msgid ""
"<CLT 4>She took her time examining Chihiro's corpse.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu ấy dành thời gian để kiểm tra xác của Chihiro.\n"
"<CLT>"

#. <CLT 4>死体を…べたべたと触って…
#. <CLT>
msgctxt "0073 | MAKOTO NAEGI"
msgid ""
"<CLT 4>She poked and prodded, going over every inch of the\n"
"lifeless body.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu ấy săm soi và sờ nắn, xem xét từng li từng tí trên\n"
"cái xác vô hồn.\n"
"<CLT>"

#. 妙な女だな…平気な顔をして死体に触れるとは…
msgctxt "0074 | BYAKUYA TOGAMI"
msgid ""
"You're a very strange woman, you know, being able to\n"
"touch a dead body with absolutely no trouble."
msgstr ""
"Cô đúng là một người phụ nữ kỳ quặc, biết chứ, khi có thể chạm\n"
"vào xác chết mà hoàn toàn không gặp chút vấn đề gì."

#. ………………
msgctxt "0075 | KYOUKO KIRIGIRI"
msgid "..."
msgstr "..."

#. <CLT 4>かなり集中…してるみたいだ。
#. ボクらの会話も耳に入ってないみたいだし…
#. <CLT>
msgctxt "0076 | MAKOTO NAEGI"
msgid ""
"<CLT 4>She seems to be concentrating pretty hard. It's like\n"
"she can't even hear us.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu ấy có vẻ đang tập trung rất cao độ. Cứ như thể cậu\n"
"ấy thậm chí không nghe thấy chúng mình nói gì vậy.\n"
"<CLT>"

#. アイツは…自分の<CLT 3>“弱さ”<CLT>に、
#. でっけぇコンプレックスがあるみてーだった。
msgctxt "0077 | MONDO OOWADA"
msgid "Dude had a real complex about being <CLT 3>weak<CLT>."
msgstr ""
"Thằng này thực sự bị ám ảnh về việc bản thân \n"
"<CLT 3>yếu đuối<CLT>."

#. オメェも聞いただろ？
#. アイツが『もっと強くならなきゃ』って言ってんのを…
msgctxt "0078 | MONDO OOWADA"
msgid ""
"You heard Chihiro talk about it, right? All \"I need to\n"
"get stronger!\""
msgstr ""
"Mày cũng nghe Chihiro nói về chuyện đó rồi mà, đúng\n"
"không? Kiểu \"Tôi cần phải trở nên mạnh mẽ hơn!\" ấy."

#. 確かに、そう言ってたね…
msgctxt "0079 | MAKOTO NAEGI"
msgid "Yeah, I do remember she said that more than once..."
msgstr "Ờ, tớ có nhớ cậu ấy đã nói vậy không chỉ một lần..."

#. アイツ…体を鍛えて強くなろうとしてたんだ…
#. それで…ここに…
msgctxt "0080 | MONDO OOWADA"
msgid ""
"Sure did. Which...I guess explains the trip down\n"
"here..."
msgstr ""
"Chắc chắn rồi. Cái đó... tao đoán là nó giải thích cho\n"
"chuyến đi xuống đây..."

#. でもさ、そもそも、
#. 強くなる必要なんてあったのかな？
msgctxt "0081 | MAKOTO NAEGI"
msgid "But...did she really need to get stronger that badly?"
msgstr ""
"Nhưng... cậu ấy có thực sự cần phải trở nên mạnh mẽ đến\n"
"mức đó không?"

#. 大和田クンも言ってたけど、
#. 女の子なんだから、弱くて当たり前なんだし…
msgctxt "0082 | MAKOTO NAEGI"
msgid ""
"You already mentioned it, but...she *was* a girl,\n"
"after all. Most girls aren't all that strong."
msgstr ""
"Cậu cũng đã đề cập đến rồi mà... dù sao cậu ấy *vẫn* là một cô\n"
"gái. Hầu hết con gái đều không khỏe đến mức đó đâu."

#. さぁな…そこまではわかんねーよ…
msgctxt "0083 | MONDO OOWADA"
msgid "I dunno, man. Haven't really thought about that stuff."
msgstr "Tao không biết nữa. Tao cũng chưa thực sự nghĩ về mấy cái đó."

#. <CLT 4>不二咲さんの<CLT><CLT 3>コンプレックスの原因<CLT><CLT 4>か…
#. <CLT>
msgctxt "0084 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The cause of <CLT><CLT 3>Chihiro's complex<CLT><CLT 4>...\n"
"<CLT>"
msgstr ""
"<CLT 4>Nguyên nhân dẫn đến <CLT><CLT 3>nỗi ám ảnh của Chihiro<CLT><CLT 4>...\n"
"<CLT>"

#. <CLT 4>なんか…ちょっと気になるな…
#. <CLT>
msgctxt "0085 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I can't help wondering what it might be.\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình không thể ngừng thắc mắc đó có thể là gì.\n"
"<CLT>"

#. <CLT 23><CLT><CLT 3>大和田の証言<CLT><CLT 23>を手帳に記録しました。
#. 言弾（コトダマ）メニューで確認できます。
#. <CLT>
msgctxt "0086 | NARRATION"
msgid ""
"<CLT 23>\"<CLT><CLT 3>Mondo's Account<CLT><CLT 23>\" has been added to the Truth\n"
"Bullets section of your handbook.\n"
"<CLT>"
msgstr ""
"<CLT 23>\"<CLT><CLT 3>Lời Khai Của Mondo<CLT><CLT 23>\" đã được thêm vào mục Đạn Sự Thật\n"
"trong sổ học sinh của bạn.\n"
"<CLT>"

#. …無駄話をしているヒマがあるなら、
#. さっさと捜査をしろ。
msgctxt "0087 | BYAKUYA TOGAMI"
msgid ""
"If you have time to talk, you have time to start\n"
"investigating."
msgstr ""
"Nếu cậu có thời gian để tán gẫu, thì cậu có thời gian để\n"
"bắt đầu điều tra rồi đấy."

#. <CLT 4>モノクマが写るモニター…
#. こんな物を気にしている場合じゃない！
#. <CLT>
msgctxt "0088 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is one of the monitors Monokuma appears on. Now's\n"
"no time to think about it...!\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là một trong những chiếc màn hình mà Monokuma xuất\n"
"hiện. Bây giờ không phải lúc để nghĩ về nó nữa!\n"
"<CLT>"

#. <CLT 4>監視カメラ…
#. <CLT>
msgctxt "0089 | MAKOTO NAEGI"
msgid ""
"<CLT 4>A surveillance camera...\n"
"<CLT>"
msgstr ""
"<CLT 4>Một chiếc camera giám sát...\n"
"<CLT>"

#. <CLT 4>黒幕は監視カメラで見ていたはずだ。
#. 不二咲さんが殺されたところも…
#. <CLT>
msgctxt "0090 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The mastermind must have been watching as Chihiro was\n"
"killed...\n"
"<CLT>"
msgstr ""
"<CLT 4>Kẻ chủ mưu chắc hẳn đã đứng xem khi Chihiro bị giết...\n"
"<CLT>"

#. <CLT 4>黒幕はそれを知った上で…
#. ボクらにこんな事をさせているのか…！
#. <CLT>
msgctxt "0091 | MAKOTO NAEGI"
msgid ""
"<CLT 4>They know what's happened, and they're still forcing\n"
"us to go through with this...!\n"
"<CLT>"
msgstr ""
"<CLT 4>Hắn ta biết chuyện gì đã xảy ra, vậy mà vẫn ép chúng\n"
"mình phải trải qua chuyện này!\n"
"<CLT>"

#. <CLT 4><CLT 4>壁に血文字で、<CLT><CLT 3>“チミドロフィーバー”<CLT><CLT 4>って、
#. 書いてある…
#. <CLT>
msgctxt "0092 | MAKOTO NAEGI"
msgid ""
"<CLT 4><CLT 4>The word \"<CLT><CLT 3>bloodlust<CLT><CLT 4>\" is written on the wall in\n"
"blood...\n"
"<CLT>"
msgstr ""
"<CLT 4><CLT 4>Từ \"<CLT><CLT 3>bloodlust<CLT><CLT 4>\" được viết trên tường bằng máu...\n"
"<CLT>"

#. ダイイングメッセージとも違うわね…
msgctxt "0093 | KYOUKO KIRIGIRI"
msgid "I don't think it's any kind of dying message."
msgstr "Tớ không nghĩ đó là một dạng tin nhắn tuyệt mệnh đâu."

#. 異様…過ぎるわ……
msgctxt "0094 | KYOUKO KIRIGIRI"
msgid "It's just too...strange..."
msgstr "Nó chỉ là quá... kỳ lạ..."

#. というか、血文字で“チミドロフィーバー”って…
#. 何か聞いた事がないか？
msgctxt "0095 | KIYOTAKA ISHIMARU"
msgid ""
"But you know...that thing about writing \"bloodlust\" in\n"
"blood... Doesn't it sound kinda familiar?"
msgstr ""
"Nhưng mọi người biết đấy... cái việc viết từ \"khát máu\"\n"
"bằng máu... Nghe nó có vẻ hơi quen thuộc đúng không?"

#. 猟奇的かつ残忍な手口で殺人を繰り返す、
#. 凶悪殺人鬼…
msgctxt "0096 | BYAKUYA TOGAMI"
msgid ""
"A murderous fiend, who kills again and again using a\n"
"bizarre and brutal method..."
msgstr ""
"Một ác quỷ giết người, kẻ sát hại hết lần này đến lần\n"
"khác bằng một phương thức quái đản và tàn bạo..."

#. 現場には必ず被害者本人の血で
#. <CLT 3>“チミドロフィーバー”<CLT>の血文字を残す。
msgctxt "0097 | BYAKUYA TOGAMI"
msgid ""
"And at the scene of each crime, the word \"<CLT 3>bloodlust<CLT>\"\n"
"is written in the victim's own blood."
msgstr ""
"Và tại hiện trường mỗi vụ án, từ \"<CLT 3>khát máu<CLT>\" được viết\n"
"bằng chính máu của nạn nhân."

#. 通り魔的かつ無差別的で突発的な犯行ばかりゆえ、
#. 警察もその足取りを掴めていない状態…
msgctxt "0098 | BYAKUYA TOGAMI"
msgid ""
"They're like a ghost, attacking suddenly then slipping\n"
"away before the police can catch up to them."
msgstr ""
"Hắn như một bóng ma, tấn công bất ngờ rồi tẩu thoát\n"
"trước khi cảnh sát kịp đuổi tới."

#. そんな連続殺人事件の容疑者に、
#. ネット上で与えられたあだ名が…
msgctxt "0099 | BYAKUYA TOGAMI"
msgid ""
"And what nickname did the Internet give to this\n"
"mysterious serial killer?"
msgstr ""
"Và cư dân mạng đã đặt biệt danh gì cho tên sát nhân hàng\n"
"loạt bí ẩn này?"

#. …ジェノサイダー翔だべッ！！
msgctxt "0100 | YASUHIRO HAGAKURE"
msgid "Genocide Jack!"
msgstr "Jack Đồ Tể!"

#. <CLT 4><CLT><CLT 3>ジェノサイダー翔<CLT><CLT 4>…
#. 巷をにぎわしている凶悪殺人鬼…
#. <CLT>
msgctxt "0101 | MAKOTO NAEGI"
msgid ""
"<CLT 4><CLT><CLT 3>Genocide Jack<CLT><CLT 4>... The \"murderous fiend\" whose grisly\n"
"attacks were famous all across the country.\n"
"<CLT>"
msgstr ""
"<CLT 4><CLT><CLT 3>Jack Đồ Tể<CLT><CLT 4>... \"Ác quỷ giết người\" mà những cuộc tấn công\n"
"ghê rợn của hắn nổi tiếng khắp cả nước.\n"
"<CLT>"

#. <CLT 4>猟奇的かつ残忍な手口で殺人を繰り返す、
#. 超ド級の…変態殺人鬼……
#. <CLT>
msgctxt "0102 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The Ultimate Murderous Fiend, creating a reputation of\n"
"abnormal, downright cruel killings.\n"
"<CLT>"
msgstr ""
"<CLT 4>Một tên Sát Nhân Siêu Cấp, tạo nên danh tiếng về những\n"
"vụ giết người bất thường, tàn nhẫn đến tột cùng.\n"
"<CLT>"

#. じゃあ、これって…
#. 誰かがジェノサイダー翔の事件を真似たって事…？
msgctxt "0103 | AOI ASAHINA"
msgid ""
"Then this is...some copycat killer trying to imitate\n"
"Genocide Jack's \"style\"?"
msgstr ""
"Vậy đây là... kẻ giết người bắt chước nào đó đang cố mô\n"
"phỏng \"phong cách\" của Đồ Tể Jack sao?"

#. …でも、なんの為に？
msgctxt "0104 | AOI ASAHINA"
msgid "But...why would anyone do that?"
msgstr "Nhưng... tại sao lại có kẻ làm vậy?"

#. あるいは…<CLT 3>本物のジェノサイダー翔<CLT>の仕業か…
msgctxt "0105 | BYAKUYA TOGAMI"
msgid "Perhaps...it's the work of the <CLT 3>real Genocide Jack<CLT>."
msgstr "Có lẽ... đó là tác phẩm của <CLT 3>Jack Đồ Tể thực thụ<CLT>."

#. 本物って…じゃあ、俺らの中にジェノサイダー翔が！？
msgctxt "0106 | YASUHIRO HAGAKURE"
msgid ""
"The real...? Wait, are you saying Genocide Jack is\n"
"here in the school!?"
msgstr ""
"Thực thụ sao...? Đợi đã, ý cậu là Jack Đồ Tể đang ở đây,\n"
"trong ngôi trường này sao!?"

#. そ、そんなのあり得ないよッ！！
msgctxt "0107 | AOI ASAHINA"
msgid "Th-There's no way...!"
msgstr "Kh-Không thể nào...!"

#. それにしても<CLT 3>“チミドロフィーバー”<CLT>とは…
#. びっくりしてしまうほど頭が悪いですわね。
msgctxt "0108 | CELES"
msgid ""
"But going so far as to write <CLT 3>bloodlust<CLT> at the\n"
"scene... I am surprised at their stupidity..."
msgstr ""
"Nhưng cất công viết từ <CLT 3>bloodlust<CLT> tại hiện trường... Tôi\n"
"ngạc nhiên trước sự ngu ngốc của hắn đấy..."

#. だが、頭の悪い人殺しほど厄介な存在もあるまい…
msgctxt "0109 | SAKURA OOGAMI"
msgid ""
"I can't imagine a worse situation than dealing with a\n"
"stupid murderer..."
msgstr ""
"Tôi không thể tưởng tượng nổi một tình huống nào tồi tệ\n"
"hơn việc phải đối phó với một tên sát nhân ngu ngốc..."

#. あ…！
msgctxt "0110 | AOI ASAHINA"
msgid "Ah—!"
msgstr "A—!"

#. 今度は何ッ！？
msgctxt "0111 | HIFUMI YAMADA"
msgid "What is it now!?"
msgstr "Giờ lại chuyện gì nữa!?"

#. 腐川ちゃん…！
msgctxt "0112 | AOI ASAHINA"
msgid "Toko!"
msgstr "Toko!"

#. <CLT 4>と、朝日奈さんが指さした
#. 女子更衣室の入り口には…
#. <CLT>
msgctxt "0113 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Hina was pointing toward the entrance to the girls\n"
"locker room.\n"
"<CLT>"
msgstr ""
"<CLT 4>Hina đang chỉ về phía lối vào phòng thay đồ nữ.\n"
"<CLT>"

#. あ……ああ……
msgctxt "0114 | TOUKO FUKAWA"
msgid "Ah...ahh..."
msgstr "A... aaa..."

#. <CLT 4>遅れてやって来た腐川さんの姿があった。
#. <CLT>
msgctxt "0115 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Toko was the last to arrive, and now she was just\n"
"standing there.\n"
"<CLT>"
msgstr ""
"<CLT 4>Toko là người cuối cùng đến, và giờ cậu ấy chỉ đứng đó.\n"
"<CLT>"

#. …？？？？？
msgctxt "0116 | TOUKO FUKAWA"
msgid "...?"
msgstr "...?"

#. うううううそ……
#. ど、どうして…どうして…？
msgctxt "0117 | TOUKO FUKAWA"
msgid "Nnnnnno... Wh-Why...? Why...?"
msgstr "Khôôôông... T-Tại sao...? Tại sao...?"

#. ど…う……し………て…………
msgctxt "0118 | TOUKO FUKAWA"
msgid "W...h...y...?"
msgstr "T...ạ...i... s...a...o...?"

#. どおしてぇぇぇぇぇぇえええええええッ！！
msgctxt "0119 | TOUKO FUKAWA"
msgid "WHYYYYYYYY!?!?"
msgstr "TẠI SAOOOOO!?!?"

#. <CLT 23>「ゴドンッッ！！」
#. <CLT>
msgctxt "0120 | NARRATION"
msgid ""
"<CLT 23>*GADUNK*\n"
"<CLT>"
msgstr ""
"<CLT 23>*RẦM*\n"
"<CLT>"

#. 倒れたべ！
#. しかも、確実にマズイ音がしたぞ！
msgctxt "0121 | YASUHIRO HAGAKURE"
msgid "She fainted! That did NOT sound good!"
msgstr "Cậu ấy ngất rồi! Tiếng đó nghe không ổn chút nào!"

#. ふ、腐川ちゃん！！
msgctxt "0122 | AOI ASAHINA"
msgid "T-Toko!"
msgstr "T-Toko!"

#. <CLT 4>朝日奈さんは、倒れた腐川さんに慌てて駆け寄ると、
#. 彼女の体を揺すり始めた。
#. <CLT>
msgctxt "0123 | YASUHIRO HAGAKURE"
msgid ""
"<CLT 4>Hina rushed over to the collapsed Toko and started\n"
"trying to shake her awake.\n"
"<CLT>"
msgstr ""
"<CLT 4>Hina lao tới chỗ Toko đang gục xuống và bắt đầu cố gắng\n"
"lắc cho cậu ấy tỉnh lại.\n"
"<CLT>"

#. 腐川ちゃん、大丈夫！？　しっかりしてッ！
msgctxt "0124 | AOI ASAHINA"
msgid "Toko, are you okay!? Come on, wake up!"
msgstr "Toko, cậu ổn không!? Nào, tỉnh lại đi!"

#. そう言えば、彼女は言っておりましたな。
#. 血を見ると気絶してしまうと…
msgctxt "0125 | HIFUMI YAMADA"
msgid ""
"Oh, that's right. I just remembered what she said,\n"
"about how she faints anytime she sees blood."
msgstr ""
"Ồ, phải rồi. Tôi vừa nhớ ra những gì cậu ấy đã nói, về\n"
"việc cậu ấy sẽ ngất xỉu bất cứ khi nào nhìn thấy máu."

#. 血液恐怖症ですか…ホラー映画は見られませんわね。
msgctxt "0126 | CELES"
msgid ""
"So she is hemophobic? I imagine she does not watch too\n"
"many horror films, then."
msgstr ""
"Nên cậu ấy mắc chứng sợ máu sao? Tôi đoán là cậu ấy\n"
"không xem quá nhiều phim kinh dị rồi."

#. つーか、これって大丈夫なんか？
#. 自分の部屋以外での就寝って…校則違反じゃね？
msgctxt "0127 | YASUHIRO HAGAKURE"
msgid ""
"This isn't a violation of the rules, right? I mean,\n"
"technically she passed out somewhere besides her room."
msgstr ""
"Cái này không vi phạm nội quy đấy chứ? Ý tớ là, về mặt kỹ thuật\n"
"thì cậu ấy đã ngất xỉu ở một nơi không phải phòng mình."

#. いや、それは大丈夫なはずだよ…
#. 校則で禁止なのは、<CLT 3>“故意の就寝”<CLT>だったし…
msgctxt "0128 | MAKOTO NAEGI"
msgid ""
"No, I think it should be okay. The regulations\n"
"prohibit \"<CLT 3>sleeping<CLT>.\" Like, on purpose."
msgstr ""
"Không, tớ nghĩ là không sao đâu. Nội quy nghiêm cấm việc\n"
"\"<CLT 3>ngủ<CLT>\". Kiểu như là cố ý ấy."

#. 故意じゃねー、気絶は問題なしって事か。
msgctxt "0129 | YASUHIRO HAGAKURE"
msgid ""
"Ahh, so since she didn't faint on purpose, it doesn't\n"
"count? Gotcha."
msgstr ""
"À, vậy là vì cậu ấy không ngất xỉu có chủ đích, nên\n"
"không bị tính sao? Hiểu rồi."

#. 腐川ちゃーん、聞こえるー！？
#. おーい、しっかりしてー！！
msgctxt "0130 | AOI ASAHINA"
msgid "Toko, can you hear me!? Hey, you gotta wake up!"
msgstr "Toko, cậu có nghe tui nói không!? Này, cậu phải tỉnh lại đi!"

#. <CLT 4>すると、そこで、
#. 朝日奈さんの言葉に応じたかのように…
#. <CLT>
msgctxt "0131 | MAKOTO NAEGI"
msgid ""
"<CLT 4>As if she'd heard her...\n"
"<CLT>"
msgstr ""
"<CLT 4>Cứ như thể cậu ấy đã nghe thấy lời cô ấy...\n"
"<CLT>"

#. <CLT 4>…腐川さんは飛び起きた。
#. <CLT>
msgctxt "0132 | MAKOTO NAEGI"
msgid ""
"<CLT 4>...Toko suddenly shot awake.\n"
"<CLT>"
msgstr ""
"<CLT 4>...Toko đột ngột bừng tỉnh.\n"
"<CLT>"

#. <CLT 4>飛び起きたのだが…
#. <CLT>
msgctxt "0133 | MAKOTO NAEGI"
msgid ""
"<CLT 4>As in, she literally jumped up from where she was\n"
"laying.\n"
"<CLT>"
msgstr ""
"<CLT 4>Theo nghĩa đen là cậu ấy bật nhảy từ vị trí đang nằm.\n"
"<CLT>"

#. <CLT 4>その奇妙な動きに、ボクは思わず絶句してしまった。
#. <CLT>
msgctxt "0134 | TOUKO FUKAWA"
msgid ""
"<CLT 4>It was such a strange reaction, I was at a total loss\n"
"for words.\n"
"<CLT>"
msgstr ""
"<CLT 4>Đó là một phản ứng thật kỳ lạ, tôi hoàn toàn không nói nên lời.\n"
"<CLT>"

#. <CLT 4>彼女は寝ながらの姿勢のまま垂直に飛び跳ねると、
#. 空中で体勢を変え…
#. <CLT>
msgctxt "0135 | TOUKO FUKAWA"
msgid ""
"<CLT 4>She leapt straight up into the air, changing her\n"
"stance as she did.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu ấy nhảy thẳng lên không trung, thay đổi tư thế khi\n"
"đang thực hiện.\n"
"<CLT>"

#. <CLT 4>そして、その場に立ったのだ。
#. <CLT>
msgctxt "0136 | MAKOTO NAEGI"
msgid ""
"<CLT 4>In no time flat, she was just...standing up.\n"
"<CLT>"
msgstr ""
"<CLT 4>Trong chớp mắt, cậu ấy chỉ... đứng dậy.\n"
"<CLT>"

#. <CLT 4>筋肉の構成を無視した、
#. まるでデタラメな動きだった…
#. <CLT>
msgctxt "0137 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Ignoring the physical contortions she had to go\n"
"through, her motions were totally haphazard.\n"
"<CLT>"
msgstr ""
"<CLT 4>Bất chấp những động tác vặn vẹo cơ thể mà cậu ấy phải trải qua,\n"
"các chuyển động của cậu ấy hoàn toàn là ngẫu nhiên.\n"
"<CLT>"

#. え…？　え…？
msgctxt "0138 | AOI ASAHINA"
msgid "Huh? What?"
msgstr "Hả? Gì thế?"

#. ごめんごめん、びっくりしすぎて気絶しちった。
#. あるよね、そういう事。あれ私だけ？
msgctxt "0139 | TOUKO FUKAWA"
msgid ""
"Sorry about that. I was just so shocked, ya know? It\n"
"happens, right? Was I the only one?"
msgstr ""
"Xin lỗi về chuyện đó nhé. Chỉ là tôi bị sốc quá thôi, biết mà?\n"
"Chuyện thường thôi, phải không? Có mỗi tôi bị vậy thôi hả?"

#. ふ、腐川…さん？　
#. 大丈夫…？
msgctxt "0140 | MAKOTO NAEGI"
msgid "T-Toko? Are you...okay?"
msgstr "T-Toko? Cậu... ổn chứ?"

#. ダイジョーブ、ダイジョーブ！
#. ゲラゲラ…！
msgctxt "0141 | TOUKO FUKAWA"
msgid "I'm fine, I'm fine! Kyehaha...!"
msgstr "Tôi ổn, tôi ổn mà! Kyheh heh...!"

#. あ、死体だ！
#. おいっ、そこ死んでるぞ！
msgctxt "0142 | TOUKO FUKAWA"
msgid "Whoa, is that a dead body!? Hey! Are you dead!?"
msgstr "Whoa, kia là xác chết hả!? Này! Ngươi chết rồi à!?"

#. ゲラゲラゲラ！
msgctxt "0143 | TOUKO FUKAWA"
msgid "Kyeehahaha!"
msgstr "Kyeehahaha!"

#. やっぱ…頭を打ったのがマズかったべ…
msgctxt "0144 | YASUHIRO HAGAKURE"
msgid "She musta hit her head *real* hard when she fainted..."
msgstr "Chắc cậu ấy đã đập đầu *rất* mạnh khi ngất xỉu rồi..."

#. 世界は裏と表で構成されているのです！
#. ９回表と９回裏しかり、真実とウソもねッ！！
msgctxt "0145 | TOUKO FUKAWA"
msgid ""
"The world has a front and a back, a top inning and a\n"
"bottom, a sea of truth and a web of lies!"
msgstr ""
"Thế giới có mặt trước và mặt sau, có hiệp trên và hiệp\n"
"dưới, một biển cả sự thật và một mạng lưới dối lừa!"

#. なんかコワいし…
#. というか、口調が変わってません？
msgctxt "0146 | HIFUMI YAMADA"
msgid ""
"This is...quite concerning. I mean, she sounds\n"
"completely different..."
msgstr ""
"Chuyện này... khá đáng ngại đấy. Ý tôi là, giọng cậu ấy\n"
"nghe hoàn toàn khác hẳn..."

#. いやいや心配ござらん！
#. むしろ、噛み口調がなくなったなんて…
msgctxt "0147 | TOUKO FUKAWA"
msgid ""
"No no no, everything's fine! At least the stutter's\n"
"all gone."
msgstr ""
"Không không không, mọi thứ đều ổn cả! Ít nhất thì tật\n"
"nói lắp cũng biến mất rồi."

#. ラッキーなんじゃね！？　ゲラゲラゲラ！！
msgctxt "0148 | TOUKO FUKAWA"
msgid "That's a good thing, right!? Kyeehahaha!"
msgstr "Đó là một điều tốt, đúng không!? Kyeehahaha!"

#. なるほど、大丈夫ではないと理解したッ！
#. 目も妙にうつろだしな！
msgctxt "0149 | KIYOTAKA ISHIMARU"
msgid ""
"It's clear to me that everything is *not* fine! Your\n"
"eyes seem strangely vacant!"
msgstr ""
"Tôi thấy rõ là mọi thứ *không* hề ổn chút nào! Ánh mắt\n"
"của cậu trông trống rỗng một cách kỳ lạ!"

#. …ひとまず自室に連れて帰った方がよかろう。
msgctxt "0150 | SAKURA OOGAMI"
msgid ""
"It might be best if we take her back to her room for\n"
"the time being..."
msgstr ""
"Có lẽ tốt nhất là chúng ta nên đưa cậu ấy trở về phòng\n"
"trong lúc này..."

#. だったら、私が連れてくけど…
#. 誰か手伝って…
msgctxt "0151 | AOI ASAHINA"
msgid "I don't mind taking her, but...could someone help me?"
msgstr ""
"Tui không phiền đưa cậu ấy đi đâu, nhưng... có ai giúp\n"
"tui được không?"

#. 手伝いましょうか？
msgctxt "0152 | HIFUMI YAMADA"
msgid "If you need help, I don't mind—"
msgstr "Nếu cậu cần giúp đỡ, tôi không phiền—"

#. 石丸、手伝ってくれる？
msgctxt "0153 | AOI ASAHINA"
msgid "Taka, could you help me?"
msgstr "Taka, cậu giúp tui được không?"

#. え？　無視ッ！？
msgctxt "0154 | HIFUMI YAMADA"
msgid "Huh? She totally ignored me!"
msgstr "Hả? Cô ấy hoàn toàn ngó lơ tôi!"

#. では、その女の事は任せて、
#. 残った者でさっそく捜査を開始するぞ。
msgctxt "0155 | BYAKUYA TOGAMI"
msgid ""
"Very well. You take care of the girl, and the rest of\n"
"us can begin the investigation right away."
msgstr ""
"Được thôi. Các người cứ lo cho cô ta đi, còn những người\n"
"còn lại có thể bắt đầu điều tra ngay lập tức."

#. 現場の見張りは、前と同じように、
#. 大神と大和田の２人で問題ないな？
msgctxt "0156 | BYAKUYA TOGAMI"
msgid ""
"Can I assume nobody has a problem leaving Sakura and\n"
"Mondo on guard duty again?"
msgstr ""
"Tôi có thể giả định rằng không ai có ý kiến gì về việc để Sakura\n"
"và Mondo làm nhiệm vụ canh gác một lần nữa chứ?"

#. ちょ、ちょっと待ってよ。
#. そもそも…捜査って…
msgctxt "0157 | MAKOTO NAEGI"
msgid "H-Hold on a second. Rushing to an investigation—"
msgstr "Đ-Đợi một chút đã. Vội vã điều tra như vậy—"

#. …言っておくが、黒幕の仕業なんかじゃないぞ。
#. それは前回の件でわかったはずだ。
msgctxt "0158 | BYAKUYA TOGAMI"
msgid ""
"The mastermind isn't behind that. After what happened\n"
"last time, surely you realize that."
msgstr ""
"Kẻ chủ mưu không đứng sau chuyện đó đâu. Sau những gì đã\n"
"xảy ra lần trước, chắc hẳn cậu đã nhận ra điều đó rồi."

#. うっ…！！
msgctxt "0159 | MAKOTO NAEGI"
msgid "Nng...!"
msgstr "Nng...!"

#. 不二咲千尋は間違いなく殺されたんだ。
#. <CLT 3>“俺達の誰か”<CLT>にな…
msgctxt "0160 | BYAKUYA TOGAMI"
msgid ""
"There is no question that Chihiro was murdered by\n"
"<CLT 3>someone among us<CLT>."
msgstr ""
"Không còn nghi ngờ gì nữa, Chihiro đã bị giết bởi <CLT 3>một ai\n"
"đó trong số chúng ta<CLT>."

#. …そうだろ？　モノクマ。
msgctxt "0161 | BYAKUYA TOGAMI"
msgid "Isn't that right, Monokuma?"
msgstr "Có đúng vậy không, Monokuma?"

#. もっちろんッ！！
msgctxt "0162 | MONOKUMA"
msgid "Right as rain!"
msgstr "Chuẩn không cần chỉnh!"

#. だけど、悪い事じゃないよ。
#. これって当然の事なんだから。
msgctxt "0163 | MONOKUMA"
msgid ""
"But don't take it as a bad thing. It's just a fact of\n"
"life!"
msgstr ""
"Nhưng đừng coi đó là chuyện gì xấu xa nhé. Đó chỉ là một\n"
"chân lý của cuộc sống thôi!"

#. だってさ…
msgctxt "0164 | MONOKUMA"
msgid "Because..."
msgstr "Bởi vì..."

#. …それが<CLT 3>『卒業』<CLT>のルールなんだもんッ！
msgctxt "0165 | MONOKUMA"
msgid "...that's how <CLT 3>graduation<CLT> works!"
msgstr "...đó chính là cách mà quy tắc <CLT 3>tốt nghiệp<CLT> vận hành!"

#. <CLT 4>じゃあ…またなのか…？
#. <CLT>
msgctxt "0166 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Then...it's happened again?\n"
"<CLT>"
msgstr ""
"<CLT 4>Vậy là... chuyện đó lại xảy ra nữa?\n"
"<CLT>"

#. <CLT 4>また…そうだって言うのか…？
#. <CLT>
msgctxt "0167 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Is that what you're saying?\n"
"<CLT>"
msgstr ""
"<CLT 4>Đó là những gì ngươi đang muốn nói sao?\n"
"<CLT>"

#. <CLT 4>また…ボクらの誰かが…
#. <CLT>
msgctxt "0168 | MAKOTO NAEGI"
msgid ""
"<CLT 4>That another one of us...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Rằng một người nữa trong số chúng mình...?\n"
"<CLT>"

#. <CLT 4>ボクらの誰かが…仲間を…
#. <CLT>
msgctxt "0169 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Another one of us...killed...\n"
"<CLT>"
msgstr ""
"<CLT 4>Một người nữa trong số chúng mình... đã giết...\n"
"<CLT>"

#. <CLT 4>殺した……？
#. <CLT>
msgctxt "0170 | MAKOTO NAEGI"
msgid ""
"<CLT 4>...a fellow classmate?\n"
"<CLT>"
msgstr ""
"<CLT 4>...một người bạn cùng lớp?\n"
"<CLT>"

#. おや、またビビッてんの？
#. 気持ちのちっけぇヤツらばっかッスね！
msgctxt "0171 | MONOKUMA"
msgid ""
"What, does that freak you out? You guys got no balls,\n"
"you know that!?"
msgstr ""
"Gì thế, chuyện đó làm bọn bây khiếp vía à? Bọn bây đúng \n"
"là lũ hèn nhát, biết điều đó không hả!?"

#. アッチもちっけぇのか？
#. ボクのを拝ますしかないか？
msgctxt "0172 | MONOKUMA"
msgid ""
"Is there just nothin' down there at all? Well, I'll\n"
"let you pray to mine if you want."
msgstr ""
"Hay là chỗ đó chẳng có cái vẹo gì luôn? Chà, ta sẽ cho\n"
"bọn bây chiêm bái của ta nếu muốn nhé."

#. まぁ、ないんですけどね！
msgctxt "0173 | MONOKUMA"
msgid "Actually, I don't have any, either! Sorry!"
msgstr "Mà thực ra thì ta cũng chẳng có cái nào đâu! Xin lỗi nhé!"

#. 御託はいい。さっさと例の物を貰おうか。
#. 持って来ているんだろう？
msgctxt "0174 | BYAKUYA TOGAMI"
msgid ""
"Stop monologuing and give us what you came here to\n"
"give us. You *did* bring it, right?"
msgstr ""
"Ngừng độc thoại đi và đưa thứ ngươi cần đưa cho chúng\n"
"ta đây. Ngươi *có* mang nó theo mà, đúng chứ?"

#. へっへっへ…もちろんですともッ！
msgctxt "0175 | MONOKUMA"
msgid "Hehehe... I sure did, chum!"
msgstr "Heh heh heh... Chắc chắn là có rồi, anh bạn trẻ!"

#. それでは毎度おなじみになりつつある、
#. <CLT 3>ザ・モノクマファイル２<CLT>を配りまーす！！
msgctxt "0176 | MONOKUMA"
msgid ""
"Allow me to present <CLT 3>the next Monokuma File<CLT>. I know\n"
"how much you must be looking forward to it!"
msgstr ""
"Cho phép ta trình làng <CLT 3>Hồ sơ Monokuma tiếp theo<CLT>. Ta biết\n"
"là các em hẳn phải mong chờ nó lắm!"

#. じゃあ、捜査を頑張ってくださいね！
msgctxt "0177 | MONOKUMA"
msgid ""
"So, please do your very tippy-top best on this\n"
"investigation!"
msgstr ""
"Vì vậy, hãy cố gắng hết sức bình sinh cho chuyến điều\n"
"tra này nhé!"

#. 捜査って…
#. また、あんな事しなきゃいけないの…？
msgctxt "0178 | AOI ASAHINA"
msgid "Do we really gotta do another investigation...?"
msgstr "Chúng ta thực sự phải thực hiện một cuộc điều tra khác sao...?"

#. 仲間の…死体を調べたり…
msgctxt "0179 | AOI ASAHINA"
msgid "Examining the corpse of one of our friends..."
msgstr "Phải kiểm tra xác chết của một người bạn..."

#. 仲間を…疑ったり…
msgctxt "0180 | AOI ASAHINA"
msgid "Having to suspect all our *other* friends..."
msgstr "Rồi lại phải nghi ngờ tất cả những người bạn *khác* của mình..."

#. もう嫌だ…こんなの耐えられないよ…
msgctxt "0181 | AOI ASAHINA"
msgid "I hate this... I can't take it anymore!"
msgstr "Tui ghét chuyện này... Tui không thể chịu đựng thêm được nữa!"

#. 俺もイヤだぁー！！
msgctxt "0182 | YASUHIRO HAGAKURE"
msgid "I hate it, too!"
msgstr "Tớ cũng ghét nó lắm!"

#. お、お、お、俺はごめんだ！！
#. もう逃げるぞッ！！
msgctxt "0183 | YASUHIRO HAGAKURE"
msgid "I-I-I've had enough! I'm gettin' outta here!"
msgstr "T-T-Tớ chịu đủ rồi! Tớ chuồn khỏi đây đây!"

#. どこに逃げる気だ。逃げ場などないのだぞ。
msgctxt "0184 | SAKURA OOGAMI"
msgid "Where do you plan on going? There's nowhere to run."
msgstr "Cậu định đi đâu cơ chứ? Chẳng có nơi nào để trốn thoát đâu."

#. …いい加減慣れたらどうだ？
#. しょせん血は液体。死体は物じゃないか…
msgctxt "0185 | BYAKUYA TOGAMI"
msgid ""
"Just accept it already. After all, blood is just a\n"
"liquid. A dead body is a simple object."
msgstr ""
"Chấp nhận nó đi. Dù sao thì máu cũng chỉ là một loại\n"
"chất lỏng. Còn xác chết thì cũng chỉ là một đồ vật thôi."

#. 随分と張り切っておられるのですね？
msgctxt "0186 | CELES"
msgid ""
"You are very...enthusiastic about all of this, are you\n"
"not?"
msgstr "Cậu có vẻ... rất nhiệt tình với tất cả những chuyện này nhỉ?"

#. 張り切らないでどうする？
#. 犯人を突き止めなければ死ぬんだぞ。
msgctxt "0187 | BYAKUYA TOGAMI"
msgid ""
"How can I not be? If we don't unmask the culprit, we\n"
"all die."
msgstr ""
"Sao tôi có thể không nhiệt tình cho được? Nếu chúng ta\n"
"không lột mặt nạ kẻ thủ ác, tất cả sẽ phải chết."

#. そ、それは…そうだけど…
#. でも、そんな…いきなり…
msgctxt "0188 | MAKOTO NAEGI"
msgid "Th-That's true, but...to jump into it so soon..."
msgstr "Đ-Điều đó đúng, nhưng... bắt đầu ngay lập tức thế này thì..."

#. …なんだ？　お前は死にたいのか？
msgctxt "0189 | BYAKUYA TOGAMI"
msgid "What? Do you *want* to die?"
msgstr "Gì đây? Cậu *muốn* chết à?"

#. だったら勝手に死ね。すぐ死ね。
#. 酸素の無駄だ。
msgctxt "0190 | BYAKUYA TOGAMI"
msgid ""
"Fine, then go off and die somewhere. Right now, go\n"
"ahead. You're a waste of space."
msgstr ""
"Được thôi, vậy thì biến đi đâu đó mà chết đi. Ngay bây\n"
"giờ đấy, cứ tự nhiên. Cậu chỉ làm chật chỗ thôi."

#. 死体は…物だと…？
msgctxt "0191 | MONDO OOWADA"
msgid "A dead body is an...object?"
msgstr "Xác chết là... đồ vật sao?"

#. アイツは…不二咲は物なんかじゃねーぞッ！！
#. 軽々しく扱いやがったらオレが許さねーからなッ！！
msgctxt "0192 | MONDO OOWADA"
msgid ""
"Chihiro wasn't an \"object\"! Show a little respect, or\n"
"I'll beat some into ya!"
msgstr ""
"Chihiro không phải là \"đồ vật\"! Liệu mà giữ chút tôn\n"
"trọng đi, không thì tao sẽ tẩn cho mày một trận đấy!"

#. 安いケンカはやめて…
#. それに、十神君の言葉もあながち間違ってないわ。
msgctxt "0193 | KYOUKO KIRIGIRI"
msgid ""
"Everyone stop bickering. Listen, there's some truth in\n"
"what Byakuya said."
msgstr ""
"Mọi người thôi tranh cãi đi. Nghe này, những gì Byakuya\n"
"nói cũng có phần đúng đấy."

#. き、霧切さん…！
msgctxt "0194 | MAKOTO NAEGI"
msgid "K-Kyoko!"
msgstr "K-Kyoko!"

#. 謎を解き、犯人を見つけなければ、
#. 私達自身の命が危ういのは確かだし…
msgctxt "0195 | KYOUKO KIRIGIRI"
msgid ""
"If we don't solve the mystery and find the killer, our\n"
"own lives are forfeit."
msgstr ""
"Nếu chúng ta không giải mã được bí ẩn và tìm ra kẻ sát\n"
"nhân, tính mạng của chính chúng ta sẽ bị đe dọa."

#. それに、十神君が言うように、
#. 不二咲さんを殺したのがジェノサイダー翔だったら…
msgctxt "0196 | KYOUKO KIRIGIRI"
msgid ""
"And if Byakuya is right that Genocide Jack is somehow\n"
"the one who killed Chihiro..."
msgstr ""
"Và nếu Byakuya đúng về việc Jack Đồ Tể bằng cách nào đó\n"
"là kẻ đã giết Chihiro..."

#. 放っておけば、更なる犠牲者が出てしまうかも…
msgctxt "0197 | KYOUKO KIRIGIRI"
msgid ""
"...then unless we do something, more victims could\n"
"start piling up."
msgstr ""
"...thì trừ khi chúng ta hành động, nếu không danh sách\n"
"nạn nhân sẽ còn kéo dài thêm nữa."

#. さ、更なる犠牲者どころか、
#. 下手すれば全員みな殺しに…ッ！
msgctxt "0198 | HIFUMI YAMADA"
msgid ""
"Forget more victims! If we mess this up, we're all\n"
"dead meat!"
msgstr ""
"Quên chuyện thêm nạn nhân đi! Nếu chúng ta làm hỏng\n"
"chuyện này, tất cả sẽ xong đời hết!"

#. おっとっと、それなら心配ご無用ですぞ！
msgctxt "0199 | MONOKUMA"
msgid ""
"Hold on, hold on. If that's your worry, you don't\n"
"gotta worry any longer!"
msgstr ""
"Khoan đã, khoan đã nào. Nếu đó là điều các em lo lắng,\n"
"thì các em không cần phải bận tâm thêm nữa đâu!"

#. このコロシアイ学園生活で
#. <CLT 3>“同一のクロが殺せるのは２人まで”<CLT>なんで！
msgctxt "0200 | MONOKUMA"
msgid ""
"In any one killing game, <CLT 3>the guilty party may only\n"
"kill a maximum of two people<CLT>."
msgstr ""
"Trong bất kỳ một trò chơi giết chóc nào, <CLT 3>kẻ thủ ác chỉ\n"
"được phép giết tối đa hai người thôi<CLT>."

#. へ…？　そんなルールあった？
msgctxt "0201 | HIFUMI YAMADA"
msgid "What...? I don't remember any rule like that."
msgstr "Cái gì...? Tôi không nhớ là có quy tắc nào như vậy cả."

#. 今、追加したの。
msgctxt "0202 | MONOKUMA"
msgid "I just came up with it."
msgstr "Ta vừa mới nghĩ ra đấy."

#. だって、１人でたくさん殺しちゃうと、
#. 楽しい学園生活がすぐに終わっちゃうでしょ？
msgctxt "0203 | MONOKUMA"
msgid ""
"I mean, if one person went around and killed everyone,\n"
"your lovely student life would be all over, right?"
msgstr ""
"Ý ta là, nếu một ai đó cứ thế đi giết sạch mọi người, thì đời\n"
"học sinh tươi đẹp của các em sẽ hết sớm mất, phải không?"

#. <CLT 23><CLT><CLT 3>校則<CLT><CLT 23>が追加されました。
#. 校則メニューで確認できます。
#. <CLT>
msgctxt "0204 | NARRATION"
msgid ""
"<CLT 23>The new rule has been added to the <CLT><CLT 3>Regulations<CLT><CLT 23> menu.\n"
"<CLT>"
msgstr ""
"<CLT 23>Quy tắc mới đã được thêm vào mục <CLT><CLT 3>Nội quy<CLT><CLT 23>.\n"
"<CLT>"

#. …ならば、なぜ１人までじゃない。
msgctxt "0205 | SAKURA OOGAMI"
msgid "In that case, why not limit it to *one* person?"
msgstr ""
"Trong trường hợp đó, tại sao không giới hạn ở mức *một*\n"
"người thôi?"

#. だってミステリー的には、
#. “連続殺人事件勃発”って響きも捨てがたいでしょ？
msgctxt "0206 | MONOKUMA"
msgid ""
"Well in a good mystery, you don't want to miss out on\n"
"at least the *potential* of a serial killer angle!"
msgstr ""
"Chà, trong một tác phẩm trinh thám hay, sẽ không muốn bỏ lỡ cái\n"
"*tiềm năng* là khai thác góc độ sát nhân hàng loạt đâu!"

#. にょほほほ～！　１人じゃ連続にならないしね！
msgctxt "0207 | MONOKUMA"
msgid ""
"Nyoohohoho! Just one would totally murder that\n"
"possibility!"
msgstr ""
"U pư pư! Chỉ một người thôi thì sẽ giết chết hoàn toàn\n"
"cái khả năng đó mất!"

#. 今度こそさようなら！
#. 後ほど、学級裁判でお会いしましょう！
msgctxt "0208 | MONOKUMA"
msgid ""
"Farewell for now! I'll catch you guys at the class\n"
"trial!"
msgstr "Tạm biệt nhé! Hẹn gặp lại các em tại lớp xét xử!"

#. いまいち納得しかねますが、
#. とにかく、２人まで殺せるという事は…
msgctxt "0209 | CELES"
msgid ""
"I can't say I understand his thinking, but if we can\n"
"kill up to two people..."
msgstr ""
"Tớ không thể nói là mình hiểu được suy nghĩ của hắn,\n"
"nhưng nếu có thể giết tối đa hai người..."

#. あと１人は、殺される可能性もあるという訳ですわね…
msgctxt "0210 | CELES"
msgid ""
"...then one more person's life could still be in\n"
"danger."
msgstr ""
"...thì tính mạng của một người nữa vẫn có thể đang gặp\n"
"nguy hiểm."

#. それは大変だ。
#. そうなる前に、さっさと犯人を見つけないとな。
msgctxt "0211 | BYAKUYA TOGAMI"
msgid ""
"Which is definitely not good. We need to uncover the\n"
"culprit before something else happens."
msgstr ""
"Điều đó chắc chắn là không tốt. Chúng ta cần\n"
"tìm ra kẻ thủ ác trước khi có chuyện gì khác xảy ra."

#. テメーは黙ってろ！！
msgctxt "0212 | MONDO OOWADA"
msgid "YOU need to shut the fuck up!"
msgstr "MÀY mới là đứa cần phải câm mồm lại đấy!"

#. と、とりあえず…
#. 私と石丸は、腐川ちゃんを部屋まで送ってくるね。
msgctxt "0213 | AOI ASAHINA"
msgid ""
"W-Well...for now, Taka and me are gonna drop Toko off\n"
"at her room."
msgstr ""
"Ừ-Ừm... tạm thời thì, Taka và tui sẽ đưa Toko trở về\n"
"phòng của cậu ấy."

#. 送られてきまーす！
msgctxt "0214 | TOUKO FUKAWA"
msgid "Nice! I'm gonna get dropped off!"
msgstr "Tuyệt! Tôi sắp được đưa về tận nơi rồi!"

#. わたくし達も、さっさと捜査を始めましょう。
#. のんびりしている時間はないのです。
msgctxt "0215 | CELES"
msgid ""
"We have no time to stand around here. We must begin\n"
"our investigation tout suite."
msgstr ""
"Chúng ta không có thời gian để đứng thẫn thờ ở đây đâu.\n"
"Phải bắt đầu cuộc điều tra ngay lập tức thôi."

#. 誰が、不二咲さんを殺したのか…
#. その謎を解かなければ…
msgctxt "0216 | CELES"
msgid ""
"If we do not solve the mystery of who killed\n"
"Chihiro..."
msgstr ""
"Nếu chúng ta không giải mã được bí ẩn ai là kẻ đã giết\n"
"Chihiro..."

#. わたくし達の方が、
#. 処刑されてしまうのですから…
msgctxt "0217 | CELES"
msgid "...then we will quickly follow her into the afterlife."
msgstr ""
"...thì chúng ta cũng sẽ sớm theo chân cậu ấy sang thế\n"
"giới bên kia đấy."

#. <CLT 4>そう…なんだよな…
#. <CLT>
msgctxt "0218 | MAKOTO NAEGI"
msgid ""
"<CLT 4>That's true...\n"
"<CLT>"
msgstr ""
"<CLT 4>Đúng là vậy nhỉ...\n"
"<CLT>"

#. <CLT 4>こんなの嫌だけど…
#. でも、生き残る為には…
#. <CLT>
msgctxt "0219 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I hate this, but...if I want to survive...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình ghét chuyện này, nhưng... nếu mình muốn \n"
"sống sót...\n"
"<CLT>"

#. <CLT 4>みんなで…生き残る為には…
#. <CLT>
msgctxt "0220 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Me and everyone else...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình và tất cả mọi người...\n"
"<CLT>"

#. <CLT 4>やるしか……
#. <CLT>
msgctxt "0221 | MAKOTO NAEGI"
msgid ""
"<CLT 4>We have to do it.\n"
"<CLT>"
msgstr ""
"<CLT 4>Chúng mình phải làm điều đó.\n"
"<CLT>"

#. <CLT 4>やるしか…ないんだ…！
#. <CLT>
msgctxt "0222 | MAKOTO NAEGI"
msgid ""
"<CLT 4>We don't have any other choice!\n"
"<CLT>"
msgstr ""
"<CLT 4>Chúng mình không còn lựa chọn nào khác!\n"
"<CLT>"

#. <CLT 4>まずは…モノクマファイルで状況を確認してみよう。
#. <CLT>
msgctxt "0223 | MAKOTO NAEGI"
msgid ""
"<CLT 4>First of all, I'd better check the Monokuma File to\n"
"see exactly what's going on.\n"
"<CLT>"
msgstr ""
"<CLT 4>Trước hết, mình nên kiểm tra Hồ sơ Monokuma để xem chính\n"
"xác chuyện gì đang xảy ra.\n"
"<CLT>"

#. <CLT 4>被害者は不二咲千尋…
#. 死亡時刻は午前２時頃。
#. <CLT>
msgctxt "0224 | MAKOTO NAEGI"
msgid ""
"<CLT 4>\"The victim was Chihiro Fujisaki. The time of death is\n"
"estimated to be around 2:00 a.m.\"\n"
"<CLT>"
msgstr ""
"<CLT 4>\"Nạn nhân là Chihiro Fujisaki. Thời điểm tử vong được dự\n"
"đoán là vào khoảng 2 giờ sáng.\"\n"
"<CLT>"

#. <CLT 4>死体発見現場となったのは、
#. 学校エリアの２階にある<CLT><CLT 3>女子更衣室<CLT><CLT 4>。
#. <CLT>
msgctxt "0225 | MAKOTO NAEGI"
msgid ""
"<CLT 4>\"The body was discovered in <CLT><CLT 3>the girls locker room<CLT><CLT 4>,\n"
"on the 2nd floor of the school.\"\n"
"<CLT>"
msgstr ""
"<CLT 4>\"Thi thể được phát hiện tại <CLT><CLT 3>phòng thay đồ nữ<CLT><CLT 4>, ở tầng 2\n"
"của ngôi trường.\"\n"
"<CLT>"

#. <CLT 4>致命傷は鈍器による頭部への殴打。
#. 即死だった模様。
#. <CLT>
msgctxt "0226 | MAKOTO NAEGI"
msgid ""
"<CLT 4>\"The cause of death was a blow to the head with a\n"
"blunt object. She was killed instantly.\"\n"
"<CLT>"
msgstr ""
"<CLT 4>\"Nguyên nhân cái chết là do một cú đánh vào đầu bằng một\n"
"vật cùn. Nạn nhân tử vong ngay lập tức.\"\n"
"<CLT>"

#. <CLT 4>情報は…これだけか…
#. <CLT>
msgctxt "0227 | MAKOTO NAEGI"
msgid ""
"<CLT 4>That's...all it says.\n"
"<CLT>"
msgstr ""
"<CLT 4>Đó... là tất cả những gì hồ sơ viết.\n"
"<CLT>"

#. <CLT 4>でも、文句を言っても仕方がない。
#. <CLT>
msgctxt "0228 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Well...it's not like there's any point in complaining\n"
"about it.\n"
"<CLT>"
msgstr ""
"<CLT 4>Hừ... có phàn nàn về nó thì cũng chẳng giải \n"
"quyết được gì.\n"
"<CLT>"

#. <CLT 4>どっちにしろ…やるしかないんだし…
#. <CLT>
msgctxt "0229 | MAKOTO NAEGI"
msgid ""
"<CLT 4>No matter what, I gotta do what I gotta do...\n"
"<CLT>"
msgstr ""
"<CLT 4>Dù thế nào đi nữa, mình vẫn phải làm những gì \n"
"cần làm...\n"
"<CLT>"

#. <CLT 23><CLT><CLT 3>モノクマファイル２<CLT><CLT 23>を手帳に記録しました。
#. 言弾（コトダマ）メニューで確認できます。
#. <CLT>
msgctxt "0230 | NARRATION"
msgid ""
"<CLT 23>\"<CLT><CLT 3>Monokuma File #2<CLT><CLT 23>\" has been added to the Truth\n"
"Bullets section of your handbook.\n"
"<CLT>"
msgstr ""
"<CLT 23>\"<CLT><CLT 3>Hồ sơ Monokuma #2<CLT><CLT 23>\" đã được thêm vào phần Đạn Sự Thật\n"
"trong sổ học sinh của bạn.\n"
"<CLT>"

#. おい、苗木…
#. ちょっといいか…
msgctxt "0231 | BYAKUYA TOGAMI"
msgid "Hey, Makoto. Do you have a second?"
msgstr "Này, Makoto. Có rảnh chút không?"

#. …え？
msgctxt "0232 | MAKOTO NAEGI"
msgid "Huh?"
msgstr "Hả?"

#. ボ、ボクに…何か用？
msgctxt "0233 | MAKOTO NAEGI"
msgid "Did you...need something from me?"
msgstr "Cậu... cần gì ở tớ sao?"

#. 当然だ。用のない人生なんて退屈だからな。
msgctxt "0234 | BYAKUYA TOGAMI"
msgid ""
"Of course. Life without purpose is quite dull, you\n"
"know?"
msgstr ""
"Tất nhiên rồi. Một cuộc đời không có mục đích thì tẻ\n"
"nhạt lắm, cậu biết mà?"

#. えっと…用って…？
msgctxt "0235 | MAKOTO NAEGI"
msgid "Um, so...what did you need?"
msgstr "Ừm, vậy... cậu cần chuyện gì?"

#. 俺の捜査に協力させてやろう。
msgctxt "0236 | BYAKUYA TOGAMI"
msgid ""
"I'm going to let you cooperate with me during my\n"
"investigation."
msgstr ""
"Tôi sẽ cho phép cậu hợp tác với tôi trong suốt quá trình\n"
"điều tra này."

#. …は？
msgctxt "0237 | MAKOTO NAEGI"
msgid "...Huh?"
msgstr "...Hả?"

#. 俺はお前の能力を買っているんだ。
#. 舞園さやかの事件を解決させた、お前の能力をな…
msgctxt "0238 | BYAKUYA TOGAMI"
msgid ""
"I'm purchasing your talent. The same talent which\n"
"allowed you to solve Sayaka's case."
msgstr ""
"Tôi đang trọng dụng tài năng của cậu. Thứ tài năng đã\n"
"giúp cậu phá được vụ án của Sayaka ấy."

#. か、解決って…あの時はただ…
msgctxt "0239 | MAKOTO NAEGI"
msgid "S-Solve...? No, I just..."
msgstr "Ph-Phá án sao...? Không, tớ chỉ..."

#. お前は多少は使える人間のようだ。
#. だから、お前を選んでやる事にしたぞ。
msgctxt "0240 | BYAKUYA TOGAMI"
msgid ""
"You seem to have some limited use. Which is why I've\n"
"chosen you."
msgstr ""
"Có vẻ cậu cũng có chút hữu dụng đấy. Đó là lý do tại sao\n"
"tôi chọn cậu."

#. 俺の捜査の協力をさせてやる…
msgctxt "0241 | BYAKUYA TOGAMI"
msgid ""
"You have the honor of contributing to my\n"
"investigation."
msgstr "Cậu có vinh dự được đóng góp cho cuộc điều tra của tôi."

#. <CLT 4>これって誘われてるのか？
#. その割には、やけに高圧的だけど…
#. <CLT>
msgctxt "0242 | MAKOTO NAEGI"
msgid ""
"<CLT 4>So...you're inviting me to come with you? You're doing\n"
"it in the most arrogant way possible, though...\n"
"<CLT>"
msgstr ""
"<CLT 4>Vậy là... cậu đang rủ mình đi cùng sao? Dù rằng cách cậu\n"
"rủ thật sự trịch thượng hết mức có thể...\n"
"<CLT>"

#. では、さっそく始めるとするか。
msgctxt "0243 | BYAKUYA TOGAMI"
msgid "Now then, shall we get started?"
msgstr "Giờ thì, chúng ta bắt đầu chứ?"

#. で、でも…
msgctxt "0244 | MAKOTO NAEGI"
msgid "B-But..."
msgstr "Nh-Nhưng..."

#. いいから始めるぞ。
#. のんびりしているヒマはないんだ。
msgctxt "0245 | BYAKUYA TOGAMI"
msgid ""
"We need to get moving. There's no time to be standing\n"
"around."
msgstr ""
"Chúng ta cần phải di chuyển ngay. Không có thời gian để\n"
"đứng thẩn thờ ở đây đâu."

#. ………………
msgctxt "0246 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. <CLT 4>なんだか、よくわからないけど…
#. <CLT>
msgctxt "0247 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I don't really know what just happened...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình cũng không rõ chuyện gì vừa xảy ra nữa...\n"
"<CLT>"

#. <CLT 4>なぜか、十神クンと一緒に
#. 捜査する事になった…みたいだ。
#. <CLT>
msgctxt "0248 | MAKOTO NAEGI"
msgid ""
"<CLT 4>...but it looks like I'll be working with Byakuya on\n"
"this one.\n"
"<CLT>"
msgstr ""
"<CLT 4>...nhưng có vẻ như mình sẽ làm việc cùng với Byakuya\n"
"trong vụ này.\n"
"<CLT>"

#. <CLT 4>壁に血文字で<CLT><CLT 3>“チミドロフィーバー”<CLT><CLT 4>って、
#. 書いてある…
#. <CLT>
msgctxt "0249 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The word \"<CLT><CLT 3>bloodlust<CLT><CLT 4>\" is written on the wall in\n"
"blood...\n"
"<CLT>"
msgstr ""
"<CLT 4>Từ \"<CLT><CLT 3>bloodlust<CLT><CLT 4>\" được viết trên tường \n"
"bằng máu...\n"
"<CLT>"

#. <CLT 4>なんだよ…<CLT><CLT 3>“チミドロフィーバー”<CLT><CLT 4>って…
#. <CLT>
msgctxt "0250 | MAKOTO NAEGI"
msgid ""
"<CLT 4>What's the meaning behind it? \"<CLT><CLT 3>Bloodlust<CLT><CLT 4>\"...\n"
"<CLT>"
msgstr ""
"<CLT 4>Ý nghĩa đằng sau nó là gì? \"<CLT><CLT 3>Khát máu<CLT><CLT 4>\"...\n"
"<CLT>"

#. <CLT 4>いや、今はこんなダンベルなんかより、
#. 先に調べなくちゃいけない事がある…
#. <CLT>
msgctxt "0251 | MAKOTO NAEGI"
msgid ""
"<CLT 4>No, there are more important things to worry about\n"
"right now than a dumbbell.\n"
"<CLT>"
msgstr ""
"<CLT 4>Không, hiện tại có những việc quan trọng hơn cần lo lắng\n"
"thay vì một quả tạ tay.\n"
"<CLT>"

#. <CLT 4>床にダンベルが転がっている…
#. しかも…
#. <CLT>
msgctxt "0252 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There's a dumbbell on the floor. And...\n"
"<CLT>"
msgstr ""
"<CLT 4>Có một quả tạ trên sàn nhà. Và...\n"
"<CLT>"

#. <CLT 4>これって、<CLT><CLT 3>血痕<CLT><CLT 4>だ！
#. 血痕が付着しているぞ…！
#. <CLT>
msgctxt "0253 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is a <CLT><CLT 3>bloodstain<CLT><CLT 4>! There's a bloodstain on the\n"
"dumbbell!\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là một <CLT><CLT 3>vết máu<CLT><CLT 4>! Có một vết máu dính trên quả tạ tay này!\n"
"<CLT>"

#. モノクマファイルによれば、
#. 致命傷は“鈍器による頭部への殴打”…だったな。
msgctxt "0254 | BYAKUYA TOGAMI"
msgid ""
"The Monokuma File said \"a blow to the head with a\n"
"blunt object\" is what killed her."
msgstr ""
"Hồ sơ Monokuma nói rằng \"một cú đánh vào đầu bằng vật\n"
"cùn\" là thứ đã giết chết cậu ấy."

#. …って事は、やっぱり、
#. このダンベルが<CLT 3>凶器<CLT>なのかな？
msgctxt "0255 | MAKOTO NAEGI"
msgid ""
"Does that mean this dumbbell was actually the <CLT 3>murder\n"
"weapon<CLT>...?"
msgstr ""
"Điều đó có nghĩa là quả tạ này thực sự là <CLT 3>hung khí giết\n"
"người<CLT> sao...?"

#. …それ以外には考えられんだろう。
msgctxt "0256 | BYAKUYA TOGAMI"
msgid "I don't imagine it could have been anything else."
msgstr "Tôi không nghĩ nó có thể là thứ gì khác được đâu."

#. <CLT 23><CLT><CLT 3>ダンベル<CLT><CLT 23>を手帳に記録しました。
#. 言弾（コトダマ）メニューで確認できます。
#. <CLT>
msgctxt "0257 | NARRATION"
msgid ""
"<CLT 23>\"<CLT><CLT 3>Locker Room Dumbbell<CLT><CLT 23>\" has been added to the Truth\n"
"Bullets section of your handbook.\n"
"<CLT>"
msgstr ""
"<CLT 23>\"<CLT><CLT 3>Tạ Tay Phòng Thay Đồ<CLT><CLT 23>\" đã được thêm vào phần Đạn Sự Thật\n"
"trong sổ học sinh của bạn.\n"
"<CLT>"

#. <CLT 4>これは…不二咲さんの血か…？
#. <CLT>
msgctxt "0258 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Is this...Chihiro's blood?\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là... máu của Chihiro sao?\n"
"<CLT>"

#. <CLT 4>いや、今はそれより先に
#. 調べなくちゃいけない事がある…
#. <CLT>
msgctxt "0259 | MAKOTO NAEGI"
msgid ""
"<CLT 4>No, there are more important things to worry about\n"
"right now than this.\n"
"<CLT>"
msgstr ""
"<CLT 4>Không, hiện tại có những việc quan trọng hơn cần phải lo\n"
"lắng thay vì chuyện này.\n"
"<CLT>"

#. <CLT 4>カーペットには生々しい<CLT><CLT 3>血痕<CLT><CLT 4>がある。
#. きっと…殺人が起きた時に飛んだんだ。
#. <CLT>
msgctxt "0260 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There's a fresh <CLT><CLT 3>bloodstain<CLT><CLT 4> on the carpet. It must've\n"
"been splattered with blood during the murder...\n"
"<CLT>"
msgstr ""
"<CLT 4>Có một <CLT><CLT 3>vết máu<CLT><CLT 4> còn mới trên thảm. Chắc hẳn nó đã bị máu\n"
"bắn vào trong lúc vụ án xảy ra...\n"
"<CLT>"

#. 待て、それよりも…壁だ。
msgctxt "0261 | SAKURA OOGAMI"
msgid "Wait...look at the wall."
msgstr "Đợi đã... nhìn lên tường kìa."

#. これは、文字か…？
msgctxt "0262 | SAKURA OOGAMI"
msgid "Are these letters...?"
msgstr "Đó là những chữ cái sao...?"

#. <CLT 4>壁に文字…？
#. <CLT>
msgctxt "0263 | MAKOTO NAEGI"
msgid ""
"<CLT 4>On the wall...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Trên tường sao...?\n"
"<CLT>"

#. <CLT 4>ポスターに<CLT><CLT 3>血痕<CLT><CLT 4>が付着している。
#. 殺人が起きた際に血が飛んで…付着したんだろうな。
#. <CLT>
msgctxt "0264 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The poster's got some <CLT><CLT 3>blood<CLT><CLT 4> on it. It must have\n"
"happened during the murder...\n"
"<CLT>"
msgstr ""
"<CLT 4>Tờ áp phích bị dính <CLT><CLT 3>máu<CLT><CLT 4>. Chắc hẳn nó đã bị dính \n"
"lên trong lúc vụ án diễn ra...\n"
"<CLT>"

#. 待て、それよりも先に壁だ。
msgctxt "0265 | BYAKUYA TOGAMI"
msgid "For now, pay attention to the wall."
msgstr "Tạm thời thì, hãy chú ý vào bức tường kia đi."

#. …え？
msgctxt "0266 | MAKOTO NAEGI"
msgid "Huh?"
msgstr "Hả?"

#. さっきも言っただろう。
#. 文字が書かれている…
msgctxt "0267 | BYAKUYA TOGAMI"
msgid "I said it once already. There's a word written there."
msgstr "Tôi đã nói một lần rồi. Có một từ được viết ở đó đấy."

#. <CLT 4>壁に文字…？
#. <CLT>
msgctxt "0268 | MAKOTO NAEGI"
msgid ""
"<CLT 4>On the wall...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Trên tường sao...?\n"
"<CLT>"

#. <CLT 4>全身から…生気が抜け落ちている……
#. <CLT>
msgctxt "0269 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I could feel the life draining out of my own body.\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình có thể cảm nhận được sự sống đang dần tan \n"
"biến khỏi cơ thể.\n"
"<CLT>"

#. <CLT 4>これが死体…
#. <CLT>
msgctxt "0270 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It's a dead body...\n"
"<CLT>"
msgstr ""
"<CLT 4>Đó là một xác chết...\n"
"<CLT>"

#. <CLT 4>不二咲さんの…死体…
#. <CLT>
msgctxt "0271 | MAKOTO NAEGI"
msgid ""
"<CLT 4>*Chihiro's* dead body...\n"
"<CLT>"
msgstr ""
"<CLT 4>Xác chết của *Chihiro*...\n"
"<CLT>"

#. それにしても、見れば見るほど奇妙な死体だ。
#. これがジェノサイダー翔のやり方か…
msgctxt "0272 | BYAKUYA TOGAMI"
msgid ""
"But the more I look, the more strange it all seems.\n"
"This must be Genocide Jack's handiwork."
msgstr ""
"Nhưng càng nhìn, mọi thứ lại càng có vẻ kỳ lạ. Đây chắc\n"
"chắn là tác phẩm của Jack Đồ Tể rồi."

#. でも、まだ…
msgctxt "0273 | MAKOTO NAEGI"
msgid "Well, but..."
msgstr "Ừ, nhưng..."

#. まだジェノサイダー翔の犯行と決まった訳じゃない。
#. そう言いたいのか？
msgctxt "0274 | BYAKUYA TOGAMI"
msgid ""
"But we're still not sure he did it. Is that what you\n"
"want to say?"
msgstr ""
"Nhưng chúng ta vẫn chưa chắc chắn là hắn làm. Cậu muốn\n"
"nói thế phải không?"

#. そいつは…どうだろうな？
msgctxt "0275 | BYAKUYA TOGAMI"
msgid "I wonder about that..."
msgstr "Tôi cũng tự hỏi về điều đó đấy..."

#. フフ…フフフ…
msgctxt "0276 | BYAKUYA TOGAMI"
msgid "Hmhmhm..."
msgstr "Hmhmhm..."

#. 待って…
msgctxt "0277 | KYOUKO KIRIGIRI"
msgid "Wait."
msgstr "Đợi đã."

#. 壁に、文字が書かれているみたい…
#. 気にならない？
msgctxt "0278 | KYOUKO KIRIGIRI"
msgid ""
"There's something written on the wall. Doesn't that\n"
"concern you?"
msgstr ""
"Có gì đó được viết trên tường kìa. Cậu không thấy bận \n"
"tâm sao?"

#. <CLT 4>壁に文字…？
#. <CLT>
msgctxt "0279 | MAKOTO NAEGI"
msgid ""
"<CLT 4>On the wall...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Trên tường sao...?\n"
"<CLT>"

#. 待て…
#. まだ調べるべき事があるだろう。
msgctxt "0280 | BYAKUYA TOGAMI"
msgid "Hold on. We still have more to check here."
msgstr "Khoan đã. Chúng ta vẫn còn nhiều thứ cần kiểm tra ở đây."

#. 待って…
msgctxt "0281 | KYOUKO KIRIGIRI"
msgid "Wait."
msgstr "Đợi đã."

#. 壁に、文字が書かれているみたい…
#. 気にならない？
msgctxt "0282 | KYOUKO KIRIGIRI"
msgid ""
"There's something written on the wall. Doesn't that\n"
"concern you?"
msgstr ""
"Có gì đó được viết trên tường kìa. Cậu không thấy bận \n"
"tâm sao?"

#. <CLT 4>壁に文字…？
#. <CLT>
msgctxt "0283 | MAKOTO NAEGI"
msgid ""
"<CLT 4>On the wall...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Trên tường sao...?\n"
"<CLT>"

#. 待て…
#. まだ調べるべき事があるだろう。
msgctxt "0284 | BYAKUYA TOGAMI"
msgid "Hold on. We still have more to check here."
msgstr "Khoan đã. Chúng ta vẫn còn nhiều thứ cần kiểm tra ở đây."

#. さてと、そろそろ移動だ。
msgctxt "0285 | BYAKUYA TOGAMI"
msgid "Now I believe it's about time for us to move on."
msgstr "Giờ tôi tin rằng đã đến lúc chúng ta nên đi tiếp rồi."

#. えっ、もう？
msgctxt "0286 | MAKOTO NAEGI"
msgid "Huh? Already?"
msgstr "Hả? Đã xong rồi sao?"

#. ここにいるだけでは手掛かりは増えん。
#. 様々な角度から、事件を調べる必要がある。
msgctxt "0287 | BYAKUYA TOGAMI"
msgid ""
"New clues won't magically appear by standing around\n"
"here. We need to check every aspect of this case."
msgstr ""
"Cứ đứng thẩn thờ ở đây thì manh mối mới chẳng tự nhiên xuất hiện\n"
"đâu. Chúng ta cần phải kiểm tra mọi khía cạnh của vụ án này."

#. そ、それはそうだけど…
msgctxt "0288 | MAKOTO NAEGI"
msgid "Th-That's true, but..."
msgstr "Đ-Điều đó đúng, nhưng..."

#. 納得したなら、さっさと移動だ。
msgctxt "0289 | BYAKUYA TOGAMI"
msgid "If you're satisfied, let's hurry up and proceed."
msgstr "Nếu cậu đã thỏa mãn rồi, thì mau lên đường thôi."

#. <CLT 4>随分…強引だな。
#. エラいヤツに捕まったのかも…
#. <CLT>
msgctxt "0290 | MAKOTO NAEGI"
msgid ""
"<CLT 4>He's so...pushy. I got caught up with the wrong person\n"
"this time...\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu ta thật là... áp đặt. Phen này mình gặp nhầm người\n"
"mất rồi...\n"
"<CLT>"


────────────────────────────────────────────────────────────────────────
  CHAPTER  e02_028_003 Genocide Jack Evidence
────────────────────────────────────────────────────────────────────────

  [ERROR]  e02_028_003
    ✗ msgid ""
msgstr ""
"Project-Id-Version: DR1 (PC)\n"
"Report-Msgid-Bugs-To: your_email\n"
"POT-Creation-Date: 3/26/2026\n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: en_US\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Generator: Poedit 3.8\n"

#. 【確信】
msgctxt "0001 | CHOICE/RE:ACT"
msgid "[basis]"
msgstr "[căn cứ]"

#. 確信があるって…ホントなの…？
msgctxt "0002 | MAKOTO NAEGI"
msgid "Is there really proof...?"
msgstr "Thực sự có bằng chứng sao...?"

#. これからお前をある場所に連れていく。
#. そこで<CLT 3>“根拠”<CLT>を見せてやろう。
msgctxt "0003 | BYAKUYA TOGAMI"
msgid ""
"There's somewhere I'd like to take you. This will\n"
"provide all the <CLT 3>evidence<CLT> you need."
msgstr ""
"Có một nơi tôi muốn đưa cậu đến. Nơi đó sẽ cung cấp mọi\n"
"<CLT 3>bằng chứng<CLT> mà cậu cần."

#. 不二咲千尋を殺したのが、
#. ジェノサイダー翔だという根拠をな！
msgctxt "0004 | BYAKUYA TOGAMI"
msgid ""
"Evidence that Genocide Jack is the one that killed\n"
"Chihiro!"
msgstr "Bằng chứng cho thấy Jack Đồ Tể chính là kẻ đã giết Chihiro!"

#. <CLT 4>こ、根拠って…
#. そんなものがホントに…
#. <CLT>
msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Evidence... Does something like that really...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Bằng chứng sao... Liệu một thứ như thế có thực sự...?\n"
"<CLT>"

#. あっ！　そこの２人！！
msgctxt "0006 | NO NAME"
msgid "Ah! Hey you two!"
msgstr "A! Này hai người kia!"

#. た、大変なの、助けて…
msgctxt "0007 | AOI ASAHINA"
msgid "Big trouble! Need your help!"
msgstr "Nguy to rồi! Giúp tui với!"

#. 俺達は忙しいんだ。ジャマをするな…
msgctxt "0008 | BYAKUYA TOGAMI"
msgid "We're busy. Leave us alone!"
msgstr "Chúng tôi đang bận. Đừng có làm phiền!"

#. 緊急事態なんだよ…緊急事態…
msgctxt "0009 | AOI ASAHINA"
msgid "But it's an emergency...! Emergency!"
msgstr "Nhưng đây là tình trạng khẩn cấp...! Khẩn cấp!"

#. だから助けて！　お願いッ！！
msgctxt "0010 | AOI ASAHINA"
msgid "C'mon, please! You gotta help me!"
msgstr "Thôi mà, làm ơn đi! Phải giúp tui mới được!"

#. 【緊急事態】
msgctxt "0011 | CHOICE/RE:ACT"
msgid "[e-mer-gen-cyyy]"
msgstr "[tình trạng khẩn cấp]"

#. 緊急事態って…何があったの…？
msgctxt "0012 | MAKOTO NAEGI"
msgid "An emergency? What happened?"
msgstr "Tình trạng khẩn cấp sao? Có chuyện gì vậy?"

#. <CLT 3>腐川<CLT>ちゃんがね、大変なの…
#. なんか様子がおかしくなっちゃったの…
msgctxt "0013 | AOI ASAHINA"
msgid ""
"Something's wrong with <CLT 3>Toko<CLT>. She's acting super\n"
"strange!"
msgstr ""
"Có chuyện gì đó không ổn với <CLT 3>Toko<CLT> rồi. Cậu ấy đang hành\n"
"xử cực kỳ kỳ lạ!"

#. <CLT 4>いや…さっきの時点でも、
#. 十分おかしかったけど…
#. <CLT>
msgctxt "0014 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Well, I mean...she was acting pretty strange earlier,\n"
"right?\n"
"<CLT>"
msgstr ""
"<CLT 4>Thì, ý mình là... lúc nãy cậu ấy vốn đã hành xử khá kỳ\n"
"lạ rồi, phải không?\n"
"<CLT>"

#. …どうする、十神クン？
msgctxt "0015 | MAKOTO NAEGI"
msgid "...What should we do, Byakuya?"
msgstr "...Chúng ta nên làm gì đây, Byakuya?"

#. 腐川冬子か…少々気に掛かるな…
msgctxt "0016 | BYAKUYA TOGAMI"
msgid "Since it's Toko...I must admit, I'm intrigued."
msgstr "Vì là Toko nên... tôi phải thừa nhận là tôi thấy khá tò mò đấy."

#. ちょっと様子を見に行ってやるか…
msgctxt "0017 | BYAKUYA TOGAMI"
msgid ""
"I suppose we can take a second to see what's going on\n"
"with her."
msgstr ""
"Tôi đoán là chúng ta có thể dành chút thời gian để xem\n"
"có chuyện gì đang xảy ra với cô ta."

#. …いいの？
msgctxt "0018 | MAKOTO NAEGI"
msgid "Are you sure?"
msgstr "Cậu chắc chứ?"

#. 何度も言わせるな。
msgctxt "0019 | BYAKUYA TOGAMI"
msgid "Don't make me repeat myself."
msgstr "Đừng để tôi phải lặp lại lời mình."

#. <CLT 4>なんか…意外な反応だな。
#. てっきり、冷たくあしらうと思ってたのに…
#. <CLT>
msgctxt "0020 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I...didn't expect that. I thought for sure he'd just\n"
"say no, and that'd be the end of it.\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình... không ngờ tới điều đó. Mình cứ ngỡ cậu ta chắc\n"
"chắn sẽ từ chối thẳng thừng, và thế là xong chuyện chứ.\n"
"<CLT>"

#. じゃあ急いで付いて来て！　ほら早く早くッ！！
msgctxt "0021 | AOI ASAHINA"
msgid "Okay, okay, come on! Hurry!"
msgstr "Được rồi, được rồi, đi thôi! Nhanh lên nhanh lên!"

#. ちょ、ちょっと待って…朝日奈さんッ！
msgctxt "0022 | MAKOTO NAEGI"
msgid "W-Wait for us, Hina!"
msgstr "Đ-Đợi bọn tớ với, Hina!"

#. 寄宿舎の方に向かったようだ。
#. おそらく<CLT 3>腐川の個室<CLT>だろう…
msgctxt "0023 | BYAKUYA TOGAMI"
msgid ""
"It looks like she headed to the dorms. To <CLT 3>Toko's\n"
"room<CLT>, most likely."
msgstr ""
"Có vẻ cô ta đang hướng về phía ký túc xá. Khả năng cao\n"
"là đến <CLT 3>phòng của Toko<CLT>."

#. う、うん…！
msgctxt "0024 | MAKOTO NAEGI"
msgid "You're right!"
msgstr "Cậu nói đúng đấy!"

#. 【ジェノサイダー翔】
msgctxt "0025 | CHOICE/RE:ACT"
msgid "[Genocide Jack]"
msgstr "[Jack Đồ Tể]"

#. ジェノサイダー翔って…
#. あの殺人鬼の事だよね？
msgctxt "0026 | MAKOTO NAEGI"
msgid "That murderous fiend is...Genocide Jack, right?"
msgstr "Jack Đồ Tể, là tên ác quỷ giết người... đúng không?"

#. 他にいないだろう…
msgctxt "0027 | BYAKUYA TOGAMI"
msgid "There's nobody else it could be."
msgstr "Chẳng còn ai khác vào đây được nữa đâu."

#. 猟奇的かつ、残忍な手口で
#. 殺人を繰り返す凶悪犯…
msgctxt "0028 | BYAKUYA TOGAMI"
msgid ""
"A murderous fiend, who kills again and again using a\n"
"bizarre and brutal method..."
msgstr ""
"Một ác quỷ giết người, kẻ sát hại hết lần này đến lần\n"
"khác bằng một phương thức quái đản và tàn bạo..."

#. 通り魔的、無差別的、突発的な犯行ばかりゆえ、
#. 警察もその足取りを掴めていない状態…
msgctxt "0029 | BYAKUYA TOGAMI"
msgid ""
"They're like a ghost, attacking suddenly then slipping\n"
"away before the police can catch up to them."
msgstr ""
"Hắn như một bóng ma, tấn công bất ngờ rồi tẩu thoát\n"
"trước khi cảnh sát kịp đuổi tới."

#. そんな連続殺人事件の容疑者に、
#. ネット上で与えられたあだ名が…
msgctxt "0030 | BYAKUYA TOGAMI"
msgid ""
"And what nickname did the Internet give to this\n"
"mysterious serial killer?"
msgstr ""
"Và cư dân mạng đã đặt biệt danh gì cho tên sát nhân hàng\n"
"loạt bí ẩn này?"

#. ジェノサイダー翔…
msgctxt "0031 | MAKOTO NAEGI"
msgid "Genocide Jack..."
msgstr "Jack Đồ Tể..."

#. 犠牲者は数千人にも及ぶ…っていうのは
#. さすがに都市伝説だろうけど…
msgctxt "0032 | MAKOTO NAEGI"
msgid ""
"They say he's killed thousands of people. But that's\n"
"gotta be an urban legend..."
msgstr ""
"Người ta nói hắn đã giết hàng ngàn người. Nhưng đó chắc\n"
"chắn là một truyền thuyết đô thị thôi..."

#. とにかく、ボク達の中に
#. そんな常軌を逸した殺人鬼がいるって事…？
msgctxt "0033 | MAKOTO NAEGI"
msgid ""
"Still, could one of us really be a demented, psychotic\n"
"killer like that?"
msgstr ""
"Tuy vậy, liệu một người trong số chúng ta thực sự có thể\n"
"là một kẻ sát nhân biến thái, tâm thần như thế sao?"

#. ああ、その通りだ…
msgctxt "0034 | BYAKUYA TOGAMI"
msgid "You're not wrong to wonder."
msgstr "Cậu thắc mắc cũng không sai đâu."

#. でも…いくらなんでも…
msgctxt "0035 | MAKOTO NAEGI"
msgid "But words mean little right now."
msgstr "Nhưng lúc này lời nói chẳng có mấy ý nghĩa."

#. そう確信出来る根拠もあるぞ。
#. お前に、それを見せてやろう…
msgctxt "0036 | BYAKUYA TOGAMI"
msgid ""
"I have something that will prove it. And I can show\n"
"you."
msgstr ""
"Tôi có thứ có thể chứng minh điều đó. Và tôi có thể cho\n"
"cậu thấy."

#. <CLT 4>玄関ホールに…来たけど……
#. <CLT>
msgctxt "0037 | MAKOTO NAEGI"
msgid ""
"<CLT 4>We came to...the main hall.\n"
"<CLT>"
msgstr ""
"<CLT 4>Bọn mình đã đến... sảnh chính.\n"
"<CLT>"

#. …十神クン、ここに何があるの？
msgctxt "0038 | MAKOTO NAEGI"
msgid "So...what are we looking for here?"
msgstr "Vậy... chúng ta đang tìm kiếm thứ gì ở đây?"

#. ………………
msgctxt "0039 | BYAKUYA TOGAMI"
msgid "..."
msgstr "..."

#. <CLT 4>自分で考えろって事か…
#. <CLT>
msgctxt "0040 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Does that mean I have to figure it out for myself?\n"
"<CLT>"
msgstr ""
"<CLT 4>Có nghĩa là mình phải tự mình tìm hiểu sao?\n"
"<CLT>"

#. ………………
msgctxt "0041 | BYAKUYA TOGAMI"
msgid "..."
msgstr "..."

#. <CLT 4>自分で考えろって事か…
#. <CLT>
msgctxt "0042 | BYAKUYA TOGAMI"
msgid ""
"<CLT 4>Does that mean I have to figure it out for myself?\n"
"<CLT>"
msgstr ""
"<CLT 4>Có nghĩa là mình phải tự mình tìm hiểu sao?\n"
"<CLT>"

#. 十神クン、正確には違うって…
#. どういう意味？
msgctxt "0043 | MAKOTO NAEGI"
msgid ""
"What do you mean by that, Byakuya? \"To be exact...not\n"
"quite.\""
msgstr "Ý cậu là sao hả Byakuya? \"Chính xác thì... không hẳn.\""

#. 確かに、俺が突き止めたいのは犯人だが、
#. より正確に言うならば…
msgctxt "0044 | BYAKUYA TOGAMI"
msgid ""
"Certainly I want to reveal Chihiro's killer, but more\n"
"precisely..."
msgstr ""
"Tất nhiên là tôi muốn vạch mặt kẻ giết Chihiro, nhưng\n"
"nói một cách chính xác hơn..."

#. <CLT 3>ジェノサイダー翔の正体<CLT>だ。
msgctxt "0045 | BYAKUYA TOGAMI"
msgid ""
"...I want to discover the <CLT 3>true identity of Genocide\n"
"Jack<CLT>."
msgstr "...tôi muốn khám phá ra <CLT 3>thân phận thực sự của Jack Đồ Tể<CLT>."

#. じゃあ、十神クンは本当に…
msgctxt "0046 | MAKOTO NAEGI"
msgid "Then...you really think...?"
msgstr "Vậy... cậu thực sự nghĩ...?"

#. 不二咲さんを殺したのは、
#. ジェノサイダー翔だと思ってるの？
msgctxt "0047 | MAKOTO NAEGI"
msgid ""
"You truly believe Genocide Jack is the one that killed\n"
"Chihiro?"
msgstr "Cậu thực sự tin rằng Jack Đồ Tể là kẻ đã giết Chihiro sao?"

#. …当然だ。今回の事件の犯人は、
#. <CLT 1>【ジェノサイダー翔】<CLT>で間違いない。
msgctxt "0048 | BYAKUYA TOGAMI"
msgid ""
"Absolutely. I have no doubt that <CLT 1>[Genocide Jack]<CLT> is\n"
"the culprit in this case."
msgstr ""
"Chắc chắn rồi. Tôi không nghi ngờ gì việc <CLT 1>[Jack Đồ Tể]<CLT>\n"
"chính là kẻ thủ ác trong vụ án này."

#. 俺は<CLT 1>【確信】<CLT>を持っている。
#. ジェノサイダー翔は、俺達の中にいるんだ。
msgctxt "0049 | BYAKUYA TOGAMI"
msgid ""
"And I have a <CLT 1>[basis]<CLT> to believe that. I assure you,\n"
"Genocide Jack is one of us."
msgstr ""
"Và tôi có <CLT 1>[căn cứ]<CLT> để tin vào điều đó. Tôi cam đoan với\n"
"cậu, Jack Đồ Tể là một trong số chúng ta."

#. うるさい女だな…
msgctxt "0050 | BYAKUYA TOGAMI"
msgid "Such an annoying girl..."
msgstr "Thật là một cô nàng phiền phức..."

#. 緊急事態なの緊急事態！！
#. だから助けて…お願いお願いッ！！
msgctxt "0051 | AOI ASAHINA"
msgid ""
"This is a serious emergency! Please, please! You gotta\n"
"help me!"
msgstr ""
"Đây là tình trạng cực kỳ khẩn cấp! Làm ơn, làm ơn đi!\n"
"Phải giúp tui với!"

#. ちょっと落ち着いて、朝日奈さん…
msgctxt "0052 | MAKOTO NAEGI"
msgid "Just calm down, okay Hina?"
msgstr "Bình tĩnh lại đi mà Hina."

#. だって…だってね…
#. <CLT 1>【緊急事態】<CLT>なんだよ…！
msgctxt "0053 | AOI ASAHINA"
msgid "But...but...! It's an <CLT 1>[e-mer-gen-cyyy]<CLT>!"
msgstr "Nhưng... nhưng...! Đây là <CLT 1>[tình trạng khẩn cấp]<CLT>!"

#. <CLT 4>モノクマが写るモニター…
#. 今は校章が浮かんでいるだけだ…
#. <CLT>
msgctxt "0054 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is one of the monitors Monokuma appears on.\n"
"Right now, it's just showing the school crest.\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là một trong những chiếc màn hình mà Monokuma xuất hiện.\n"
"Hiện tại, nó chỉ đang hiển thị biểu tượng của trường.\n"
"<CLT>"

#. ここには手掛かりはなさそうだ。
msgctxt "0055 | MAKOTO NAEGI"
msgid "I don't see any clues around here anywhere."
msgstr "Mình không thấy bất kỳ manh mối nào quanh đây cả."

#. <CLT 4>監視カメラ…に銃みたいな物が付いている…
#. <CLT>
msgctxt "0056 | MAKOTO NAEGI"
msgid ""
"<CLT 4>A surveillance camera... And there's what I can only\n"
"assume is a gun attached to it.\n"
"<CLT>"
msgstr ""
"<CLT 4>Một chiếc camera giám sát... Và có thứ mà mình chỉ có\n"
"thể giả định là một khẩu súng gắn trên đó.\n"
"<CLT>"

#. <CLT 4>もの凄い…威圧感だな…
#. <CLT>
msgctxt "0057 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It's so...chilling.\n"
"<CLT>"
msgstr ""
"<CLT 4>Thật là... rùng mình.\n"
"<CLT>"

#. <CLT 4>入口は…機械のような鉄の塊で
#. 塞がれてしまっている…
#. <CLT>
msgctxt "0058 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The hunk of metal blocking the entrance seems like\n"
"some kind of...machine.\n"
"<CLT>"
msgstr ""
"<CLT 4>Khối kim loại chặn lối vào trông giống như một loại...\n"
"máy móc nào đó.\n"
"<CLT>"

#. <CLT 4>レターケースが置いてある。
#. <CLT>
msgctxt "0059 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There's a mailbox here.\n"
"<CLT>"
msgstr ""
"<CLT 4>Có một cái hộp thư ở đây.\n"
"<CLT>"

#. <CLT 4>もしかして、この中に何か…
#. <CLT>
msgctxt "0060 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Could there be something inside...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Liệu có thứ gì bên trong không nhỉ...?\n"
"<CLT>"

#. <CLT 4>これって、<CLT><CLT 3>電子生徒手帳<CLT><CLT 4>！？
#. <CLT>
msgctxt "0061 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It's...an <CLT><CLT 3>e-Handbook<CLT><CLT 4>!?\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là... <CLT><CLT 3>sổ học sinh điện tử<CLT><CLT 4>!?\n"
"<CLT>"

#. <CLT 4>しかも、３つもある！
#. でも、どうしてこんな所に！？
#. <CLT>
msgctxt "0062 | MAKOTO NAEGI"
msgid ""
"<CLT 4>No, wait...there's *three* of them! But what are they\n"
"doing here?\n"
"<CLT>"
msgstr ""
"<CLT 4>Không, đợi đã... có tận *ba* cái luôn! Nhưng chúng làm\n"
"gì ở đây thế này?\n"
"<CLT>"

#. 見つけたようだな…
msgctxt "0063 | BYAKUYA TOGAMI"
msgid "So, you finally found them."
msgstr "Vậy, cuối cùng cậu cũng tìm thấy rồi."

#. え？　十神クンは知ってるの？
#. この電子生徒手帳がなんだか…
msgctxt "0064 | MAKOTO NAEGI"
msgid "Huh? Did you know these were here, Byakuya?"
msgstr "Hả? Cậu đã biết chúng ở đây rồi sao Byakuya?"

#. 俺も、この間たまたま見つけたんだが…
msgctxt "0065 | BYAKUYA TOGAMI"
msgid ""
"I happened to find them by chance myself the other\n"
"day."
msgstr "Mấy hôm trước tôi cũng vô tình tìm thấy thôi."

#. どうやら、<CLT 3>死んだ人間の電子生徒手帳<CLT>は、
#. そこのレターケースに<CLT 3>“返還”<CLT>される仕組みらしい。
msgctxt "0066 | BYAKUYA TOGAMI"
msgid ""
"It seems there's a system in place where the\n"
"<CLT 3>handbooks of dead students<CLT> get \"<CLT 3>delivered<CLT>\" to this mailbox."
msgstr ""
"Có vẻ như có một hệ thống mà theo đó <CLT 3>sổ tay điện tử của những\n"
"người đã chết<CLT> sẽ được \"<CLT 3>trả lại<CLT>\" vào cái hộp thư đó."

#. じゃあ、この３つの電子生徒手帳って…
msgctxt "0067 | MAKOTO NAEGI"
msgid "So then, these three handbooks belong to..."
msgstr "Vậy thì, ba cuốn sổ tay này thuộc về..."

#. 江ノ島さんと桑田クンと…
#. 舞園さんの物…？
msgctxt "0068 | MAKOTO NAEGI"
msgid "...Junko, Leon, and Sayaka?"
msgstr "...Junko, Leon, và Sayaka sao?"

#. 自分の目で確かめてみろ…
msgctxt "0069 | BYAKUYA TOGAMI"
msgid "You can go ahead and confirm it yourself."
msgstr "Cậu có thể tự mình kiểm tra đi."

#. <CLT 4>ボクは、すぐに電子生徒手帳の１つを起動させてみた。
#. すると…
#. <CLT>
msgctxt "0070 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I immediately turned on one of the handbooks. And when\n"
"I did...\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình lập tức khởi động một trong những cuốn sổ tay. Và\n"
"khi mình làm vậy...\n"
"<CLT>"

#. ホントだ…舞園さんの電子生徒手帳だ…！
msgctxt "0071 | MAKOTO NAEGI"
msgid "You're right! This is Sayaka's handbook!"
msgstr "Cậu nói đúng rồi! Đây là sổ tay của Sayaka!"

#. これでわかっただろう？
#. さっき言っていた<CLT 3>“抜け道”<CLT>の意味が…
msgctxt "0072 | BYAKUYA TOGAMI"
msgid ""
"Now do you understand? This is the key to the\n"
"<CLT 3>loophole<CLT> that I revealed earlier."
msgstr ""
"Giờ cậu đã hiểu chưa? Đây chính là chìa khóa cho cái <CLT 3>lỗ\n"
"hổng<CLT> mà tôi đã tiết lộ lúc nãy đấy."

#. …うん、わかった気がするよ。
msgctxt "0073 | MAKOTO NAEGI"
msgid "Yeah, I feel like I'm starting to get it..."
msgstr "Ừ, tớ cảm thấy mình bắt đầu hiểu ra rồi..."

#. もう一度、よく校則を確認してみるんだな。
#. 追加されたルールには、こうあったはずだ。
msgctxt "0074 | BYAKUYA TOGAMI"
msgid ""
"You should pay closer attention to the regulations.\n"
"The answer has been in front of you the entire time."
msgstr ""
"Cậu nên chú ý kỹ hơn vào các quy định đi. Câu trả lời\n"
"vốn đã luôn nằm ngay trước mắt cậu rồi."

#. 『電子生徒手帳の他人への貸与禁止』とな…
msgctxt "0075 | BYAKUYA TOGAMI"
msgid ""
"\"Loaning your e-Handbook to another student is\n"
"strictly prohibited.\""
msgstr ""
"\"Nghiêm cấm việc cho học sinh khác mượn sổ học sinh điện\n"
"tử của mình.\""

#. 禁止されてるのは、他人に貸す行為だけだ。
#. <CLT 3>借りる事は禁止されていない<CLT>。
msgctxt "0076 | BYAKUYA TOGAMI"
msgid ""
"Only the act of *loaning* a handbook is prohibited.\n"
"<CLT 3>Borrowing someone else's is perfectly fine<CLT>."
msgstr ""
"Chỉ có hành vi *cho mượn* sổ tay là bị cấm thôi. <CLT 3>Việc\n"
"mượn của người khác thì hoàn toàn không vấn đề gì<CLT>."

#. <CLT 4>そうか…そういう事だったんだな…
#. <CLT>
msgctxt "0077 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I see...yeah, now I understand.\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình hiểu rồi... phải, giờ mình đã hiểu.\n"
"<CLT>"

#. <CLT 23><CLT><CLT 3>玄関ホールの電子生徒手帳<CLT><CLT 23>を手帳に記録しました。
#. 言弾（コトダマ）メニューで確認できます。
#. <CLT>
msgctxt "0078 | NARRATION"
msgid ""
"<CLT 23>\"<CLT><CLT 3>Main Hall e-Handbooks<CLT><CLT 23>\" has been added to the Truth\n"
"Bullets section of your handbook.\n"
"<CLT>"
msgstr ""
"<CLT 23>\"<CLT><CLT 3>Sổ Học Sinh Sảnh Chính<CLT><CLT 23>\" đã được thêm vào phần Đạn Sự\n"
"Thật trong sổ học sinh của bạn.\n"
"<CLT>"

#. ん…？　これはなんだ…？
msgctxt "0079 | BYAKUYA TOGAMI"
msgid "Hm? Hold on a second..."
msgstr "Hử? Đợi một chút đã..."

#. …どうかしたの？
msgctxt "0080 | MAKOTO NAEGI"
msgid "What's wrong?"
msgstr "Có chuyện gì vậy?"

#. 妙だな。ここにある電子生徒手帳の１つだけが…
msgctxt "0081 | BYAKUYA TOGAMI"
msgid "That's strange. One of the handbooks..."
msgstr "Thật kỳ lạ. Một trong số những cuốn sổ tay..."

#. …<CLT 3>起動しなくなっている<CLT>。
msgctxt "0082 | BYAKUYA TOGAMI"
msgid "...<CLT 3>won't turn on<CLT>."
msgstr "...<CLT 3>không thể khởi động được<CLT>."

#. 壊れてるって事？　それって誰の？
msgctxt "0083 | MAKOTO NAEGI"
msgid "Is it broken? Whose is it?"
msgstr "Nó bị hỏng rồi sao? Của ai vậy?"

#. もう１つの電子生徒手帳の起動画面には、
#. 江ノ島盾子と出る…
msgctxt "0084 | BYAKUYA TOGAMI"
msgid ""
"The other handbook showed Junko's name when I started\n"
"it up."
msgstr "Cuốn sổ tay còn lại hiển thị tên của Junko khi tôi khởi động nó."

#. じゃあ、起動しないのって…桑田クンの？
msgctxt "0085 | MAKOTO NAEGI"
msgid ""
"Then the one that won't turn on must be...Leon's,\n"
"right?"
msgstr "Vậy thì cái không khởi động được chắc là... của Leon đúng không?"

#. …だとしたら無理ないのかもな。
msgctxt "0086 | BYAKUYA TOGAMI"
msgid "It would make sense, yes."
msgstr "Cũng hợp lý thôi, đúng vậy."

#. 硬球で…あれだけ滅多打ちにされてはな…
msgctxt "0087 | BYAKUYA TOGAMI"
msgid ""
"After all, he did get pummeled with dozens and dozens\n"
"of baseballs."
msgstr ""
"Dù sao thì cậu ta cũng đã bị hàng tá quả bóng chày ném\n"
"trúng liên tục mà."

#. <CLT 4>硬球で…滅多打ち…
#. <CLT>
msgctxt "0088 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Pummeled with baseballs...\n"
"<CLT>"
msgstr ""
"<CLT 4>Bị ném trúng bởi bóng chày...\n"
"<CLT>"

#. <CLT 4>つい思い出してしまった…
#. <CLT>
msgctxt "0089 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The memory of it came flooding back.\n"
"<CLT>"
msgstr ""
"<CLT 4>Ký ức về chuyện đó lại ùa về.\n"
"<CLT>"

#. <CLT 4>桑田クンを死に至らしめた…あの残酷な処刑…
#. <CLT>
msgctxt "0090 | MAKOTO NAEGI"
msgid ""
"<CLT 4>That cruel punishment, which led to Leon's death...\n"
"<CLT>"
msgstr ""
"<CLT 4>Hình phạt tàn khốc đó, thứ đã dẫn đến cái chết của Leon...\n"
"<CLT>"

#. <CLT 4>黒幕のヤツが仕組んだ…
#. <CLT>
msgctxt "0091 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The execution that the mastermind concocted...\n"
"<CLT>"
msgstr ""
"<CLT 4>Buổi hành quyết mà kẻ chủ mưu đã dàn dựng...\n"
"<CLT>"

#. <CLT 4>惨たらしくて悪趣味な処刑を……
#. <CLT>
msgctxt "0092 | MAKOTO NAEGI"
msgid ""
"<CLT 4>A cruel, heartless death...\n"
"<CLT>"
msgstr ""
"<CLT 4>Một cái chết tàn nhẫn, không chút nhân tính...\n"
"<CLT>"

#. 確かに…あれだけやられたら…
#. 壊れてもおかしくないよ…
msgctxt "0093 | MAKOTO NAEGI"
msgid ""
"You're right. It wouldn't be surprising for the\n"
"handbook to break during that kind of assault."
msgstr ""
"Cậu nói đúng. Chẳng có gì ngạc nhiên nếu cuốn sổ tay bị\n"
"hỏng trong một cuộc tấn công như vậy."

#. コラコラ…！
msgctxt "0094 | MONOKUMA"
msgid "Hey, hey!"
msgstr "Này, này!"

#. コラコラコラコラ…！
msgctxt "0095 | MONOKUMA"
msgid "Hey hey hey hey hey!"
msgstr "Này này này này này!"

#. コラァッ！！
msgctxt "0096 | MONOKUMA"
msgid "HEEEY!"
msgstr "NÀY!"

#. な、なんだよ…
msgctxt "0097 | MAKOTO NAEGI"
msgid "Wh-What...?"
msgstr "C-Cái gì...?"

#. その電子生徒手帳はなぁ、
#. この学園生活において必要不可欠なアイテムなんだ。
msgctxt "0098 | MONOKUMA"
msgid ""
"That e-Handbook is essential to student life here!\n"
"Crucial, integral, instrumental, a super big deal!"
msgstr ""
"Cuốn sổ học sinh đó là vật dụng thiết yếu cho đời sống học sinh\n"
"ở đây đấy! Cực kỳ quan trọng, không thể thiếu, một vấn đề lớn!"

#. だから、そんなに簡単に<CLT 3>壊れたりしない<CLT>のッ！！
msgctxt "0099 | MONOKUMA"
msgid "There's no way it would <CLT 3>break<CLT> that easily!"
msgstr ""
"Không đời nào nó lại có thể <CLT 3>bị hỏng<CLT> dễ dàng \n"
"như vậy!"

#. でも、実際に…
msgctxt "0100 | MAKOTO NAEGI"
msgid "But it did..."
msgstr "Nhưng thực tế nó đã..."

#. 壊れないったら壊れないのッ！！
msgctxt "0101 | MONOKUMA"
msgid ""
"If I say it wouldn't break, it wouldn't freakin'\n"
"break!"
msgstr "Ta đã bảo nó không hỏng là nó không bao giờ hỏng được!"

#. だって、１０トンの衝撃にも耐えられるし、
#. 水深１００メートルでもへっちゃらなんだよ？
msgctxt "0102 | MONOKUMA"
msgid ""
"It can withstand up to ten tons of pressure, and it's\n"
"waterproof up to a hundred meters, okay!?"
msgstr ""
"Nó có thể chịu được áp lực lên đến mười tấn, và còn\n"
"chống nước ở độ sâu một trăm mét nữa đấy, rõ chưa hả!?"

#. 硬球なんて、いくらぶつけたところで、
#. 壊れたりする訳ないじゃーん！！
msgctxt "0103 | MONOKUMA"
msgid ""
"I don't care how many baseballs you hit it with, it\n"
"wouldn't do crap!"
msgstr ""
"Ta không cần biết các cậu có ném bao nhiêu quả bóng chày\n"
"vào nó đi chăng nữa, nó cũng chẳng hề hấn gì đâu!"

#. あっ、でも…そんな電子生徒手帳にも、
#. 唯一の<CLT 3>“弱点”<CLT>があるんですけどね…
msgctxt "0104 | MONOKUMA"
msgid ""
"Oh, but uh...even my amazing handbook does have one\n"
"single <CLT 3>weak point<CLT>."
msgstr ""
"Ồ, nhưng ừm... ngay cả cuốn sổ tay tuyệt vời của ta cũng\n"
"có một <CLT 3>điểm yếu<CLT> duy nhất đấy."

#. 弱点…？
msgctxt "0105 | MAKOTO NAEGI"
msgid "It does?"
msgstr "Có sao?"

#. 内緒だよ。それを教えちゃって壊されたら困るし。
msgctxt "0106 | MONOKUMA"
msgid ""
"But it's a secret! I wouldn't want you to go breaking\n"
"any more handbooks!"
msgstr ""
"Nhưng đó là một bí mật! Ta không muốn bọn mi lại đi làm\n"
"hỏng thêm bất kỳ cuốn sổ tay nào nữa đâu!"

#. では、桑田は知らず知らずの内に、
#. その弱点突いて、壊してしまったのか？
msgctxt "0107 | BYAKUYA TOGAMI"
msgid ""
"Then Leon must have broken it somehow without\n"
"realizing what its weakness was, right?"
msgstr ""
"Vậy thì hẳn là Leon đã vô tình làm hỏng nó mà không nhận\n"
"ra điểm yếu của nó là gì rồi, phải không?"

#. さぁ、どうでしょう？
msgctxt "0108 | MONOKUMA"
msgid "Hmm...hard to say!"
msgstr "Hừm... khó nói lắm nha!"

#. ボクはこう思うけどね。
#. 彼の電子生徒手帳は壊れてないって。
msgctxt "0109 | MONOKUMA"
msgid ""
"You know what I think? I think his handbook isn't\n"
"actually broken!"
msgstr ""
"Các em biết ta nghĩ gì không? Ta nghĩ cuốn sổ tay của\n"
"cậu ta thực ra chẳng hề bị hỏng đâu!"

#. さぁ、どうなんでしょう…！？
msgctxt "0110 | MONOKUMA"
msgid "But, you might ask, how could that be!?"
msgstr ""
"Nhưng, các em hẳn sẽ hỏi, làm sao chuyện đó có thể xảy \n"
"ra được!?"

#. <CLT 4>意味深な言葉だけ残して、
#. モノクマはまた消えた…
#. <CLT>
msgctxt "0111 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Leaving the question hanging in the air, Monokuma\n"
"disappeared.\n"
"<CLT>"
msgstr ""
"<CLT 4>Để lại câu hỏi còn đang bỏ ngỏ, Monokuma đã \n"
"biến mất.\n"
"<CLT>"

#. …なんだったのだろうね、今の。
msgctxt "0112 | MAKOTO NAEGI"
msgid "What just happened?"
msgstr "Chuyện gì vừa xảy ra vậy?"

#. モノクマは壊れてないって言ってたけど…
#. でも、桑田クンの手帳が起動しないのも事実だし…
msgctxt "0113 | MAKOTO NAEGI"
msgid ""
"Monokuma said it's not broken. But it's an undeniable\n"
"fact that it's not turning on."
msgstr ""
"Monokuma bảo nó không hỏng. Nhưng có một sự thật không\n"
"thể phủ nhận là nó không thể khởi động được."

#. 大した問題ではない。
#. 少なくとも、今回の事件とは無関係のはずだ。
msgctxt "0114 | BYAKUYA TOGAMI"
msgid ""
"Well, I don't see any connection to the case, so it\n"
"doesn't matter for now."
msgstr ""
"Hừm, tôi không thấy nó có liên quan gì đến vụ án cả, \n"
"nên tạm thời không quan trọng đâu."

#. <CLT 4>それでいいのかなぁ…
#. 何か引っかかるんだけど…
#. <CLT>
msgctxt "0115 | MAKOTO NAEGI"
msgid ""
"<CLT 4>You think so? Either way, something about it still\n"
"bothers me...\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu nghĩ vậy sao? Dù sao thì, có điều gì đó về chuyện\n"
"này vẫn khiến mình bận tâm...\n"
"<CLT>"

#. <CLT 23><CLT><CLT 3>壊れた電子生徒手帳<CLT><CLT 23>を手帳に記録しました。
#. 言弾（コトダマ）メニューで確認できます。
#. <CLT>
msgctxt "0116 | NARRATION"
msgid ""
"<CLT 23>\"<CLT><CLT 3>Broken e-Handbook<CLT><CLT 23>\" has been added to the Truth\n"
"Bullets section of your handbook.\n"
"<CLT>"
msgstr ""
"<CLT 23>\"<CLT><CLT 3>Sổ Học Sinh Hỏng<CLT><CLT 23>\" đã được thêm vào phần\n"
"Đạn Sự Thật trong sổ học sinh của bạn.\n"
"<CLT>"

#. さてと…前置きはこれくらいで十分だろう。
msgctxt "0117 | BYAKUYA TOGAMI"
msgid ""
"Okay then, this should be enough to get things\n"
"rolling."
msgstr ""
"Được rồi, thế này là đủ để mọi chuyện bắt đầu tiến triển\n"
"rồi đấy."

#. そろそろ、本格的に捜査を進めて、
#. ヤツの正体を突き止めるとするか。
msgctxt "0118 | BYAKUYA TOGAMI"
msgid ""
"Let's begin our investigation in earnest and track\n"
"down the true culprit."
msgstr ""
"Hãy bắt đầu cuộc điều tra một cách nghiêm túc và truy\n"
"tìm tung tích của kẻ thủ ác thực sự thôi."

#. 不二咲さんを殺した…犯人だね？
msgctxt "0119 | MAKOTO NAEGI"
msgid "Yeah. We need to find out who killed Chihiro!"
msgstr "Ừ. Chúng ta cần tìm ra kẻ đã giết Chihiro!"

#. …正確には違うな。
msgctxt "0120 | BYAKUYA TOGAMI"
msgid "To be exact...not quite."
msgstr "Chính xác thì... không hẳn đâu."

#. <CLT 4>え？　正確には違う…？
#. <CLT>
msgctxt "0121 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Huh? Not...quite?\n"
"<CLT>"
msgstr ""
"<CLT 4>Hả? Không... hẳn sao?\n"
"<CLT>"

#. <CLT 4>レターケースが置いてある。この中には…
#. <CLT>
msgctxt "0122 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There's a mailbox here. And inside...\n"
"<CLT>"
msgstr ""
"<CLT 4>Có một cái hộp thư ở đây. Và bên trong...\n"
"<CLT>"

#. <CLT 4>３つの電子生徒手帳がある。
#. <CLT>
msgctxt "0123 | MAKOTO NAEGI"
msgid ""
"<CLT 4>...are three e-Handbooks.\n"
"<CLT>"
msgstr ""
"<CLT 4>...là ba cuốn sổ học sinh điện tử.\n"
"<CLT>"

#. <CLT 4>おそらく、江ノ島さんと桑田クンと舞園さんの物だ…
#. <CLT>
msgctxt "0124 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I have to assume they're Junko's, Leon's, and\n"
"Sayaka's.\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình giả định rằng chúng là của Junko, Leon, \n"
"và Sayaka.\n"
"<CLT>"

#. <CLT 4>どうやら、死んだ生徒の電子生徒手帳は、
#. このレターケースに返還される仕組みらしい。
#. <CLT>
msgctxt "0125 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It looks like the handbooks of any dead students are\n"
"brought here to the mailbox somehow.\n"
"<CLT>"
msgstr ""
"<CLT 4>Có vẻ như sổ tay của bất kỳ học sinh nào đã chết đều\n"
"bằng cách nào đó được đưa đến cái hộp thư này.\n"
"<CLT>"

#. <CLT 4>校則にあるのは、
#. 『電子生徒手帳の他人への貸与禁止』
#. <CLT>
msgctxt "0126 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The rule says, \"Loaning your e-Handbook to another\n"
"student is strictly prohibited.\"\n"
"<CLT>"
msgstr ""
"<CLT 4>Quy tắc ghi rằng, \"Nghiêm cấm việc cho học sinh khác\n"
"mượn sổ học sinh điện tử của mình.\"\n"
"<CLT>"

#. <CLT 4><CLT 4>禁止されてるのは他人に貸すって行為だけ。
#. つまり、<CLT><CLT 3>借りる事は禁止されていない<CLT><CLT 4>。
#. <CLT>
msgctxt "0127 | MAKOTO NAEGI"
msgid ""
"<CLT 4><CLT 4>Only *lending* it against the rules. In other words,\n"
"<CLT><CLT 3>there's no problem with borrowing one<CLT><CLT 4>.\n"
"<CLT>"
msgstr ""
"<CLT 4><CLT 4>Chỉ có việc *cho mượn* là vi phạm quy tắc. Nói cách\n"
"khác, <CLT><CLT 3>việc mượn một cái thì chẳng có vấn đề gì cả<CLT><CLT 4>.\n"
"<CLT>"

#. <CLT 4>それと、もう１つ気になるのは…
#. <CLT>
msgctxt "0128 | MAKOTO NAEGI"
msgid ""
"<CLT 4>One other thing that bothers me...\n"
"<CLT>"
msgstr ""
"<CLT 4>Một điều khác khiến mình bận tâm...\n"
"<CLT>"

#. <CLT 4>桑田クンの電子生徒手帳が、
#. <CLT><CLT 3>起動しない<CLT><CLT 4>って事だ…
#. <CLT>
msgctxt "0129 | MAKOTO NAEGI"
msgid ""
"<CLT 4>...is the fact that Leon's handbook <CLT><CLT 3>won't turn on<CLT><CLT 4>.\n"
"<CLT>"
msgstr ""
"<CLT 4>...chính là việc sổ tay của Leon <CLT><CLT 3>không \n"
"thể khởi động được<CLT><CLT 4>.\n"
"<CLT>"

#. <CLT 4>モノクマは壊れてないって言ってたけど…
#. でも、起動しないのは事実だ。
#. <CLT>
msgctxt "0130 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Monokuma said Leon's handbook isn't broken. But it\n"
"won't turn on, that much is certain.\n"
"<CLT>"
msgstr ""
"<CLT 4>Monokuma bảo sổ tay của Leon không hỏng. Nhưng việc nó\n"
"không khởi động được là điều chắc chắn.\n"
"<CLT>"

#. <CLT 4>今回の事件とは無関係なのかなぁ…
#. 何か引っ掛かるんだけど…
#. <CLT>
msgctxt "0131 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Is it really unrelated to the case? Either way,\n"
"something about it still bothers me...\n"
"<CLT>"
msgstr ""
"<CLT 4>Liệu nó thực sự không liên quan đến vụ án sao? Dù sao thì, có\n"
"điều gì đó về chuyện này vẫn khiến mình bận tâm...\n"
"<CLT>"

#. <CLT 4>監視カメラ…に銃みたいな物が付いている…
#. <CLT>
msgctxt "0132 | MAKOTO NAEGI"
msgid ""
"<CLT 4>A surveillance camera... And there's what I can only\n"
"assume is a gun attached to it.\n"
"<CLT>"
msgstr ""
"<CLT 4>Camera giám sát... Và dường như có một khẩu súng \n"
"được gắn trên đó nữa...\n"
"<CLT>"

#. <CLT 4>もの凄い…威圧感だ…
#. <CLT>
msgctxt "0133 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It's so...chilling.\n"
"<CLT>"
msgstr ""
"<CLT 4>Thật là... rùng mình.\n"
"<CLT>"

#. 待て…
#. まだここで調べるべき事があるだろう。
msgctxt "0134 | BYAKUYA TOGAMI"
msgid ""
"Hold on. There's still more here waiting to be\n"
"checked."
msgstr ""
"Khoan đã. Vẫn còn nhiều thứ ở đây đang chờ \n"
"được kiểm tra."

#. 緊急事態なんだってば～！
#. 助けてッ！！
msgctxt "0135 | AOI ASAHINA"
msgid "I said it's an emergency! Come help me!"
msgstr "Tui đã bảo đây là tình trạng khẩn cấp mà! Đến giúp tui đi!"


────────────────────────────────────────────────────────────────────────
  CHAPTER  e02_028_026 Locker Room Card-reader
────────────────────────────────────────────────────────────────────────

  [ERROR]  e02_028_026
    ✗ msgid ""
msgstr ""
"Project-Id-Version: DR1 (PC)\n"
"Report-Msgid-Bugs-To: your_email\n"
"POT-Creation-Date: 3/26/2026\n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: en_US\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Generator: Poedit 3.8\n"

#. よし、次はここだ…
msgctxt "0001 | BYAKUYA TOGAMI"
msgid "So, this is our next location."
msgstr "Vậy, đây là địa điểm tiếp theo của chúng ta."

#. え？　このホールも事件に関係してるの？
msgctxt "0002 | MAKOTO NAEGI"
msgid "Huh? This place is related to the investigation?"
msgstr "Hả? Nơi này cũng liên quan đến cuộc điều tra sao?"

#. …自分で考えろ。
#. それでなければ面白くないだろう？
msgctxt "0003 | BYAKUYA TOGAMI"
msgid ""
"Figure it out for yourself. It's no fun if you don't,\n"
"right?"
msgstr ""
"Tự mình tìm hiểu đi. Nếu không thì còn gì là thú vị nữa,\n"
"phải không?"

#. ………………
msgctxt "0004 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. …調べる場所くらいは、自分で考えろ。
msgctxt "0005 | BYAKUYA TOGAMI"
msgid ""
"You could at least try and figure out where we should\n"
"check without my help."
msgstr ""
"Ít nhất cậu cũng nên thử tự mình tìm xem chúng ta cần\n"
"kiểm tra những gì mà không cần tôi giúp chứ."

#. <CLT 4>モノクマが写るモニター…
#. なんかを気にしている場合じゃないな…
#. <CLT>
msgctxt "0006 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is one of the monitors Monokuma appears on. Now's\n"
"no time to think about it...\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là một trong những chiếc màn hình mà Monokuma thường\n"
"xuất hiện. Bây giờ không phải lúc để tâm đến nó đâu...\n"
"<CLT>"

#. <CLT 4>監視カメラ…
#. <CLT>
msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>A surveillance camera...\n"
"<CLT>"
msgstr ""
"<CLT 4>Một chiếc camera giám sát...\n"
"<CLT>"

#. <CLT 4>黒幕は、この監視カメラで見ていたはずだ。
#. 不二咲さんが殺されたところも…
#. <CLT>
msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Even as Chihiro was being murdered, I bet the\n"
"mastermind was just sitting there watching...\n"
"<CLT>"
msgstr ""
"<CLT 4>Ngay cả khi Chihiro bị sát hại, mình cá là kẻ chủ mưu\n"
"chỉ ngồi đó và quan sát thôi...\n"
"<CLT>"

#. <CLT 4>黒幕はそれを知った上で…
#. ボクらにこんな事をさせているのか…！
#. <CLT>
msgctxt "0009 | MAKOTO NAEGI"
msgid ""
"<CLT 4>They know what's happened, and they're still forcing\n"
"us to go through with this...!\n"
"<CLT>"
msgstr ""
"<CLT 4>Hắn biết rõ chuyện gì đã xảy ra, vậy mà vẫn ép chúng\n"
"mình phải trải qua chuyện này!\n"
"<CLT>"

#. そっちは現場ですらないぞ…
#. 間抜けが。
msgctxt "0010 | BYAKUYA TOGAMI"
msgid "That's not even the scene of the crime. Idiot."
msgstr ""
"Đó thậm chí còn chẳng phải hiện trường vụ án. \n"
"Thằng ngốc."

#. もう現場は調べたはずだ。
msgctxt "0011 | BYAKUYA TOGAMI"
msgid ""
"You've already spent plenty of time checking the crime\n"
"scene."
msgstr ""
"Cậu đã dành quá đủ thời gian để kiểm tra hiện trường \n"
"vụ án rồi."

#. それに、まだここで調べるべき事が
#. 残っているぞ。
msgctxt "0012 | BYAKUYA TOGAMI"
msgid "There are plenty of other things left to check here."
msgstr "Vẫn còn rất nhiều thứ khác cần phải kiểm tra ở đây."

#. 確か、この<CLT 3>カードリーダー<CLT>って、
#. 電子生徒手帳に対応しているんだよね？
msgctxt "0013 | MAKOTO NAEGI"
msgid ""
"If I remember right, this <CLT 3>card reader<CLT> is meant to\n"
"work with our handbooks, right?"
msgstr ""
"Nếu tớ nhớ không lầm, cái <CLT 3>máy đọc thẻ<CLT> này để sử\n"
"dụng cùng với sổ học sinh của chúng mình, phải không?"

#. 何か気になる事でもあるのか？
#. なら、モノクマに直接聞いてみるがいい。
msgctxt "0014 | BYAKUYA TOGAMI"
msgid ""
"Do you have an issue with it? If so, you should take\n"
"it up with Monokuma."
msgstr ""
"Cậu có vấn đề gì với nó sao? Nếu vậy, cậu nên đi mà hỏi\n"
"trực tiếp Monokuma ấy."

#. <CLT 4>と言い終わるや否や、
#. 十神クンは、パンパンと手を鳴らし…
#. <CLT>
msgctxt "0015 | MAKOTO NAEGI"
msgid ""
"<CLT 4>He said that, then quickly and sharply clapped his\n"
"hands together.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu ta nói đoạn rồi vỗ tay thật mạnh và dứt khoát.\n"
"<CLT>"

#. お呼びですかッ！！
msgctxt "0016 | MONOKUMA"
msgid "You called for me!?"
msgstr "Gọi ta đấy à!?"

#. <CLT 4>飼い慣らされてる…？
#. <CLT>
msgctxt "0017 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Has he been domesticated...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu ta thuần hóa được nó rồi sao...?\n"
"<CLT>"

#. 苗木から、お前に質問があるらしいぞ…
msgctxt "0018 | BYAKUYA TOGAMI"
msgid "It seems that Makoto has a question for you."
msgstr "Có vẻ như Makoto có một câu hỏi dành cho ngươi đấy."

#. はい、なぁにー？
msgctxt "0019 | MONOKUMA"
msgid "Sure, what's up?"
msgstr "Được thôi, chuyện gì thế?"

#. えっと…ここのカードリーダーについて、
#. 聞きたいんだ…
msgctxt "0020 | MAKOTO NAEGI"
msgid "Umm...well, it's just about this card reader."
msgstr "Ừm... chà, chỉ là về cái máy đọc thẻ này thôi."

#. そのカードリーダーは、オマエラにお配りしている
#. 電子生徒手帳に対応しています！
msgctxt "0021 | MONOKUMA"
msgid ""
"Yes, the card readers have all been designed to\n"
"interface with each of your e-Handbooks!"
msgstr ""
"Phải, tất cả các máy đọc thẻ đều được thiết kế để kết\n"
"nối với sổ học sinh điện tử của các em!"

#. <CLT 3>電子生徒手帳の性別<CLT>に応じた更衣室にしか、
#. 入れないようになっているから、注意してね！
msgctxt "0022 | MONOKUMA"
msgid ""
"You can only enter the locker room corresponding to\n"
"the <CLT 3>gender listed in your individual handbook<CLT>."
msgstr ""
"Em chỉ có thể vào phòng thay đồ tương ứng với <CLT 3>giới tính\n"
"được ghi trong sổ học sinh cá nhân<CLT> thôi nhé!"

#. ロック解除している隙に、
#. <CLT 3>２人同時で入るのも不可能<CLT>なんだったな？
msgctxt "0023 | BYAKUYA TOGAMI"
msgid ""
"And it's <CLT 3>impossible for two people in a row to go\n"
"through<CLT> while the door is unlocked, correct?"
msgstr ""
"Và việc <CLT 3>hai người cùng lúc đi qua<CLT> khi cửa đang mở là\n"
"điều không thể, đúng không?"

#. そんなエロティックテロリストがいたら…
msgctxt "0024 | MONOKUMA"
msgid ""
"If there were some sort of erotic terrorist on the\n"
"prowl..."
msgstr "Nếu có tên khủng bố biến thái nào lảng vảng quanh đây..."

#. 天井のガトリングガンで、
#. ハチの巣地獄ですわいッ！！
msgctxt "0025 | MONOKUMA"
msgid ""
"The ceiling-mounted Gatling gun would initiate a Swiss\n"
"cheese slaughter!"
msgstr ""
"Khẩu súng Gatling gắn trên trần nhà sẽ biến hắn thành\n"
"cái tổ ong ngay lập tức!"

#. それと…電子生徒手帳を<CLT 3>他人に貸す<CLT>のも、
#. <CLT 3>校則で禁止<CLT>されたんだったな。
msgctxt "0026 | BYAKUYA TOGAMI"
msgid ""
"And the <CLT 3>school regulations<CLT> prohibit anyone from\n"
"<CLT 3>lending someone else<CLT> their handbook, correct?"
msgstr ""
"Và <CLT 3>nội quy nhà trường<CLT> nghiêm cấm bất kỳ ai <CLT 3>cho người\n"
"khác mượn<CLT> sổ học sinh, đúng chứ?"

#. イエスザッツライト！
msgctxt "0027 | MONOKUMA"
msgid "Correctly correct!"
msgstr "Chuẩn không cần chỉnh!"

#. <CLT 4>だとすると…
#. <CLT>
msgctxt "0028 | MAKOTO NAEGI"
msgid ""
"<CLT 4>So then...\n"
"<CLT>"
msgstr ""
"<CLT 4>Vậy thì...\n"
"<CLT>"

#. <CLT 4>女子なら女子更衣室に…
#. 男子なら男子更衣室にしか入れないって事か…
#. <CLT>
msgctxt "0029 | MAKOTO NAEGI"
msgid ""
"<CLT 4>That means only girls can go in the girls locker room,\n"
"and only boys can go in the boys locker room.\n"
"<CLT>"
msgstr ""
"<CLT 4>Điều đó có nghĩa là chỉ có nữ mới được vào phòng thay đồ\n"
"nữ, và chỉ có nam mới được vào phòng thay đồ nam.\n"
"<CLT>"

#. <CLT 4>つまり、不二咲さんの死体が、
#. 女子更衣室で見つかったって事は…
#. <CLT>
msgctxt "0030 | MAKOTO NAEGI"
msgid ""
"<CLT 4>In other words, Chihiro's body being found in the\n"
"girls locker room means...\n"
"<CLT>"
msgstr ""
"<CLT 4>Nói cách khác, việc thi thể Chihiro được tìm thấy ở\n"
"phòng thay đồ nữ có nghĩa là...\n"
"<CLT>"

#. おい苗木…透けて見えるぞ。
msgctxt "0031 | BYAKUYA TOGAMI"
msgid "Hey, Makoto. I can see right through you."
msgstr "Này Makoto. Tôi đi guốc trong bụng cậu luôn rồi."

#. 透けて…？
msgctxt "0032 | MAKOTO NAEGI"
msgid "See right...through me?"
msgstr "Đi guốc trong bụng... tớ sao?"

#. …お前はこう考えているんだろう？
msgctxt "0033 | BYAKUYA TOGAMI"
msgid "Allow me to tell you what you're thinking..."
msgstr "Để tôi nói cho cậu biết cậu đang nghĩ gì nhé..."

#. 不二咲千尋の死体が女子更衣室で見つかった以上、
#. 犯人は女子更衣室に入ったはず…
msgctxt "0034 | BYAKUYA TOGAMI"
msgid ""
"Since Chihiro was found in the girls locker room, the\n"
"killer must have been able to get in there."
msgstr ""
"Vì Chihiro được tìm thấy trong phòng thay đồ nữ, kẻ sát\n"
"nhân chắc chắn phải vào được trong đó."

#. つまり、犯人は女子の誰かなんじゃないかと…
msgctxt "0035 | BYAKUYA TOGAMI"
msgid ""
"As such, the killer must be one of the girls. Did I\n"
"get it right?"
msgstr ""
"Thế nên, kẻ sát nhân phải là một trong số các bạn nữ.\n"
"Tôi nói đúng chứ?"

#. まったく…甘いな…
msgctxt "0036 | BYAKUYA TOGAMI"
msgid "Good lord you're simple."
msgstr "Trời ạ, cậu thật đơn giản."

#. …違うの？
msgctxt "0037 | MAKOTO NAEGI"
msgid "But am I wrong?"
msgstr "Nhưng tớ nói sai sao?"

#. もう一度、よく校則を確認してみるんだな。
#. 追加されたルールには、こうあったはずだ。
msgctxt "0038 | BYAKUYA TOGAMI"
msgid ""
"You should pay closer attention to the regulations.\n"
"The answer has been in front of you the entire time."
msgstr ""
"Cậu nên chú ý kỹ hơn vào nội quy đi. Câu trả lời vốn đã\n"
"nằm ngay trước mắt cậu bấy lâu nay rồi."

#. 『電子生徒手帳の他人への貸与禁止』とな…
msgctxt "0039 | BYAKUYA TOGAMI"
msgid ""
"\"Loaning your e-Handbook to another student is\n"
"strictly prohibited.\""
msgstr ""
"\"Nghiêm cấm việc cho học sinh khác mượn sổ học sinh điện\n"
"tử của mình.\""

#. 禁止されてるのは、他人に貸す行為だけだ。
#. <CLT 3>借りる事は禁止されていない<CLT>。
msgctxt "0040 | BYAKUYA TOGAMI"
msgid ""
"Only the act of *loaning* a handbook is prohibited.\n"
"<CLT 3>Borrowing someone else's is perfectly fine<CLT>."
msgstr ""
"Chỉ có hành vi *cho mượn* sổ tay là bị cấm thôi. <CLT 3>Việc\n"
"mượn của người khác thì hoàn toàn không vấn đề gì<CLT>."

#. にょほほほッ！　さっすが十神財閥の御曹司様ッ！！
msgctxt "0041 | MONOKUMA"
msgid ""
"Nyohohoho! I would expect nothing less from the\n"
"prodigal son of the noble Togami family!"
msgstr ""
"Nyohohoho! Đúng là không hổ danh người kế thừa của gia tộc\n"
"Togami cao quý!"

#. 気付いちゃいましたね、この校則の<CLT 3>“抜け道”<CLT>に！！
msgctxt "0042 | MONOKUMA"
msgid ""
"So you managed to sniff out the <CLT 3>loophole<CLT> in the\n"
"regulations!"
msgstr ""
"Vậy là em đã đánh hơi được <CLT 3>lỗ hổng<CLT> trong\n"
"nội quy rồi đấy!"

#. お前の事だ、あえて抜け道を用意したんだろう？
#. 謎解きが少しでも面白くなるようにと…
msgctxt "0043 | BYAKUYA TOGAMI"
msgid ""
"Knowing you, I would bet you created it on purpose,\n"
"didn't you? To add a little more excitement to things."
msgstr ""
"Biết tỏng ngươi mà, ta cá là ngươi đã cố tình tạo ra nó đúng\n"
"không? Để thêm chút kịch tính cho mọi chuyện chứ gì."

#. キャー！　この程度は朝飯前のお通し扱い！？
#. サッスガですねぇ！
msgctxt "0044 | MONOKUMA"
msgid ""
"Kyaaah! You're treating me like a puny little\n"
"appetizer instead of the main course that I am!"
msgstr ""
"Aaa! Em coi ta như món khai vị tầm thường thay vì món\n"
"chính thịnh soạn sao!"

#. さらに言えば、死人に口なしとあるように、
#. 死人とは人でなく物なのですよ、もはや…！
msgctxt "0045 | MONOKUMA"
msgid ""
"Now then, since the dead can't actually talk, they're\n"
"not people anymore—they're things!"
msgstr ""
"Giờ thì, vì người chết thì không thể lên tiếng, nên họ\n"
"không còn là người nữa—họ là đồ vật!"

#. …アンダスタン？
msgctxt "0046 | MONOKUMA"
msgid "Get it? Got it? Good."
msgstr "Hiểu chưa? Hiểu rồi chứ? Tốt."

#. ちょっと待ってよ、抜け道って言うけどさ…
msgctxt "0047 | MAKOTO NAEGI"
msgid ""
"Wait, hold on... You're saying that's a loophole,\n"
"but..."
msgstr "Khoan đã, đợi chút... Mi bảo đó là lỗ hổng, nhưng..."

#. 他人から借りるって事は…つまり誰かが貸すって事で…
#. そうなると…えーっと……
msgctxt "0048 | MAKOTO NAEGI"
msgid ""
"In order to borrow something from someone, then...that\n"
"means someone would have to loan it, so...uhh..."
msgstr ""
"Để mượn thứ gì đó từ ai đó, thì... có nghĩa là phải có\n"
"người cho mượn chứ, vậy nên... ừm..."

#. 眠い…
msgctxt "0049 | MONOKUMA"
msgid "So sleepy..."
msgstr "Buồn ngủ quá..."

#. 眠たいヤツだよ、キミは！
#. 十神クンを見習って、もっとシャキッとしなさいッ！！
msgctxt "0050 | MONOKUMA"
msgid ""
"Just listening to you makes me wanna pass out! Be more\n"
"like Byakuya and get your poop together!"
msgstr ""
"Chỉ nghe cậu nói thôi cũng làm ta muốn ngất xỉu luôn rồi! Hãy \n"
"học tập Byakuya và làm cho mọi chuyện ra ngô ra khoai đi chứ!"

#. そんなキミは、放置プレイの刑に処す！
msgctxt "0051 | MONOKUMA"
msgid "Or else I'll charge you with criminal negligence!"
msgstr "Nếu không ta sẽ phạt cậu vì tội lơ là đấy!"

#. もう質問は受け付けないよ！　
#. 自分で考えなさいッ！！
msgctxt "0052 | MONOKUMA"
msgid ""
"No more questions! Figure out the rest your own damn\n"
"self!"
msgstr "Không câu hỏi gì nữa hết! Tự mình mà động não đi!"

#. ………………
msgctxt "0053 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. …仕方がない。出来の悪い相棒の為に、
#. モノクマに代わって俺が教えてやろう。
msgctxt "0054 | BYAKUYA TOGAMI"
msgid ""
"Well, I know you are unfortunately lacking in mental\n"
"faculties, so I'll fill you in myself."
msgstr ""
"Chà, tôi biết là cậu vốn dĩ thiếu thốn năng lực trí tuệ\n"
"rồi, nên tôi sẽ tự mình giải thích cho cậu vậy."

#. 行くぞ、<CLT 3>玄関ホール<CLT>だ。
msgctxt "0055 | BYAKUYA TOGAMI"
msgid "Let's head to the <CLT 3>main hall<CLT>."
msgstr "Đi thôi, đến <CLT 3>sảnh chính<CLT> nào."

#. …玄関ホール？
msgctxt "0056 | MAKOTO NAEGI"
msgid "The main hall...?"
msgstr "Sảnh chính sao...?"

#. そこに行けばわかる。
msgctxt "0057 | BYAKUYA TOGAMI"
msgid "That'll help you understand what's going on."
msgstr "Đến đó rồi cậu sẽ hiểu chuyện gì đang diễn ra."

#. <CLT 23><CLT><CLT 3>カードリーダー<CLT><CLT 23>を手帳に記録しました。
#. 言弾（コトダマ）メニューで確認できます。
#. <CLT>
msgctxt "0058 | NARRATION"
msgid ""
"<CLT 23>\"<CLT><CLT 3>Card Reader<CLT><CLT 23>\" has been added to the Truth Bullets\n"
"section of your handbook.\n"
"<CLT>"
msgstr ""
"<CLT 23>\"<CLT><CLT 3>Máy Đọc Thẻ<CLT><CLT 23>\" đã được thêm vào mục Đạn Sự Thật trong sổ\n"
"học sinh của bạn.\n"
"<CLT>"

#. 確か、この<CLT 3>カードリーダー<CLT>って、
#. 電子生徒手帳に対応しているんだよね？
msgctxt "0059 | MAKOTO NAEGI"
msgid ""
"If I remember right, this <CLT 3>card reader<CLT> is meant to\n"
"work with our handbooks, right?"
msgstr ""
"Nếu tớ nhớ không lầm, cái <CLT 3>máy đọc thẻ<CLT> này để sử\n"
"dụng cùng với sổ học sinh của chúng mình, phải không?"

#. 何か気になる事でもあるのか？
#. なら、モノクマに直接聞いてみるがいい。
msgctxt "0060 | BYAKUYA TOGAMI"
msgid ""
"Do you have an issue with it? If so, you should take\n"
"it up with Monokuma."
msgstr ""
"Cậu có vấn đề gì với nó sao? Nếu vậy, cậu nên đi mà hỏi\n"
"trực tiếp Monokuma ấy."

#. <CLT 4>と言い終わるや否や、
#. 十神クンはパンパンと手を鳴らし…
#. <CLT>
msgctxt "0061 | MAKOTO NAEGI"
msgid ""
"<CLT 4>He said that, then quickly and sharply clapped his\n"
"hands together.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu ta nói đoạn rồi vỗ tay thật mạnh và dứt khoát.\n"
"<CLT>"

#. お呼びですかッ！！
msgctxt "0062 | MONOKUMA"
msgid "You called for me!?"
msgstr "Gọi ta đấy à!?"

#. <CLT 4>飼い慣らされてる…？
#. <CLT>
msgctxt "0063 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Has he been domesticated...?\n"
"<CLT>"
msgstr ""
"<CLT 4>Cậu ta thuần hóa được nó rồi sao...?\n"
"<CLT>"

#. 苗木から、お前に質問があるらしいぞ…
msgctxt "0064 | BYAKUYA TOGAMI"
msgid "It seems that Makoto has a question for you."
msgstr "Có vẻ như Makoto có một câu hỏi dành cho ngươi đấy."

#. はい、なぁにー？
msgctxt "0065 | MONOKUMA"
msgid "Sure, what's up?"
msgstr "Được thôi, chuyện gì thế?"

#. えっと…ここのカードリーダーについて
#. 聞きたいんだ…
msgctxt "0066 | MAKOTO NAEGI"
msgid "Umm...well, it's just about this card reader."
msgstr "Ừm... chà, chỉ là về cái máy đọc thẻ này thôi."

#. そのカードリーダーは、オマエラにお配りしている
#. 電子生徒手帳に対応しています！
msgctxt "0067 | MONOKUMA"
msgid ""
"Yes, the card readers have all been designed to\n"
"interface with each of your e-Handbooks!"
msgstr ""
"Phải, tất cả các máy đọc thẻ đều được thiết kế để kết\n"
"nối với sổ học sinh điện tử của các em!"

#. <CLT 3>電子生徒手帳の性別<CLT>に対応した更衣室にしか
#. 入れないから、注意してね！
msgctxt "0068 | MONOKUMA"
msgid ""
"You can only enter the locker room corresponding to\n"
"the <CLT 3>gender listed in your individual handbook<CLT>."
msgstr ""
"Em chỉ có thể vào phòng thay đồ tương ứng với <CLT 3>giới tính\n"
"được ghi trong sổ học sinh cá nhân<CLT> thôi nhé!"

#. ロック解除している隙に、
#. <CLT 3>２人同時で入るのも不可能<CLT>なんだったな？
msgctxt "0069 | BYAKUYA TOGAMI"
msgid ""
"And it's <CLT 3>impossible for two people in a row to go\n"
"through<CLT> while the door is unlocked, correct?"
msgstr ""
"Và việc <CLT 3>hai người cùng lúc đi qua<CLT> khi cửa đang mở là\n"
"điều không thể, đúng không?"

#. そんなエロティックテロリストがいたら…
msgctxt "0070 | MONOKUMA"
msgid ""
"If there were some sort of erotic terrorist on the\n"
"prowl..."
msgstr "Nếu có tên khủng bố biến thái nào lảng vảng quanh đây..."

#. 天井のガトリングガンでハチの巣地獄ですわッ！！
msgctxt "0071 | MONOKUMA"
msgid ""
"The ceiling-mounted Gatling gun would initiate a Swiss\n"
"cheese slaughter!"
msgstr ""
"Khẩu súng Gatling gắn trên trần nhà sẽ biến hắn thành\n"
"cái tổ ong ngay lập tức!"

#. それと…電子生徒手帳を<CLT 3>他人に貸す<CLT>のも、
#. <CLT 3>校則で禁止<CLT>だったな…
msgctxt "0072 | BYAKUYA TOGAMI"
msgid ""
"And the <CLT 3>school regulations<CLT> prohibit anyone from\n"
"<CLT 3>lending someone else<CLT> their handbook, correct?"
msgstr ""
"Và <CLT 3>nội quy nhà trường<CLT> nghiêm cấm bất kỳ ai <CLT 3>cho người\n"
"khác mượn<CLT> sổ học sinh, đúng chứ?"

#. イエスザッツライト！
msgctxt "0073 | MONOKUMA"
msgid "Correctly correct!"
msgstr "Chuẩn không cần chỉnh!"

#. <CLT 4>だとすると…
#. <CLT>
msgctxt "0074 | MAKOTO NAEGI"
msgid ""
"<CLT 4>So then...\n"
"<CLT>"
msgstr ""
"<CLT 4>Vậy thì...\n"
"<CLT>"

#. <CLT 4>女子なら女子更衣室に…
#. 男子なら男子更衣室にしか入れないって事か…
#. <CLT>
msgctxt "0075 | MAKOTO NAEGI"
msgid ""
"<CLT 4>That means only girls can go in the girls locker room,\n"
"and only boys can go in the boys locker room.\n"
"<CLT>"
msgstr ""
"<CLT 4>Điều đó có nghĩa là chỉ có nữ mới được vào phòng thay đồ\n"
"nữ, và chỉ có nam mới được vào phòng thay đồ nam.\n"
"<CLT>"

#. <CLT 4>つまり、不二咲さんの死体が
#. 女子更衣室で見つかったって事は…
#. <CLT>
msgctxt "0076 | MAKOTO NAEGI"
msgid ""
"<CLT 4>In other words, Chihiro's body being found in the\n"
"girls locker room means...\n"
"<CLT>"
msgstr ""
"<CLT 4>Nói cách khác, việc thi thể Chihiro được tìm thấy ở\n"
"phòng thay đồ nữ có nghĩa là...\n"
"<CLT>"

#. おい苗木…透けて見えるぞ。
msgctxt "0077 | BYAKUYA TOGAMI"
msgid "Hey, Makoto. I can see right through you."
msgstr "Này Makoto. Tôi đi guốc trong bụng cậu luôn rồi."

#. 透けて…？
msgctxt "0078 | MAKOTO NAEGI"
msgid "See right...through me?"
msgstr "Đi guốc trong bụng... tớ sao?"

#. …お前はこう考えているんだろう？
msgctxt "0079 | BYAKUYA TOGAMI"
msgid "Allow me to tell you what you're thinking..."
msgstr "Để tôi nói cho cậu biết cậu đang nghĩ gì nhé..."

#. 不二咲千尋の死体が女子更衣室で見つかった以上、
#. 犯人は、女子更衣室に入ったはず…
msgctxt "0080 | BYAKUYA TOGAMI"
msgid ""
"Since Chihiro was found in the girls locker room, the\n"
"killer must have been able to get in there."
msgstr ""
"Vì Chihiro được tìm thấy trong phòng thay đồ nữ, kẻ sát\n"
"nhân chắc chắn phải vào được trong đó."

#. だから、犯人は女子の誰かなんじゃないかと…
msgctxt "0081 | BYAKUYA TOGAMI"
msgid ""
"As such, the killer must be one of the girls. Did I\n"
"get it right?"
msgstr ""
"Thế nên, kẻ sát nhân phải là một trong số các bạn nữ.\n"
"Tôi nói đúng chứ?"

#. まったく…甘いな…
msgctxt "0082 | BYAKUYA TOGAMI"
msgid "Good lord you're simple."
msgstr "Trời ạ, cậu thật đơn giản."

#. …違うの？
msgctxt "0083 | MAKOTO NAEGI"
msgid "But am I wrong?"
msgstr "Nhưng tớ nói sai sao?"

#. もう一度、よく校則を確認してみるんだな。
#. 追加されたルールには、こうあったはずだ。
msgctxt "0084 | BYAKUYA TOGAMI"
msgid ""
"You should pay closer attention to the regulations.\n"
"The answer has been in front of you the entire time."
msgstr ""
"Cậu nên chú ý kỹ hơn vào nội quy đi. Câu trả lời vốn đã\n"
"nằm ngay trước mắt cậu bấy lâu nay rồi."

#. 『電子生徒手帳の他人への貸与禁止』とな…
msgctxt "0085 | BYAKUYA TOGAMI"
msgid ""
"\"Loaning your e-Handbook to another student is\n"
"strictly prohibited.\""
msgstr ""
"\"Nghiêm cấm việc cho học sinh khác mượn sổ học sinh điện\n"
"tử của mình.\""

#. 禁止されてるのは、他人に貸す行為だけだ。
#. <CLT 3>借りる事は禁止されていない<CLT>。
msgctxt "0086 | BYAKUYA TOGAMI"
msgid ""
"Only the act of *loaning* a handbook is prohibited.\n"
"<CLT 3>Borrowing someone else's is perfectly fine<CLT>."
msgstr ""
"Chỉ có hành vi *cho mượn* sổ tay là bị cấm thôi. <CLT 3>Việc\n"
"mượn của người khác thì hoàn toàn không vấn đề gì<CLT>."

#. にょほほほッ！　さっすが十神財閥の御曹司様ッ！！
msgctxt "0087 | MONOKUMA"
msgid ""
"Nyohohoho! I would expect nothing less from the\n"
"prodigal son of the noble Togami family!"
msgstr ""
"U pư pư! Đúng là không hổ danh người kế thừa của gia tộc\n"
"Togami cao quý!"

#. 気付いちゃいましたね、この校則の<CLT 3>“抜け道”<CLT>に！！
msgctxt "0088 | MONOKUMA"
msgid ""
"So you managed to sniff out the <CLT 3>loophole<CLT> in the\n"
"regulations!"
msgstr ""
"Vậy là em đã đánh hơi được <CLT 3>lỗ hổng<CLT> trong nội \n"
"quy rồi đấy!"

#. お前の事だ、あえて抜け道を用意したんだろう？
#. 謎解きが少しでも面白くなるようにと…
msgctxt "0089 | BYAKUYA TOGAMI"
msgid ""
"Knowing you, I would bet you created it on purpose,\n"
"didn't you? To add a little more excitement to things."
msgstr ""
"Biết tỏng ngươi mà, ta cá là ngươi đã cố tình tạo ra nó đúng\n"
"không? Để thêm chút kịch tính cho mọi chuyện chứ gì."

#. キャー！　この程度は朝飯前のお通し扱い！？
#. サッスガですねぇ！
msgctxt "0090 | MONOKUMA"
msgid ""
"Kyaaah! You're treating me like a puny little\n"
"appetizer instead of the main course that I am!"
msgstr ""
"Aaa! Em coi ta như món khai vị tầm thường thay vì món\n"
"chính thịnh soạn này sao!"

#. さらに言えば、死人に口なしとあるように、
#. 死人とは人でなく物なのですよ…もはや…！
msgctxt "0091 | MONOKUMA"
msgid ""
"Now then, since the dead can't actually talk, they're\n"
"not people anymore—they're things!"
msgstr ""
"Giờ thì, vì người chết thì không thể lên tiếng, nên họ\n"
"không còn là người nữa—họ là đồ vật!"

#. …アンダスタン？
msgctxt "0092 | MONOKUMA"
msgid "Get it? Got it? Good."
msgstr "Hiểu chưa? Hiểu rồi chứ? Tốt."

#. ちょっと待ってよ、抜け道って言うけどさ…
msgctxt "0093 | MAKOTO NAEGI"
msgid ""
"Wait, hold on... You're saying that's a loophole,\n"
"but..."
msgstr "Khoan đã, đợi chút... Cậu bảo đó là lỗ hổng, nhưng..."

#. 他人から借りるって事は…つまり誰かが貸すって事で…
#. そうなると…えーっと……
msgctxt "0094 | MAKOTO NAEGI"
msgid ""
"In order to borrow something from someone, then...that\n"
"means someone would have to loan it, so...uhh..."
msgstr ""
"Để mượn thứ gì đó từ ai đó, thì... có nghĩa là phải có\n"
"người cho mượn chứ, vậy nên... ừm..."

#. 眠い…！
msgctxt "0095 | MONOKUMA"
msgid "So sleepy..."
msgstr "Buồn ngủ quá..."

#. 眠たいヤツだよ、キミは！！
#. 十神クンを見習って、もっとシャキッとしなさいッ！！
msgctxt "0096 | MONOKUMA"
msgid ""
"Just listening to you makes me wanna pass out! Be more\n"
"like Byakuya and get your poop together!"
msgstr ""
"Chỉ nghe cậu nói thôi cũng làm ta muốn ngất xỉu luôn rồi! Hãy \n"
"học tập Byakuya và làm cho mọi chuyện ra ngô ra khoai đi chứ!"

#. そんなオマエは放置プレイの刑に処す！
msgctxt "0097 | MONOKUMA"
msgid "Or else I'll charge you with criminal negligence!"
msgstr "Nếu không ta sẽ phạt em vì tội lơ là đấy!"

#. もう質問は受け付けないよ！
#. 自分で考えなさいッ！！
msgctxt "0098 | MONOKUMA"
msgid ""
"No more questions! Figure out the rest your own damn\n"
"self!"
msgstr "Không câu hỏi gì nữa hết! Tự mình mà động não đi!"

#. ………………
msgctxt "0099 | MAKOTO NAEGI"
msgid "..."
msgstr "..."

#. …仕方がない。出来の悪い相棒の為に、
#. モノクマに代わって俺が教えてやろう。
msgctxt "0100 | BYAKUYA TOGAMI"
msgid ""
"Well, I know you are unfortunately lacking in mental\n"
"faculties, so I'll fill you in myself."
msgstr ""
"Chà, tôi biết là cậu vốn dĩ thiếu thốn năng lực trí tuệ\n"
"rồi, nên tôi sẽ tự mình giải thích cho cậu vậy."

#. 行くぞ、<CLT 3>玄関ホール<CLT>だ。
msgctxt "0101 | BYAKUYA TOGAMI"
msgid "Let's head to the <CLT 3>main hall<CLT>."
msgstr "Đi thôi, đến <CLT 3>sảnh chính<CLT> nào."

#. …玄関ホール？
msgctxt "0102 | MAKOTO NAEGI"
msgid "The main hall...?"
msgstr "Sảnh chính sao...?"

#. そこに行けばわかる。
msgctxt "0103 | BYAKUYA TOGAMI"
msgid "That'll help you understand what's going on."
msgstr "Đến đó rồi cậu sẽ hiểu chuyện gì đang diễn ra."

#. <CLT 23><CLT><CLT 3>カードリーダー<CLT><CLT 23>を手帳に記録しました。
#. 言弾（コトダマ）メニューで確認できます。
#. <CLT>
msgctxt "0104 | NARRATION"
msgid ""
"<CLT 23>\"<CLT><CLT 3>Card Reader<CLT><CLT 23>\" has been added to the Truth Bullets\n"
"section of your handbook.\n"
"<CLT>"
msgstr ""
"<CLT 23>\"<CLT><CLT 3>Máy Đọc Thẻ<CLT><CLT 23>\" đã được thêm vào mục Đạn Sự Thật trong sổ\n"
"học sinh của bạn.\n"
"<CLT>"

#. <CLT 4>不二咲さんはこの銃で…
#. …な訳ないよな。これが凶器ならハチの巣だ。
#. <CLT>
msgctxt "0105 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Maybe this gun was used to... No, impossible. If that\n"
"were true, Chihiro would be riddled with holes.\n"
"<CLT>"
msgstr ""
"<CLT 4>Có lẽ khẩu súng này đã được dùng để... Không, không thể\n"
"nào. Nếu đó là thật thì người Chihiro đã đầy lỗ đạn rồi.\n"
"<CLT>"

#. <CLT 4>この棚には…水泳用の色々な用具が並んでいる…
#. 不二咲さんの事件とは関係なさそうだ…
#. <CLT>
msgctxt "0106 | MAKOTO NAEGI"
msgid ""
"<CLT 4>There are a bunch of different pool-related items on\n"
"the shelf. Which have nothing to do with the case...\n"
"<CLT>"
msgstr ""
"<CLT 4>Trên kệ có rất nhiều dụng cụ bơi lội khác nhau. Chẳng có\n"
"cái nào liên quan đến vụ án này cả...\n"
"<CLT>"

#. <CLT 4>浮き輪がある…
#. 不二咲さんの事件とは明らかに関係なさそうだ…
#. <CLT>
msgctxt "0107 | MAKOTO NAEGI"
msgid ""
"<CLT 4>A flotation donut... I don't think it's related to\n"
"what happened to Chihiro.\n"
"<CLT>"
msgstr ""
"<CLT 4>Một cái phao bơi... Mình không nghĩ nó liên quan đến\n"
"những gì đã xảy ra với Chihiro đâu.\n"
"<CLT>"

#. 待て…まだ調べるべき事があるだろう。
msgctxt "0108 | BYAKUYA TOGAMI"
msgid "Hold on. We still have more to check here."
msgstr "Khoan đã. Chúng ta vẫn còn nhiều thứ cần kiểm tra ở đây."


────────────────────────────────────────────────────────────────────────
  CHAPTER  e02_029_101 Toko Room Emergency
────────────────────────────────────────────────────────────────────────

  [ERROR]  e02_029_101
    ✗ msgid ""
msgstr ""
