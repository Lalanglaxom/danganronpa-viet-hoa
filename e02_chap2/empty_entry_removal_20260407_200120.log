#. <CLT 4>結構、広い湯船だ…
#. <CLT>
msgctxt "0001 | MAKOTO NAEGI"
msgid "<CLT 4>This bathtub is huge...\n<CLT>"
msgstr ""
msgid ""
"<CLT 4>This bathtub is huge...\n"
"<CLT>"
msgstr ""
"<CLT 4>Bồn tắm này rộng thật...\n"
"<CLT>"

#. はい
msgctxt "0002 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0003 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>大浴場から出ますか？
#. <CLT>
msgctxt "0004 | NARRATION"
msgid ""
"<CLT 23>Leave the bathhouse?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi nhà tắm?\n"
"<CLT>"


