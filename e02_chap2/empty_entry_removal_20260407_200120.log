msgid ""
"<CLT 4>Now's not the time for this...\n"
"<CLT>"
msgstr ""
"<CLT 4>Giờ không phải lúc cho chuyện này...\n"
"<CLT>"

#. <CLT 4>階段には、シャッターが降りてる。
#. <CLT>
msgctxt "0104 | MAKOTO NAEGI"
msgid ""
"<CLT 4>The gate is blocking access to the stairs.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cửa sập đang chặn lối lên cầu thang.\n"
"<CLT>"

#. <CLT 4>こっちは行けるようにはならないのか…
#. <CLT>
msgctxt "0105 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I wonder if this'll open up at some point...\n"
"<CLT>"
msgstr ""
"<CLT 4>Không biết đến khi nào thì chỗ này mới mở nhỉ...\n"
"<CLT>"

#. <CLT 4>鉄格子だ…
#. かなり頑丈そうだな。
#. <CLT>
msgctxt "0106 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This gate seems remarkably sturdy.\n"
"<CLT>"
msgstr ""
"<CLT 4>Cái cổng này trông kiên cố thật đấy.\n"
"<CLT>"

#. <CLT 4>なんだって、こんなに厳重に
#. 封鎖してるんだろう…
#. <CLT>
msgctxt "0107 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Why would someone go to all the trouble of blocking\n"
"off this entire area?\n"
"<CLT>"
msgstr ""
"<CLT 4>Tại sao lại có kẻ phải cất công phong tỏa toàn bộ khu\n"
"vực này chứ?\n"
"<CLT>"


