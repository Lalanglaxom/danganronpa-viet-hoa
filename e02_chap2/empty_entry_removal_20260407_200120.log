#. だが、そこにはやっぱり…
#. <CLT>
msgctxt "0009 | MAKOTO NAEGI"
msgid ""
"<CLT 4>In any normal classroom, this is where a window would\n"
"be. But...\n"
"<CLT>"
msgstr ""
"<CLT 4>Ở bất kỳ lớp học bình thường nào, đây là nơi đáng lẽ\n"
