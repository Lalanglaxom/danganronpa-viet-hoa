────────────────────────────────────────────────────────────────────────
  CHAPTER  e02_198_000 Wrong Verdict Ending
────────────────────────────────────────────────────────────────────────

  [ERROR]  e02_198_000
    ✗ msgid ""
msgstr ""
"Project-Id-Version: DR1 (PC)\n"
"Report-Msgid-Bugs-To: your_email\n"
"POT-Creation-Date: 3/26/2026\n"
"PO-Revision-Date: \n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: en_US\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Generator: Poedit 3.8\n"

#. <CLT 4>みんな…ボクを疑っている…
#. もう誰も、ボクの言葉を聞き入れてくれない！
#. <CLT>
msgctxt "0001 | MAKOTO NAEGI"
msgid "<CLT 4>Nobody believes me... Nobody wants to hear what I have\nto say!\n<CLT>"
msgstr ""
msgid ""
"<CLT 4>Nobody believes me... Nobody wants to hear what I have\n"
"to say!\n"
"<CLT>"
msgstr ""
"<CLT 4>Không một ai tin mình... Không một ai muốn nghe những gì\n"
"mình định nói cả!\n"
"<CLT>"

#. おやおや…もう議論は打ち止めかな？
msgctxt "0002 | MONOKUMA"
msgid "Uh-oh! Have we already come to the end of the debate?"
msgstr "Ối chà! Có vẻ như cuộc tranh luận đã đi đến hồi kết rồi nhỉ?"

#. これにて学級裁判は閉廷！
#. サクッとクロを決めちゃうからね！
msgctxt "0003 | MONOKUMA"
msgid ""
"Well then, the class trial is officially adjourned!\n"
"Now it's time to reveal who's the blackened!"
msgstr ""
"Vậy thì, lớp xét xử chính thức bế mạc! Giờ là lúc để\n"
"tiết lộ xem kẻ thủ ác là ai nào!"

#. うぷぷぷぷぷ…！
msgctxt "0004 | MONOKUMA"
msgid "Puuhuhuhuhu!"
msgstr "U pư pư pư pư!"

#. 一番投票された人は、苗木誠くん…
#. みたいだね。
msgctxt "0005 | MONOKUMA"
msgid ""
"It would appear that the one with the most votes\n"
"is...Makoto!"
msgstr ""
"Có vẻ như người nhận được nhiều phiếu bầu nhất chính\n"
"là... Makoto!"

#. しかし、残念～！
#. 苗木くんはクロじゃないよ！
msgctxt "0006 | MONOKUMA"
msgid "However...Makoto is NOT the blackened! Too bad!"
msgstr "Thế nhưng... Makoto KHÔNG PHẢI kẻ thủ ác đâu! Tiếc quá đi!"

#. 本物のクロは見事卒業！　おめでとう！
#. でも…
msgctxt "0007 | MONOKUMA"
msgid ""
"Looks like the real killer gets to graduate!\n"
"Congraduations to them!"
msgstr ""
"Có vẻ như kẻ sát nhân thực sự sẽ được tốt nghiệp! Chúc\n"
"mừng tốt nghiệp cho họ nhé!"

#. クロ以外は、みんなおしおきだよ！
msgctxt "0008 | MONOKUMA"
msgid "On the other hand, everyone else must now be punished!"
msgstr "Mặt khác, tất cả những người còn lại giờ sẽ phải chịu hình phạt!"

#. <CLT 4>ボク達は…ここで終わってしまうのか…？
#. <CLT>
msgctxt "0009 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Is this really it for us? Is it all over?\n"
"<CLT>"
msgstr ""
"<CLT 4>Mọi chuyện thực sự kết thúc ở đây sao? Tất cả đã chấm hết rồi ư?\n"
"<CLT>"

#. はい
msgctxt "0010 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. ここで諦めたりしないぞッ！
msgctxt "0011 | MAKOTO NAEGI"
msgid "I can't give up now!"
msgstr "Mình không thể bỏ cuộc lúc này được!"

#. いいえ
msgctxt "0012 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23><CLT><CLT 3>リトライ<CLT><CLT 23>なさいますか？
#. <CLT>
msgctxt "0013 | NARRATION"
msgid ""
"<CLT 23>Whaddya say? Wanna <CLT><CLT 3>give it another shot<CLT><CLT 23>?\n"
"<CLT>"
msgstr ""
"<CLT 23>Bạn nói sao nào? Có muốn <CLT><CLT 3>thử lại lần nữa<CLT><CLT 23> không?\n"
"<CLT>"


