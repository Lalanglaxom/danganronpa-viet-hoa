msgid "<CLT 4>This bathtub is huge...\n<CLT>"
msgstr ""
msgid ""
"<CLT 4>This bathtub is huge...\n"
"<CLT>"
msgstr ""
"<CLT 4>Cái bồn tắm này khổng lồ thật...\n"
"<CLT>"

#. <CLT 4>でも…お風呂に入ってる場合じゃない…
#. <CLT>
msgctxt "0002 | MAKOTO NAEGI"
msgid ""
"<CLT 4>But now's no time for taking baths.\n"
"<CLT>"
msgstr ""
"<CLT 4>Nhưng giờ không phải lúc để đi tắm.\n"
"<CLT>"

#. はい
msgctxt "0003 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
