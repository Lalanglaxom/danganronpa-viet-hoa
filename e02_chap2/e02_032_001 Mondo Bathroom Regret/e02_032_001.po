#. ……………
msgctxt "0003 | MAKOTO NAEGI"
msgid "..."
msgstr ""

#. くうっ！
#. すまん、不二咲くん…僕の力不足だッ！！
msgctxt "0002 | KIYOTAKA ISHIMARU"
msgid "Dammit! I'm sorry, Chihiro... It's all because I\nwasn't strong enough!"
msgstr ""

#. やはり、恥ずかしい秘密とやらを
#. 告白し合っておくべきだったのか…！
msgctxt "0001 | KIYOTAKA ISHIMARU"
msgid "Maybe we should have confessed our embarrassing\nsecrets after all...!"
msgstr ""

msgctxt "0004 | MAKOTO NAEGI"
msgid ""
"<CLT 4>I really don't wanna go in... I don't wanna see this\n"
"place ever again...!\n"
"<CLT>"
msgstr ""
"<CLT 4>Mình thực sự không muốn vào đó... Mình không muốn nhìn thấy\n"
"nơi này thêm một lần nào nữa đâu!\n"
"<CLT>"

msgctxt "0005 | MAKOTO NAEGI"
msgid ""
"<CLT 23>*Rattle rattle*\n"
"<CLT>"
msgstr ""
"<CLT 23>*Lạch cạch lạch cạch*\n"
"<CLT>"

msgctxt "0006 | MAKOTO NAEGI"
msgid "The door won't budge. It must be locked."
msgstr "Cánh cửa không hề nhúc nhích. Chắc là nó bị khóa rồi."

msgctxt "0007 | MAKOTO NAEGI"
msgid ""
"<CLT 4>This is the girls bathroom.\n"
"<CLT>"
msgstr ""
"<CLT 4>Đây là nhà vệ sinh nữ.\n"
"<CLT>"

msgctxt "0008 | MAKOTO NAEGI"
msgid ""
"<CLT 4>Obviously I can't go in...\n"
"<CLT>"
msgstr ""
"<CLT 4>Tất nhiên là mình không thể vào trong đó rồi...\n"
"<CLT>"
