#. <CLT 4>水槽だ…
#. 小さな魚が泳いでいる…
#. <CLT>
msgctxt "0001 | MAKOTO NAEGI"
msgid ""
"<CLT 4>It's a fish tank. There's a bunch of little fish\n"
"swimming around inside...\n"
"<CLT>"
msgstr ""
"<CLT 4>Đó là một bể cá. Có một đàn cá nhỏ đang bơi lội ở\n"
"bên trong...\n"
"<CLT>"

#. はい
msgctxt "0002 | CHOICE/RE:ACT"
msgid "Yes"
msgstr "Có"

#. いいえ
msgctxt "0003 | CHOICE/RE:ACT"
msgid "No"
msgstr "Không"

#. <CLT 23>外に出ますか？
#. <CLT>
msgctxt "0004 | NARRATION"
msgid ""
"<CLT 23>Leave the area?\n"
"<CLT>"
msgstr ""
"<CLT 23>Rời khỏi đây?\n"
"<CLT>"
